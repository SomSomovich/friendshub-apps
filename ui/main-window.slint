    in property <bool> about-updater-supported: false;
    in property <bool> about-update-busy: false;
    in property <string> about-update-status: "";
    in property <bool> about-busy: false;

    callback navigate-requested(string);
    callback login-requested(string, string);
    callback register-requested(string);
    callback twofactor-submit-requested(string, bool);
    callback ui-action(string, string, string, string, string);
    callback dating-profile-save-requested(DatingProfileDraft);
    callback dating-search-requested(DatingSearchFilters);
    callback twofactor-copy-backup-codes-requested([string]);
    callback create-group-requested(string, string, string, bool, [GroupMemberRow]);
    callback create-channel-requested(string, string, string, bool, string, string, string, string);

    if root.screen == "landing" : LandingScreen {
        authenticated: root.authenticated;
        login-requested => { root.navigate-requested("/login"); }
        register-requested => { root.navigate-requested("/register"); }
        open-app-requested => { root.navigate-requested("/app"); }
        theme-toggle-requested => { root.ui-action("landing", "theme-toggle", "", "", ""); }
        language-toggle-requested => { root.ui-action("landing", "language-toggle", "", "", ""); }
        repository-requested => { root.ui-action("about", "open-url", root.about-repository-url, Platform.open-url(root.about-repository-url) ? "true" : "false", ""); }
    }

    if root.screen == "login" : LoginScreen {
        fh-number <=> root.login-fh-number;
        password <=> root.login-password;
        error-text: root.login-error;
        busy: root.login-busy;
        login-requested(number, password) => { root.login-requested(number, password); }
        register-requested => { root.navigate-requested("/register"); }
        back-requested => { root.navigate-requested("/"); }
    }

    if root.screen == "register" : RegisterScreen {
        password <=> root.register-password;
        error-text: root.register-error;
        busy: root.register-busy;
        register-requested(password) => { root.register-requested(password); }
        login-requested => { root.navigate-requested("/login"); }
        back-requested => { root.navigate-requested("/"); }
    }

    if root.screen == "two_factor" : TwoFactorScreen {
        code <=> root.twofactor-code;
        backup-mode <=> root.twofactor-backup-mode;
        device-setup: root.twofactor-device-setup;
        error-text: root.twofactor-error;
        busy: root.auth-busy;
        submit-requested(code, backup-mode) => { root.twofactor-submit-requested(code, backup-mode); }
        mode-changed(backup-mode) => { root.twofactor-backup-mode = backup-mode; }
        code-changed(code) => { root.twofactor-code = code; }
        cancel-requested => { root.navigate-requested("/login"); }
    }

    if root.screen == "connect" : ConnectScreen {
        username: root.connect-username;
        keys-state: root.connect-keys-state;
        socket-state: root.connect-socket-state;
        error-text: root.connect-error;
        busy: root.connect-busy;
        retry-requested => { root.ui-action("connect", "retry", "", "", ""); }
        continue-offline-requested => { root.ui-action("connect", "continue-offline", "", "", ""); }
    }

    if root.screen == "invite" : InviteScreen {
        invite-token: root.invite-token;
        failed: root.invite-failed;
        sync-failed: root.invite-sync-failed;
        busy: root.connect-busy;
        join-requested(token) => { root.ui-action("invite", "join", token, "", ""); }
        retry-requested => { root.ui-action("invite", "retry", root.invite-token, "", ""); }
        chats-requested => { root.navigate-requested("/app"); }
    }

    if root.screen == "not_found" && !root.authenticated : NotFoundScreen {
        home-requested => { root.navigate-requested("/"); }
    }

    if root.authenticated && root.screen != "landing" && root.screen != "login" && root.screen != "register" && root.screen != "two_factor" && root.screen != "connect" && root.screen != "invite" : AppShell {
        username: root.account-username;
        fh-number: root.account-fh-number;
        account-avatar: root.account-avatar;
        account-avatar-label: root.account-avatar-label;
        has-account-avatar: root.has-account-avatar;
        filters: root.conversation-filters;
        selected-filter: root.selected-filter;
        folders: root.folders;
        selected-folder: root.selected-folder;
        conversations: root.conversations;
        selected-conversation-id: root.selected-conversation-id;
        search-query: root.conversation-search;
        has-archived: root.has-archived;
        loading-conversations: root.conversations-loading;
        conversation-error: root.conversations-error;
        empty-title: root.conversations-empty-title;
        empty-description: root.conversations-empty-description;
        light-mode: root.light-mode;
        language: root.language;
        show-content: root.screen != "chat_index";
        offline: root.offline;

        navigation-requested(path) => { root.navigate-requested(path); }
        account-switch-requested => { root.ui-action("accounts", "open-switcher", "", "", ""); }
        temporary-room-requested => { root.ui-action("conversations", "create-temporary", "", "", ""); }
        profile-requested => { root.navigate-requested("/app/profile"); }
        search-changed(query) => { root.ui-action("conversations", "search", query, "", ""); }
        filter-changed(filter) => { root.ui-action("conversations", "filter", filter, "", ""); }
        folder-create-requested => { root.ui-action("conversations", "folder-create", "", "", ""); }
        folder-edit-requested(id) => { root.ui-action("conversations", "folder-edit", id, "", ""); }
        conversation-selected(id) => { root.ui-action("conversations", "select", id, "", ""); }
        conversation-profile-requested(id) => { root.ui-action("profile", "open-public", id, "", ""); }
        conversation-context-action(id, action) => { root.ui-action("conversations", "context-action", id, action, ""); }
        conversations-retry-requested => { root.ui-action("conversations", "reload", "", "", ""); }
        theme-selected(light) => { root.ui-action("appearance", "set-theme", light ? "true" : "false", "", ""); }
        language-selected(code) => { root.ui-action("appearance", "set-language", code, "", ""); }

        if root.screen == "chat_index" : Rectangle {
            background: Theme.background;
            VerticalLayout {
                alignment: center;
                Text { text: "Выберите чат"; color: Theme.foreground; font-size: 14px; horizontal-alignment: center; }
                Text { text: "История переписки будет показана здесь."; color: Theme.muted; font-size: 12px; horizontal-alignment: center; }
            }
        }

        if root.screen == "chat" : ChatScreen {
