            poll-create-duration-label: root.chat-poll-create-duration-label;
            poll-create-title-count-label: root.chat-poll-create-title-count-label;
            poll-create-description-count-label: root.chat-poll-create-description-count-label;
            poll-create-error-text: root.chat-poll-create-error-text;
            poll-create-options: root.chat-poll-create-options;
            poll-create-title <=> root.chat-poll-create-title;
            poll-create-description <=> root.chat-poll-create-description;
            poll-create-duration-hours <=> root.chat-poll-create-duration-hours;
            poll-create-duration-minutes <=> root.chat-poll-create-duration-minutes;
