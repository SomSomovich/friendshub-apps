            attachment-requested(kind) => { root.ui-action("attachments", "choose", kind, "", ""); }
            emoji-picker-requested => { root.ui-action("chat", "emoji-picker", "", "", ""); }
            poll-requested => { root.ui-action("polls", "create-dialog", "", "", ""); }
            poll-create-title-changed(value) => { root.ui-action("polls", "title-changed", value, "", ""); }
            poll-create-description-changed(value) => { root.ui-action("polls", "description-changed", value, "", ""); }
            poll-create-type-changed(value) => { root.ui-action("polls", "type-changed", value ? "true" : "false", "", ""); }
