            create-bot-requested => { root.ui-action("bots", "create", "", "", ""); }
            set-bot-handle-requested(id, handle) => { root.ui-action("bots", "set-handle", id, handle, ""); }
            rotate-bot-token-requested(id) => { root.ui-action("bots", "rotate-token", id, "", ""); }
            delete-bot-requested(id) => { root.ui-action("bots", "delete", id, "", ""); }
            copy-token-requested(token) => { root.ui-action("bots", "copy-token", token, "", ""); }
            close-token-requested => { root.ui-action("bots", "dismiss-token", "", "", ""); }
            retry-requested => { root.ui-action("bots", "retry", "", "", ""); }
        }
        if root.screen == "settings_about" : AboutSettingsScreen {
            app-version: root.about-app-version;
            repository-url: root.about-repository-url;
            native-releases-url: root.about-native-releases-url;
            core-repository-url: root.about-core-repository-url;
            updater-supported: root.about-updater-supported;
            update-busy: root.about-update-busy;
            update-status: root.about-update-status;
            busy: root.about-busy;
            back-requested => { root.navigate-requested("/app/settings"); }
            open-url-requested(url) => {
                if url == root.about-repository-url || url == root.about-native-releases-url || url == root.about-core-repository-url {
                    root.ui-action("about", "open-url", url, Platform.open-url(url) ? "true" : "false", "");
                } else {
                    root.ui-action("about", "open-url", url, "false", "");
                }
            }
            copy-text-requested(text) => { root.ui-action("about", "copy-text", text, "", ""); }
            check-updates-requested => { root.ui-action("about", "check-updates", "", "", ""); }
            logout-requested => { root.ui-action("auth", "logout", "", "", ""); }
        }
        if root.screen == "not_found" : NotFoundScreen {
            home-requested => { root.navigate-requested("/app"); }
        }
    }

    if root.call-overlay-visible : CallOverlay {
        visible: root.call-overlay-visible;
        call-state: root.call-state;
        peer-name: root.call-peer-name;
        peer-initial: root.call-peer-initial;
        with-video: root.call-with-video;
        status-text: root.call-status;
        error-text: root.call-error;
        has-remote-video: root.call-has-remote-video;
        remote-video-frame: root.call-remote-video-frame;
        has-local-video: root.call-has-local-video;
        local-video-frame: root.call-local-video-frame;
        speaker-on: root.call-speaker-on;
        camera-off: root.call-camera-off;
        accept-requested => { root.ui-action("calls", "accept", "", "", ""); }
        decline-requested => { root.ui-action("calls", "decline", "", "", ""); }
        hang-up-requested => { root.ui-action("calls", "hang-up", "", "", ""); }
        speaker-toggle-requested => { root.ui-action("calls", "toggle-speaker", "", "", ""); }
        camera-toggle-requested => { root.ui-action("calls", "toggle-camera", "", "", ""); }
        switch-camera-requested => { root.ui-action("calls", "switch-camera", "", "", ""); }
    }

    DurationPickerDialog {
        open: root.temporary-room-dialog-open;
        duration-valid: root.temporary-room-duration-valid;
        title: root.language == "ru" ? "Создать временную комнату" : "Create temporary room";
        hint: root.language == "ru"
            ? "Выберите, через сколько часов и минут группа закроется. Срок — от минуты до 7 дней."
            : "Choose how many hours and minutes until the group closes. The duration must be from one minute to seven days.";
        hours-label: root.language == "ru" ? "Часы" : "Hours";
        minutes-label: root.language == "ru" ? "Минуты" : "Minutes";
        hours: root.temporary-room-hours;
        minutes: root.temporary-room-minutes;
        range-error: root.language == "ru"
            ? "Срок должен быть от минуты до 7 дней."
            : "Duration must be from one minute to seven days.";
        cancel-label: root.language == "ru" ? "Отмена" : "Cancel";
        continue-label: root.language == "ru" ? "Продолжить" : "Continue";
        hours-changed(value) => { root.ui-action("conversations", "temporary-hours-changed", value, "", ""); }
        minutes-changed(value) => { root.ui-action("conversations", "temporary-minutes-changed", value, "", ""); }
        continue-requested => { root.ui-action("conversations", "temporary-duration-confirmed", root.temporary-room-hours, root.temporary-room-minutes, ""); }
        close-requested => { root.ui-action("conversations", "temporary-duration-cancelled", "", "", ""); }
    }

    DurationPickerDialog {
        open: root.settings-account-status-duration-open;
        duration-valid: root.settings-account-status-duration-valid;
        title: root.language == "ru" ? "Срок статуса" : "Status duration";
        hint: root.language == "ru"
            ? "Выберите срок от минуты до 7 дней."
            : "Choose a duration from one minute to seven days.";
        hours-label: root.language == "ru" ? "Часы" : "Hours";
        minutes-label: root.language == "ru" ? "Минуты" : "Minutes";
        hours: root.settings-account-status-duration-hours;
        minutes: root.settings-account-status-duration-minutes;
        range-error: root.language == "ru"
            ? "Срок должен быть от минуты до 7 дней."
            : "Duration must be from one minute to seven days.";
        cancel-label: root.language == "ru" ? "Отмена" : "Cancel";
        continue-label: root.language == "ru" ? "Сохранить срок" : "Save duration";
        hours-changed(value) => { root.ui-action("account-settings", "status-hours-changed", value, "", ""); }
        minutes-changed(value) => { root.ui-action("account-settings", "status-minutes-changed", value, "", ""); }
        continue-requested => { root.ui-action("account-settings", "status-duration-selected", root.settings-account-status-duration-hours, root.settings-account-status-duration-minutes, ""); }
        close-requested => { root.ui-action("account-settings", "status-duration-cancelled", "", "", ""); }
    }
}
