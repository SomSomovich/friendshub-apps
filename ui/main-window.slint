            delete-confirm-error-text: root.chat-delete-confirm-error-text;
            back-requested => { root.navigate-requested("/app"); }
            profile-requested => { root.ui-action("profile", "open-conversation", root.selected-conversation-id, "", ""); }
            search-toggled => { root.ui-action("chat", "search-toggle", "", "", ""); }
