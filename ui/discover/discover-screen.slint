import { Theme } from "../theme.slint";
import { FHEmptyState, FHInput, FHSecondaryButton, FHScreenHeader, FHSkeleton, FHTextButton } from "../components.slint";
import { IconCompass } from "../icons.slint";
import { ScrollView } from "std-widgets.slint";

export struct DiscoverEntry {
    conversation-id: string,
    title: string,
    description: string,
    count-label: string,
    initials: string,
    has-avatar: bool,
    avatar-image: image,
}

component DiscoverKindRow inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback picked();

    width: 100%;
    height: 36px;
    background: row-area.has-hover ? Theme.hover : transparent;
    border-radius: 8px;
    accessible-role: radio-button;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-action-default => { root.picked(); }
    forward-focus: keyboard-scope;

    states [
        focus when keyboard-scope.has-focus : {
            root.border-width: 2px;
            root.border-color: Theme.accent;
        }
    ]

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 10px;
        alignment: start;
        cross-axis-alignment: center;

        Rectangle {
            width: 18px;
            height: 18px;
            border-radius: 9px;
            border-width: 1px;
            border-color: root.selected ? Theme.accent : Theme.border;
            background: root.selected ? Theme.accent : transparent;

            if root.selected : Rectangle {
                x: 5px;
                y: 5px;
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Theme.accent-foreground;
            }
        }

        Text {
            text: root.label;
            color: Theme.foreground;
            font-size: 14px;
            vertical-alignment: center;
            horizontal-stretch: 1;
            accessible-role: none;
        }
    }

    row-area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }

    keyboard-scope := FocusScope {
        x: 0;
        width: 0;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.picked();
                return accept;
            }
            return reject;
        }
    }
}

export component DiscoverScreen inherits Rectangle {
    in property <bool> channel-mode: false;
    in-out property <string> handle-query;
    in property <[DiscoverEntry]> entries;
    in property <bool> busy: false;
    in property <bool> loading: false;
    in property <bool> has-error: false;
    in property <string> error-text;
    in property <bool> lookup-mode: false;

    callback back-requested();
    callback channel-mode-changed(bool);
    callback lookup-requested(string);
    callback show-catalog-requested();
    callback open-requested(string);

    background: Theme.background;

    VerticalLayout {
        spacing: 0px;

        FHScreenHeader {
            title: "Публичные чаты";
            back-requested => { root.back-requested(); }
        }

        ScrollView {
            VerticalLayout {
                width: 100%;
                padding: 16px;
                spacing: 16px;

                HorizontalLayout {
                    alignment: center;

                    Rectangle {
                        width: min(parent.width, 576px);
                        height: kind-content.preferred-height;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.border;
                        border-radius: 12px;

                        kind-content := VerticalLayout {
                            padding: 12px;
                            spacing: 6px;

                            Text {
                                text: "Что искать";
                                color: Theme.muted;
                                font-size: 12px;
                                font-weight: 500;
                            }

                            DiscoverKindRow {
                                label: "Группы";
                                selected: !root.channel-mode;
                                picked => {
                                    root.handle-query = "";
                                    root.channel-mode-changed(false);
                                }
                            }

                            DiscoverKindRow {
                                label: "Каналы";
                                selected: root.channel-mode;
                                picked => {
                                    root.handle-query = "";
                                    root.channel-mode-changed(true);
                                }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    alignment: center;

                    Rectangle {
                        width: min(parent.width, 576px);
                        height: search-content.preferred-height;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.border;
                        border-radius: 12px;

                        search-content := VerticalLayout {
                            padding: 12px;
                            spacing: 10px;

                            FHInput {
                                label: "Найти по адресу";
                                placeholder: "@example";
                                value <=> root.handle-query;
                                enabled: !root.busy;
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;

                                FHSecondaryButton {
                                    text: "Найти";
                                    height: 32px;
                                    enabled: !root.busy && !root.handle-query.is-empty;
                                    busy: root.busy;
                                    clicked => { root.lookup-requested(root.handle-query); }
                                }

                                if root.lookup-mode : FHTextButton {
                                    text: "Показать каталог";
                                    enabled: !root.busy;
                                    clicked => { root.show-catalog-requested(); }
                                }
                            }
                        }
                    }
                }

                if root.has-error : HorizontalLayout {
                    alignment: center;

                    Text {
                        width: min(parent.width, 576px);
                        text: root.error-text;
                        color: Theme.danger;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                }

                if root.loading : VerticalLayout {
                    width: 100%;
                    spacing: 8px;

                    for index in 3 : HorizontalLayout {
                        alignment: center;

                        Rectangle {
                            width: min(parent.width, 576px);
                            height: 72px;
                            background: Theme.surface;
                            border-width: 1px;
                            border-color: Theme.border;
                            border-radius: 12px;

                            HorizontalLayout {
                                padding: 12px;
                                spacing: 12px;
                                cross-axis-alignment: center;

                                FHSkeleton { width: 40px; height: 40px; corner-radius: 20px; }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 7px;
                                    FHSkeleton { width: 45%; height: 14px; }
                                    FHSkeleton { width: 70%; height: 12px; }
                                }
                                FHSkeleton { width: 88px; height: 32px; }
                            }
                        }
                    }
                }

                if !root.loading && !root.has-error && root.entries.length == 0 : HorizontalLayout {
                    alignment: center;

                    Rectangle {
                        width: min(parent.width, 576px);
                        background: transparent;

                        FHEmptyState {
                            title: "Публичных чатов пока нет";
                            description: "Попробуйте изменить запрос или откройте каталог.";

                            IconCompass {
                                width: 32px;
                                height: 32px;
                                stroke: Theme.muted;
                            }
                        }
                    }
                }

                if !root.loading : VerticalLayout {
                    spacing: 8px;

                    for entry in root.entries : HorizontalLayout {
                        alignment: center;

                        Rectangle {
                            width: min(parent.width, 576px);
                            height: row-content.preferred-height;
                            background: Theme.surface;
                            border-width: 1px;
                            border-color: Theme.border;
                            border-radius: 12px;

                            row-content := HorizontalLayout {
                                padding: 12px;
                                spacing: 12px;
                                cross-axis-alignment: center;

                                Rectangle {
                                    width: 40px;
                                    height: 40px;
                                    background: Theme.hover;
                                    border-radius: 20px;
                                    clip: true;

                                    if entry.has-avatar : Image {
                                        width: 100%;
                                        height: 100%;
                                        source: entry.avatar-image;
                                        image-fit: cover;
                                        accessible-role: none;
                                    }

                                    if !entry.has-avatar : Text {
                                        text: entry.initials;
                                        color: Theme.muted;
                                        font-size: 14px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: 100%;
                                        height: 100%;
                                        accessible-role: none;
                                    }
                                }

                                VerticalLayout {
                                    spacing: 3px;
                                    horizontal-stretch: 1;
                                    min-width: 0px;

                                    Text { text: entry.title; color: Theme.foreground; font-size: 14px; font-weight: 500; overflow: elide; }
                                    if !entry.description.is-empty : Text { text: entry.description; color: Theme.muted; font-size: 12px; wrap: word-wrap; max-height: 36px; }
                                    Text { text: entry.count-label; color: Theme.muted; font-size: 12px; }
                                }

                                FHSecondaryButton {
                                    text: "Открыть";
                                    height: 32px;
                                    enabled: !root.busy;
                                    clicked => { root.open-requested(entry.conversation-id); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
