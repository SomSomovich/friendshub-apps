import { Theme } from "theme.slint";
import { FHInput, FHPrimaryButton, FHTextButton } from "components.slint";

export component RegisterScreen inherits Rectangle {
    in property <string> language: "ru";
    in-out property <string> password: "";
    in property <string> error-text: "";
    in property <bool> busy: false;

    callback register-requested(string);
    callback login-requested();

    background: Theme.background;

    VerticalLayout {
        padding: 16px;
        alignment: center;

        HorizontalLayout {
            alignment: center;

            Rectangle {
                width: parent.width < 384px ? parent.width : 384px;
                border-radius: 16px;
                border-width: 1px;
                border-color: Theme.border;
                background: Theme.surface;

                VerticalLayout {
                    padding: 24px;
                    spacing: 16px;

                    Text {
                        text: root.language == "ru" ? "Регистрация" : "Create account";
                        color: Theme.foreground;
                        font-size: 18px;
                        font-weight: 600;
                    }

                    Text {
                        text: root.language == "ru" ? "Номер вида FH1234567 выдаётся сразу после создания аккаунта." : "An FH1234567-style number is issued as soon as the account exists.";
                        color: Theme.muted;
                        font-size: 12px;
                        wrap: word-wrap;
                    }

                    FHInput {
                        language: root.language;
                        label: root.language == "ru" ? "Пароль" : "Password";
                        placeholder: "";
                        value <=> root.password;
                        enabled: !root.busy;
                        password: true;
                        helper: root.language == "ru" ? "Минимум 8 символов." : "At least 8 characters.";
                        error: root.error-text;
                    }

                    FHPrimaryButton {
                    block: true;
                        text: root.language == "ru" ? "Создать аккаунт" : "Create account";
                        enabled: !root.busy;
                        busy: root.busy;
                        clicked => {
                            root.register-requested(root.password);
                        }
                    }

                    VerticalLayout {
                        spacing: 8px;

                        HorizontalLayout {
                            alignment: center;
                            FHTextButton {
                                text: root.language == "ru" ? "Уже зарегистрированы? Перейти к логину" : "Already registered? Sign in";
                                enabled: !root.busy;
                                clicked => { root.login-requested(); }
                            }
                        }

                    }
                }
            }
        }
    }
}
