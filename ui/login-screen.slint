import { Theme } from "theme.slint";
import { FHInput, FHPrimaryButton, FHTextButton } from "components.slint";

export component LoginScreen inherits Rectangle {
    in property <string> language: "ru";
    in-out property <string> fh-number;
    in-out property <string> password;
    in property <string> error-text: "";
    in property <bool> busy: false;
    in property <bool> authenticated: false;

    callback login-requested(string, string);
    callback register-requested();
    callback back-requested();
    callback local-accounts-requested();

    private property <bool> password-visible: false;

    background: Theme.background;

    VerticalLayout {
        padding: 16px;
        alignment: center;
        cross-axis-alignment: center;

        Rectangle {
            width: min(root.width - 32px, 384px);
            height: card-content.preferred-height;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 16px;

            card-content := VerticalLayout {
                padding: 24px;
                spacing: 16px;
                alignment: start;

                Text {
                    text: root.language == "ru" ? "Вход" : "Sign in";
                    color: Theme.foreground;
                    font-size: 18px;
                    font-weight: 600;
                }

                FHInput {
                    language: root.language;
                    label: root.language == "ru" ? "FH-номер" : "FH number";
                    placeholder: "FH1234567";
                    value <=> root.fh-number;
                    enabled: !root.busy;
                    password: false;
                    password-visible: false;
                    error: "";
                }

                FHInput {
                    language: root.language;
                    label: root.language == "ru" ? "Пароль" : "Password";
                    value <=> root.password;
                    enabled: !root.busy;
                    password: true;
                    password-visible <=> root.password-visible;
                    error: "";
                }

                if root.error-text != "": Text {
                    text: root.error-text;
                    color: Theme.danger;
                    font-size: 12px;
                    wrap: word-wrap;
                }

                FHPrimaryButton {
                    block: true;
                    busy: root.busy;
                    text: root.language == "ru" ? "Войти" : "Sign in";
                    enabled: !root.busy;
                    clicked => {
                        root.login-requested(root.fh-number, root.password);
                    }
                }

                VerticalLayout {
                    spacing: 8px;
                    alignment: center;

                    HorizontalLayout {
                        alignment: center;

                        FHTextButton {
                            text: root.language == "ru" ? "Создать аккаунт" : "Create an account";
                            enabled: !root.busy;
                            clicked => { root.register-requested(); }
                        }
                    }

                    HorizontalLayout {
                        alignment: center;
                        FHTextButton {
                            text: root.language == "ru" ? "Локальные аккаунты" : "Local accounts";
                            enabled: !root.busy;
                            clicked => { root.local-accounts-requested(); }
                        }
                    }

                    if root.authenticated : HorizontalLayout {
                        alignment: center;

                        FHTextButton {
                            text: root.language == "ru" ? "Назад" : "Back";
                            enabled: !root.busy;
                            clicked => { root.back-requested(); }
                        }
                    }
                }
            }
        }
    }
}
