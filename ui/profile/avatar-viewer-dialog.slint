import { Theme } from "../theme.slint";
import { FHIconButton } from "../components.slint";
import { IconX } from "../icons.slint";

export component AvatarViewerDialog inherits Rectangle {
    in property <bool> open: false;
    in property <bool> has-avatar: false;
    in property <image> avatar-image;

    callback close-requested();

    width: 100%;
    height: 100%;
    visible: root.open && root.has-avatar;
    background: #000000;

    TouchArea {
        clicked => { root.close-requested(); }
    }

    Image {
        width: 100%;
        height: 100%;
        source: root.avatar-image;
        image-fit: contain;
        accessible-role: none;
    }

    FHIconButton {
        x: parent.width - 52px;
        y: 12px;
        button-size: 40px;
        label: "Закрыть";
        clicked => { root.close-requested(); }

        IconX {
            width: 20px;
            height: 20px;
            x: 10px;
            y: 10px;
            stroke: #ffffff;
        }
    }
}
