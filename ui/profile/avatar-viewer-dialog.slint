import { Theme } from "../theme.slint";
import { FHTextButton } from "../components.slint";

export component AvatarViewerDialog inherits Rectangle {
    in property <bool> open: false;
    in property <bool> has-avatar: false;
    in property <image> avatar-image;

    callback close-requested();

    width: 100%;
    height: 100%;
    visible: root.open && root.has-avatar;
    background: #99000000;

    TouchArea {
        clicked => { root.close-requested(); }
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(parent.width - 32px, 576px);
        height: min(parent.height - 32px, 640px);
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border;
        border-radius: 12px;
        clip: true;

        TouchArea { }

        VerticalLayout {
            padding: 16px;
            spacing: 12px;

            HorizontalLayout {
                spacing: 12px;
                vertical-stretch: 0;

                Text {
                    text: "Аватар";
                    color: Theme.foreground;
                    font-size: 16px;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                FHTextButton {
                    text: "Закрыть";
                    clicked => { root.close-requested(); }
                }
            }

            Rectangle {
                min-height: 0px;
                vertical-stretch: 1;
                background: Theme.background;
                border-radius: 8px;
                clip: true;

                Image {
                    width: 100%;
                    height: 100%;
                    source: root.avatar-image;
                    image-fit: contain;
                }
            }
        }
    }
}
