import { Theme } from "../theme.slint";
import { FHSecondaryButton, FHScreenHeader } from "../components.slint";
import { IconCopy, IconPencil } from "../icons.slint";
import { ScrollView } from "std-widgets.slint";
import { AvatarViewerDialog } from "avatar-viewer-dialog.slint";

export struct OwnProfileField {
    label: string,
    value: string,
}

export component ProfileScreen inherits Rectangle {
    in property <string> username;
    in property <string> fh-number;
    in property <string> copy-status-text: "";
    in property <string> status-text;
    in property <string> status-emoji;
    in property <bool> has-avatar: false;
    in property <image> avatar-image;
    in property <string> avatar-initials;
    in property <[OwnProfileField]> fields;
    private property <bool> avatar-viewer-open: false;

    changed has-avatar => {
        if !root.has-avatar { root.avatar-viewer-open = false; }
    }

    callback back-requested();
    callback edit-requested();
    callback share-requested(string);
    callback avatar-open-requested();

    background: Theme.background;

    VerticalLayout {
        spacing: 0px;

        FHScreenHeader {
            title: "Профиль";
            back-requested => { root.back-requested(); }
        }

        ScrollView {
            VerticalLayout {
                width: 100%;
                padding: 16px;
                spacing: 12px;
                alignment: start;

                HorizontalLayout {
                    alignment: center;

                    Rectangle {
                        width: min(parent.width, 576px);
                        height: card-content.preferred-height;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.border;
                        border-radius: 12px;

                        card-content := VerticalLayout {
                            padding: 12px;
                            spacing: 12px;

                            HorizontalLayout {
                                spacing: 16px;

                                Rectangle {
                                    width: 80px;
                                    height: 80px;
                                    background: Theme.hover;
                                    border-radius: 40px;
                                    clip: true;

                                    if root.has-avatar : Image {
                                        width: 100%;
                                        height: 100%;
                                        source: root.avatar-image;
                                        image-fit: cover;
                                    }

                                    if !root.has-avatar : Text {
                                        text: root.avatar-initials;
                                        color: Theme.muted;
                                        font-size: 24px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: 100%;
                                        height: 100%;
                                    }

                                    if root.has-avatar : Rectangle {
                                        background: transparent;
                                        accessible-role: button;
                                        accessible-label: "Открыть аватар " + root.username;
                                        accessible-action-default => { root.avatar-viewer-open = true; }
                                        forward-focus: avatar-keyboard;

                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.avatar-viewer-open = true; }
                                        }

                                        avatar-keyboard := FocusScope {
                                            x: 0;
                                            width: 0;
                                            key-pressed(event) => {
                                                if event.text == Key.Space || event.text == Key.Return {
                                                    root.avatar-viewer-open = true;
                                                    return accept;
                                                }
                                                return reject;
                                            }
                                        }
                                    }
                                }

                                VerticalLayout {
                                    spacing: 2px;
                                    vertical-stretch: 0;

                                    Text {
                                        text: root.username;
                                        color: Theme.foreground;
                                        font-size: 16px;
                                        font-weight: 600;
                                        overflow: elide;
                                    }

                                    Text {
                                        text: root.fh-number;
                                        color: Theme.muted;
                                        font-size: 14px;
                                        overflow: elide;
                                    }

                                    if !root.status-text.is-empty || !root.status-emoji.is-empty : Text {
                                        text: "\{root.status-emoji} \{root.status-text}";
                                        color: Theme.muted;
                                        font-size: 14px;
                                        overflow: elide;
                                    }
                                }
                            }

                            Rectangle {
                                height: 1px;
                                background: Theme.border;
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;

                                FHSecondaryButton {
                                    text: "Изменить";
                                    height: 32px;
                                    clicked => { root.edit-requested(); }
                                }

                                FHSecondaryButton {
                                    text: "Скопировать FH-номер";
                                    height: 32px;
                                    clicked => { root.share-requested(root.fh-number); }
                                }
                            }
                            if !root.copy-status-text.is-empty : Text {
                                text: root.copy-status-text;
                                color: Theme.muted;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                if root.fields.length > 0 : HorizontalLayout {
                    alignment: center;

                    Rectangle {
                        width: min(parent.width, 576px);
                        height: fields-content.preferred-height;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.border;
                        border-radius: 12px;

                        fields-content := VerticalLayout {
                            padding: 12px;
                            spacing: 10px;

                            for field in root.fields : VerticalLayout {
                                spacing: 2px;

                                Text {
                                    text: field.label;
                                    color: Theme.muted;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }

                                Text {
                                    text: field.value;
                                    color: Theme.foreground;
                                    font-size: 14px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    alignment: center;

                    Rectangle {
                        width: min(parent.width, 576px);
                        height: number-content.preferred-height;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.border;
                        border-radius: 12px;

                        number-content := VerticalLayout {
                            padding: 12px;
                            spacing: 8px;

                            Text {
                                text: "FH-номер";
                                color: Theme.foreground;
                                font-size: 14px;
                                font-weight: 500;
                            }

                            Text {
                                text: "Постоянный номер аккаунта. Его можно передать собеседнику.";
                                color: Theme.muted;
                                font-size: 12px;
                                wrap: word-wrap;
                            }

                            HorizontalLayout {
                                Text {
                                    text: root.fh-number;
                                    color: Theme.foreground;
                                    font-size: 14px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }

                                FHSecondaryButton {
                                    text: "Копировать";
                                    height: 32px;
                                    clicked => { root.share-requested(root.fh-number); }
                                }
                            }
                            if !root.copy-status-text.is-empty : Text {
                                text: root.copy-status-text;
                                color: Theme.muted;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }
    }

    AvatarViewerDialog {
        open: root.avatar-viewer-open;
        has-avatar: root.has-avatar;
        avatar-image: root.avatar-image;
        close-requested => { root.avatar-viewer-open = false; }
    }
}
