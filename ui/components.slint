    }

    keyboard-scope := FocusScope {
        x: 0;
        width: 0;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}

export component FHBadge inherits Rectangle {
    in property <string> text;
    in property <bool> soft: false;

    width: badge-label.preferred-width + 12px;
    height: 18px;
    border-radius: 9px;
    background: root.soft ? Theme.accent.with-alpha(0.18) : Theme.accent;

    badge-label := Text {
        text: root.text;
        color: root.soft ? Theme.accent : Theme.accent-foreground;
        font-size: 10px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
        accessible-role: none;
    }
}

/** A pulsing placeholder. Sizes it like the element it stands in for. */
export component FHSkeleton inherits Rectangle {
    in property <length> corner-radius: 6px;

    background: Theme.hover;
    border-radius: root.corner-radius;
    opacity: 0.55 + 0.25 * sin(360deg * mod(animation-tick(), 1600ms) / 1600ms);
    accessible-role: none;
}

/** Centred icon + title + description. The icon is provided as a child. */
export component FHEmptyState inherits VerticalLayout {
    in property <string> title;
    in property <string> description: "";
    @children

    width: 100%;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 40px;
    padding-bottom: 40px;
    spacing: 8px;
    alignment: center;

    Text {
        text: root.title;
        color: Theme.foreground;
        font-size: 14px;
        font-weight: 500;
        horizontal-alignment: center;
        wrap: word-wrap;
        width: 100%;
        accessible-role: none;
    }

    if !root.description.is-empty : Text {
        text: root.description;
        color: Theme.muted;
        font-size: 12px;
        horizontal-alignment: center;
        wrap: word-wrap;
        width: min(parent.width, 320px);
        accessible-role: none;
    }
}

/**
 * The common screen header: back button, optional avatar, title/subtitle and
 * trailing actions supplied as children.
 */
export component FHScreenHeader inherits Rectangle {
    in property <string> title;
    in property <string> subtitle: "";
    in property <string> language: "ru";
    in property <bool> show-back: true;
    in property <image> avatar-image;
    in property <bool> has-avatar: false;
    in property <string> avatar-label: "";
    callback back-requested();
    callback title-requested();

    width: 100%;
    height: 60px;
    background: Theme.background;

    Rectangle {
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.border;
    }

    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        cross-axis-alignment: center;

        if root.show-back : Rectangle {
            width: 36px;
            height: 36px;
            background: back-area.has-hover ? Theme.hover : transparent;
            border-radius: 8px;
            accessible-role: button;
            accessible-label: root.language == "ru" ? "Назад" : "Back";
            accessible-action-default => { root.back-requested(); }
            forward-focus: back-keyboard-scope;

            states [
                focus when back-keyboard-scope.has-focus : {
                    border-width: 2px;
                    border-color: Theme.accent;
                }
            ]

            IconArrowLeft {
                width: 20px;
                height: 20px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                stroke: back-area.has-hover ? Theme.foreground : Theme.muted;
            }

            back-area := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.back-requested(); }
            }

            back-keyboard-scope := FocusScope {
                x: 0;
                width: 0;
                key-pressed(event) => {
                    if event.text == Key.Space || event.text == Key.Return {
                        root.back-requested();
                        return accept;
                    }
                    return reject;
                }
            }
        }

        if root.has-avatar : Rectangle {
            width: 36px;
            height: 36px;
            background: Theme.hover;
            border-radius: 18px;
            clip: true;
            accessible-role: button;
            accessible-label: root.title;
            accessible-action-default => { root.title-requested(); }

            Image {
                source: root.avatar-image;
                width: 100%;
                height: 100%;
                image-fit: cover;
                accessible-role: none;
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.title-requested(); }
            }
        }
        if !root.has-avatar && !root.avatar-label.is-empty : Rectangle {
            width: 36px;
            height: 36px;
            background: Theme.hover;
            border-radius: 18px;
            accessible-role: button;
            accessible-label: root.title;
            accessible-action-default => { root.title-requested(); }

            Text {
                text: root.avatar-label;
                color: Theme.muted;
                font-size: 12px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
                accessible-role: none;
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.title-requested(); }
            }
        }

        VerticalLayout {
            min-width: 0px;
            horizontal-stretch: 1;
            spacing: 1px;
            alignment: center;

            Text {
                text: root.title;
                color: Theme.foreground;
                font-size: 14px;
                font-weight: 500;
                overflow: elide;
            }

            if !root.subtitle.is-empty : Text {
                text: root.subtitle;
                color: Theme.muted;
                font-size: 12px;
                overflow: elide;
            }
        }

        HorizontalLayout {
            spacing: 2px;
            alignment: end;
            cross-axis-alignment: center;

            @children
        }
    }
}

/** A themed one-of-N dropdown. Replaces the unstyled stock ComboBox. */
export component FHSelect inherits Rectangle {
    in property <string> label: "";
    in property <[string]> options: [];
    in property <int> current-index: 0;
    in property <bool> enabled: true;
    callback selected(int);

    width: 100%;
    height: root.label.is-empty ? 40px : 64px;
    background: transparent;

    VerticalLayout {
        spacing: 6px;

        if !root.label.is-empty : Text {
            text: root.label;
            color: Theme.muted;
            font-size: 12px;
            font-weight: 500;
        }

        Rectangle {
            width: 100%;
            height: 40px;
            background: Theme.surface;
            border-width: 1px;
            border-radius: 8px;
            border-color: select-area.has-hover && root.enabled ? Theme.accent : Theme.border;
            opacity: root.enabled ? 1 : 0.5;
            clip: true;
            accessible-role: combobox;
            accessible-label: root.label;
            accessible-enabled: root.enabled;
            accessible-action-default => { popup.show(); }

            Text {
                text: root.current-index >= 0 && root.current-index < root.options.length ? root.options[root.current-index] : "";
                x: 12px;
                width: parent.width - 48px;
                height: parent.height;
                color: Theme.foreground;
                font-size: 14px;
                vertical-alignment: center;
                overflow: elide;
                accessible-role: none;
            }

            IconChevronDown {
                width: 16px;
                height: 16px;
                x: parent.width - 28px;
                y: (parent.height - self.height) / 2;
                stroke: Theme.muted;
            }

            select-area := TouchArea {
                enabled: root.enabled;
                mouse-cursor: pointer;
                clicked => { popup.show(); }
            }

            popup := PopupWindow {
                x: root.absolute-position.x;
                y: root.absolute-position.y + 44px;
                width: root.width;
                height: min(root.options.length, 8) * 36px + 8px;
                close-policy: PopupClosePolicy.close-on-click-outside;

                Rectangle {
                    width: 100%;
                    height: 100%;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: 10px;
                    drop-shadow-color: #66000000;
                    drop-shadow-blur: 20px;
                    drop-shadow-offset-y: 4px;
                    clip: true;

                    VerticalLayout {
                        padding: 4px;
                        spacing: 0px;

                        for option[index] in root.options : Rectangle {
                            width: 100%;
                            height: 36px;
                            background: option-area.has-hover ? Theme.hover : (index == root.current-index ? Theme.hover : transparent);
                            border-radius: 6px;
                            accessible-role: button;
                            accessible-label: option;
                            accessible-action-default => {
                                popup.close();
                                root.selected(index);
                            }

                            Text {
                                x: 10px;
                                width: parent.width - 20px;
                                height: parent.height;
                                text: option;
                                color: Theme.foreground;
                                font-size: 14px;
                                vertical-alignment: center;
                                overflow: elide;
                                accessible-role: none;
                            }

                            option-area := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    popup.close();
                                    root.selected(index);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

/** A themed multi-line text field. */
export component FHTextArea inherits Rectangle {
    in property <string> label: "";
    in property <string> placeholder: "";
    in-out property <string> value;
    in property <length> area-height: 96px;
    in property <bool> enabled: true;
    in property <string> helper: "";
    callback value-edited(string);

    width: 100%;
    height: (root.label.is-empty ? 0px : 24px) + root.area-height + (root.helper.is-empty ? 0px : 20px);
    background: transparent;

    VerticalLayout {
        spacing: 6px;

        if !root.label.is-empty : Text {
            text: root.label;
            color: Theme.muted;
            font-size: 12px;
            font-weight: 500;
        }

        Rectangle {
            width: 100%;
            height: root.area-height;
            background: Theme.surface;
            border-width: 1px;
            border-radius: 8px;
            border-color: input.has-focus ? Theme.accent : Theme.border;
            clip: true;
            opacity: root.enabled ? 1 : 0.5;

            input-scroll := ScrollView {
                x: 12px;
                y: 10px;
                width: parent.width - 24px;
                height: parent.height - 20px;
                horizontal-scrollbar-policy: always-off;
                content-width: self.visible-width;
                content-height: max(self.visible-height, input.preferred-height);

                input := TextInput {
                    width: parent.width;
                    height: max(input-scroll.visible-height, self.preferred-height);
                    text <=> root.value;
                    color: Theme.foreground;
                    enabled: root.enabled;
                    font-size: 14px;
                    single-line: false;
                    wrap: word-wrap;
                    page-height: input-scroll.visible-height;
                    accessible-label: root.label;
                    edited => { root.value-edited(input.text); }
                }
            }

            if root.value.is-empty && input.preedit-text.is-empty : Text {
                x: 12px;
                y: 10px;
                width: parent.width - 24px;
                text: root.placeholder;
                color: Theme.muted;
                font-size: 14px;
                wrap: word-wrap;
                accessible-role: none;
            }
        }

        if !root.helper.is-empty : Text {
            text: root.helper;
            color: Theme.muted;
            font-size: 12px;
            wrap: word-wrap;
            width: 100%;
        }
    }
}

/** A compact integer field for numeric preferences such as RGB channels. */
export component FHNumberInput inherits VerticalLayout {
    in property <string> label;
    in-out property <int> value: 0;
    in property <int> minimum: 0;
    in property <int> maximum: 255;
    in property <bool> enabled: true;
    private property <string> draft: "";

    spacing: 6px;
    horizontal-stretch: 1;

    init => { root.draft = "\{root.value}"; }
    changed value => { root.draft = "\{root.value}"; }

    Text {
        text: root.label;
        color: Theme.muted;
        font-size: 12px;
        font-weight: 500;
    }

    Rectangle {
        width: 100%;
        height: 40px;
        background: Theme.surface;
        border-width: 1px;
        border-radius: 8px;
        border-color: input.has-focus ? Theme.accent : Theme.border;
        opacity: root.enabled ? 1 : 0.5;
        clip: true;

        input := TextInput {
            x: 12px;
            width: parent.width - 24px;
            height: parent.height;
            text: root.draft;
            color: Theme.foreground;
            font-size: 14px;
            vertical-alignment: center;
            enabled: root.enabled;
            accessible-label: root.label;
            edited => {
                root.draft = self.text;
                let parsed = round(self.text.to-float());
                root.value = max(root.minimum, min(root.maximum, parsed));
            }
        }
    }
}
