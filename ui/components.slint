    Text {
        text: root.text;
        color: root.muted ? Theme.muted : Theme.accent;
        font-size: 13px;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
        accessible-role: none;
