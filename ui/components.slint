import { Theme } from "theme.slint";
import { IconArrowLeft, IconChevronDown, IconEye, IconEyeOff } from "icons.slint";
import { ScrollView } from "std-widgets.slint";

/** Small rotating ring used for busy buttons and panels. */
export component FHSpinner inherits Path {
    in property <color> tint: Theme.muted;
    in property <length> size: 16px;
    private property <angle> start-angle: 360deg * mod(animation-tick(), 1s) / 1s;

    width: root.size;
    height: root.size;
    viewbox-width: 16;
    viewbox-height: 16;
    stroke: root.tint;
    stroke-width: 2px;
    fill: transparent;
    accessible-role: none;

    MoveTo {
        x: 8 + 6 * cos(root.start-angle);
        y: 8 + 6 * sin(root.start-angle);
    }
    ArcTo {
        radius-x: 6;
        radius-y: 6;
        x: 8 + 6 * cos(root.start-angle + 270deg);
        y: 8 + 6 * sin(root.start-angle + 270deg);
        sweep: true;
        large-arc: true;
    }
}

component FHPasswordReveal inherits Rectangle {
    in property <string> language: "ru";
    in-out property <bool> revealed;
    in property <bool> enabled: true;

    width: 36px;
    height: 32px;
    background: mouse-area.has-hover && root.enabled ? Theme.hover : transparent;
    border-radius: 6px;
    accessible-role: button;
    accessible-enabled: root.enabled;
    accessible-label: root.revealed
        ? (root.language == "ru" ? "Скрыть пароль" : "Hide password")
        : (root.language == "ru" ? "Показать пароль" : "Show password");
    accessible-action-default => { if root.enabled { root.revealed = !root.revealed; } }
    forward-focus: keyboard-scope;

    states [
        focus when keyboard-scope.has-focus && root.enabled : {
            root.border-width: 2px;
            root.border-color: Theme.accent;
        }
    ]

    if root.revealed : IconEyeOff {
        width: 16px;
        height: 16px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        stroke: mouse-area.has-hover ? Theme.foreground : Theme.muted;
    }
    if !root.revealed : IconEye {
        width: 16px;
        height: 16px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        stroke: mouse-area.has-hover ? Theme.foreground : Theme.muted;
    }

    mouse-area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.revealed = !root.revealed; }
    }

    keyboard-scope := FocusScope {
        x: 0;
        width: 0;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.revealed = !root.revealed;
                return accept;
            }
            return reject;
        }
    }
}

export component FHInput inherits VerticalLayout {
    in property <string> language: "ru";
    in property <string> label;
    in property <string> placeholder;
    in-out property <string> value;
    in property <bool> enabled: true;
    in property <bool> password: false;
    in-out property <bool> password-visible: false;
    in property <string> helper: "";
    in property <string> error: "";
    in property <bool> hide-label: false;
    callback value-edited(string);

    spacing: 6px;
    horizontal-stretch: 1;

    if !root.hide-label : Text {
        text: root.label;
        color: Theme.muted;
        font-size: 12px;
        font-weight: 500;
    }

    field := Rectangle {
        width: 100%;
        height: 40px;
        background: Theme.surface;
        border-width: 1px;
        border-radius: 8px;
        border-color: root.error.is-empty ? (text-input.has-focus ? Theme.accent : Theme.border) : Theme.danger;
        clip: true;

        if root.value.is-empty : Text {
            x: 12px;
            width: parent.width - 24px - (root.password ? 40px : 0px);
            height: parent.height;
            text: root.placeholder;
            color: Theme.muted;
            font-size: 14px;
            vertical-alignment: center;
            accessible-role: none;
        }

        text-input := TextInput {
            x: 12px;
            width: max(parent.width - 24px - (root.password ? 40px : 0px), self.preferred-width);
            height: parent.height;
            text <=> root.value;
            input-type: root.password && !root.password-visible ? InputType.password : InputType.text;
            font-size: 14px;
            color: Theme.foreground;
            vertical-alignment: center;
            accessible-label: root.label;
            accessible-placeholder-text: root.placeholder;
            enabled: root.enabled;
            edited => { root.value-edited(root.value); }

            cursor-position-changed(position) => {
                if position.x + self.x < 12px {
                    self.x = 12px - position.x;
                } else if position.x + self.x > parent.width - 12px - (root.password ? 40px : 0px) - self.text-cursor-width {
                    self.x = parent.width - position.x - 12px - (root.password ? 40px : 0px) - self.text-cursor-width;
                }
            }
        }

        if root.password : FHPasswordReveal {
            language: root.language;
            x: parent.width - self.width - 3px;
            y: (parent.height - self.height) / 2;
            enabled: root.enabled;
            revealed <=> root.password-visible;
        }
    }

    if !root.error.is-empty : Text {
        text: root.error;
        color: Theme.danger;
        font-size: 12px;
        wrap: word-wrap;
        width: 100%;
    }
    if root.error.is-empty && !root.helper.is-empty : Text {
        text: root.helper;
        color: Theme.muted;
        font-size: 12px;
        wrap: word-wrap;
        width: 100%;
    }
}

export component FHPrimaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> busy: false;
    in property <bool> danger: false;
    /** Fills the available width. Forms use it; inline actions do not. */
    in property <bool> block: false;
    callback clicked();

    min-width: max(label.preferred-width + 32px, 72px);
    max-width: root.block ? 1000000px : max(label.preferred-width + 32px, 72px);
    horizontal-stretch: root.block ? 1 : 0;
    height: 40px;
    background: root.danger ? Theme.danger : Theme.accent;
    border-radius: 8px;
    border-width: 2px;
    border-color: transparent;
    opacity: enabled && !busy ? 1 : 0.5;
    animate background { duration: 120ms; }
    accessible-role: button;
    accessible-label: text;
    accessible-enabled: enabled && !busy;
    accessible-action-default => {
        if root.enabled && !root.busy { root.clicked(); }
    }
    forward-focus: keyboard-scope;

    states [
        hover when mouse-area.has-hover && root.enabled && !root.busy : {
            root.background: root.danger ? Theme.danger.brighter(1.1) : Theme.accent-hover;
        }
        focus when keyboard-scope.has-focus && root.enabled && !root.busy : {
            root.border-color: Theme.foreground;
        }
    ]

    HorizontalLayout {
        alignment: center;
        spacing: 8px;

        if root.busy : FHSpinner {
            size: 15px;
            tint: root.danger ? Theme.danger-foreground : Theme.accent-foreground;
        }

        Text {
            text: root.text;
            color: root.danger ? Theme.danger-foreground : Theme.accent-foreground;
            font-size: 14px;
            font-weight: 500;
            height: 100%;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
        }
    }

    mouse-area := TouchArea {
        enabled: root.enabled && !root.busy;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    keyboard-scope := FocusScope {
        x: 0;
        width: 0;
        enabled: root.enabled && !root.busy;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    label := Text {
        text: root.text;
        font-size: 14px;
        font-weight: 500;
        visible: false;
    }
}

export component FHSecondaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> busy: false;
    in property <bool> block: false;
    /** Outlined destructive action: red text and border on the normal surface. */
    in property <bool> danger: false;
    callback clicked();

    min-width: max(label.preferred-width + 32px, 72px);
    max-width: root.block ? 1000000px : max(label.preferred-width + 32px, 72px);
    horizontal-stretch: root.block ? 1 : 0;
    height: 40px;
    background: mouse-area.has-hover && root.enabled ? Theme.hover : Theme.surface;
    border-width: 1px;
    border-color: root.danger ? Theme.danger : Theme.border;
    border-radius: 8px;
    opacity: enabled && !busy ? 1 : 0.5;
    animate background { duration: 120ms; }
    accessible-role: button;
    accessible-label: text;
    accessible-enabled: enabled && !busy;
    accessible-action-default => {
        if root.enabled && !root.busy { root.clicked(); }
    }
    forward-focus: keyboard-scope;

    states [
        focus when keyboard-scope.has-focus && root.enabled && !root.busy : {
            root.border-color: Theme.accent;
            root.border-width: 2px;
        }
    ]

    HorizontalLayout {
        alignment: center;
        spacing: 8px;

        if root.busy : FHSpinner {
            size: 15px;
            tint: root.danger ? Theme.danger : Theme.muted;
        }

        Text {
            text: root.text;
            color: root.danger ? Theme.danger : Theme.foreground;
            font-size: 14px;
            font-weight: 500;
            height: 100%;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
        }
    }

    mouse-area := TouchArea {
        enabled: root.enabled && !root.busy;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    keyboard-scope := FocusScope {
        x: 0;
        width: 0;
        enabled: root.enabled && !root.busy;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    label := Text {
        text: root.text;
        font-size: 14px;
        font-weight: 500;
        visible: false;
    }
}

/** A square ghost button. Put the icon component inside as a child. */
export component FHIconButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> active: false;
    in property <length> button-size: 36px;
    callback clicked();
    @children

    width: root.button-size;
    height: root.button-size;
    background: root.active ? Theme.hover : (mouse-area.has-hover && root.enabled ? Theme.hover : transparent);
    border-radius: 8px;
    opacity: root.enabled ? 1 : 0.5;
    animate background { duration: 120ms; }
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: keyboard-scope;

    states [
        focus when keyboard-scope.has-focus && root.enabled : {
            root.border-width: 2px;
            root.border-color: Theme.accent;
        }
    ]

    mouse-area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    keyboard-scope := FocusScope {
        x: 0;
        width: 0;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}

