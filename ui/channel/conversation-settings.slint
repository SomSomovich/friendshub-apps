import { Theme } from "../theme.slint";
import { ChatAction } from "../chat/chat-controls.slint";
import { FHInput } from "../components.slint";
import { ScrollView, TextEdit } from "std-widgets.slint";

export struct ConversationMember {
    id: string,
    name: string,
    role: string,
    tag: string,
    actor-type: string,
    muted: bool,
    can-moderate: bool,
}

export struct ConversationRight {
    bit: int,
    label: string,
    enabled: bool,
    selected: bool,
}

component MemberRightControl inherits Rectangle {
    in property <string> label;
    in property <bool> enabled;
    in property <bool> selected;
    callback toggled();

    height: max(36px, right-content.preferred-height + 8px);
    border-radius: 8px;
    border-width: keyboard-scope.has-focus ? 1px : 0px;
    border-color: Theme.accent;
    background: right-pointer.has-hover && root.enabled ? Theme.hover : transparent;
    opacity: root.enabled ? 1 : 0.5;
    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.toggled(); } }
    forward-focus: keyboard-scope;

    right-content := HorizontalLayout {
        padding: 4px;
        spacing: 10px;
        alignment: center;
        Rectangle {
            width: 18px;
            height: 18px;
            border-radius: 4px;
            border-width: 1px;
            border-color: root.selected ? Theme.accent : Theme.border;
            background: root.selected ? Theme.accent : transparent;
            Text {
                text: root.selected ? "✓" : "";
                color: Theme.accent-foreground;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Text {
            text: root.label;
            color: Theme.foreground;
            font-size: 13px;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }
    }
    right-pointer := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
    keyboard-scope := FocusScope {
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.toggled();
                return accept;
            }
            return reject;
        }
    }
}

export struct ConversationInvite {
    id: string,
    kind-label: string,
    token: string,
    detail: string,
}

export struct ConversationOption {
    id: string,
    label: string,
    present: bool,
    selected: bool,
}

export struct ChannelAnalytic {
    post-id: string,
    text: string,
    views-label: string,
}

export component ConversationSettingsScreen inherits Rectangle {
    in property <string> kind: "group";
    in property <string> title: "Настройки группы";
    in property <string> conversation-title: "";
    in property <string> description: "";
    in property <string> handle: "";
    in property <string> error-text: "";
    in property <string> profile-error-text: "";
    in-out property <string> invite-copy-status-text: "";
    in-out property <bool> invite-copy-status-error: false;
    in property <string> linked-group-id: "";
    in property <bool> linked-group-state-known: false;
    in property <[ConversationMember]> members;
    in property <[ConversationMember]> banned-members;
    in property <[ConversationOption]> available-members;
    in property <[ConversationInvite]> invites;
    in property <[ConversationOption]> linked-groups;
    in property <[ConversationOption]> available-bots;
    in property <[ChannelAnalytic]> analytics;
    in property <bool> loading: false;
    in property <bool> no-access: false;
    in property <bool> members-unavailable: false;
    in property <bool> can-edit-profile: false;
    in property <bool> can-manage-members: false;
    in property <bool> can-manage-roles: false;
    in property <bool> can-mute-members: false;
    in property <bool> can-change-tags: false;
    in property <bool> can-remove-members: false;
    in property <bool> can-ban-members: false;
    in property <bool> can-manage-invites: false;
    in property <bool> can-view-analytics: false;
    in property <bool> is-owner: false;
    in property <bool> is-public: false;
    in property <bool> public-state-known: false;
    in property <bool> has-photo: false;
    in property <bool> profile-save-enabled: true;
    in property <image> photo-image;
    in property <bool> busy: false;
    in property <bool> member-tag-editor-save-enabled: false;
    in property <bool> member-rights-editor-open: false;
    in property <bool> member-mute-editor-open: false;
    in property <string> member-editor-label: "";
    in property <[ConversationRight]> member-right-options: [];
    in property <bool> member-rights-above: false;
    in property <bool> member-moderator-muted: false;
    in property <bool> confirmation-visible: false;
    in property <string> confirmation-title: "";
    in property <string> confirmation-description: "";
    in property <bool> confirmation-show-ban-option: false;
    in-out property <bool> confirmation-ban-on-remove: false;
    in-out property <string> title-draft: "";
    in-out property <string> description-draft: "";
    in-out property <string> handle-draft: "";
    in-out property <string> linked-group-draft: "";
    in-out property <string> selected-member-id: "";
    in-out property <int> selected-owner-index: -1;
    in-out property <bool> public-state-draft: false;
    in-out property <bool> member-tag-editor-open: false;
    in-out property <int> member-tag-editor-index: -1;
    in-out property <string> member-tag-editor-draft: "";
    in-out property <string> member-tag-editor-error-text: "";
    in-out property <bool> member-tag-editor-has-existing-tag: false;

    callback back-requested();
    callback retry-requested();
    callback metadata-save-requested(string, string, bool);
    callback photo-change-requested();
    callback photo-remove-requested();
    callback handle-save-requested(string);
    callback public-state-changed(bool);
    callback linked-group-save-requested(string);
    callback member-add-requested(string);
    callback member-action-requested(int, string);
    callback member-right-toggle-requested(int);
    callback member-rights-save-requested();
    callback member-mute-save-requested(string);
    callback member-editor-close-requested();
    callback member-tag-save-requested(int, string);
    callback member-tag-draft-changed(string);
    callback member-tag-remove-requested(int);
    callback banned-member-action-requested(int, string);
    callback invite-create-requested(string);
    callback invite-copy-requested(int);
    callback invite-revoke-requested(int);
    callback channel-bot-add-requested(string);
    callback analytics-refresh-requested();
    callback owner-transfer-requested(int);
    callback conversation-delete-requested();
    callback confirmation-accepted();
    callback confirmation-cancelled();

    changed invites => {
        root.invite-copy-status-text = "";
        root.invite-copy-status-error = false;
    }

    background: Theme.background;

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: 56px;
            background: Theme.background;
            HorizontalLayout {
                padding: 8px;
                spacing: 8px;
                ChatAction { label: "←"; width: 36px; clicked => { root.back-requested(); } }
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    horizontal-stretch: 1;
                    Text { text: root.title; color: Theme.foreground; font-size: 14px; font-weight: 600; }
                    if !root.conversation-title.is-empty : Text { text: root.conversation-title; color: Theme.muted; font-size: 11px; }
                }
            }
        }

        if root.loading : Text {
            text: "Загружаем настройки…";
            color: Theme.muted;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-stretch: 1;
        }

        if !root.loading && root.no-access : VerticalLayout {
            alignment: center;
            spacing: 8px;
            Text { text: "Настройки доступны владельцу и администраторам"; color: Theme.foreground; font-size: 14px; horizontal-alignment: center; }
            if root.members-unavailable : Text { text: "Прочитать участников не удалось, а без этого неизвестно, что вам разрешено."; color: Theme.muted; font-size: 12px; wrap: word-wrap; horizontal-alignment: center; }
            ChatAction { label: root.members-unavailable ? "Повторить" : "Вернуться в чат"; clicked => { if root.members-unavailable { root.retry-requested(); } else { root.back-requested(); } } }
        }

        if !root.loading && !root.no-access && !root.error-text.is-empty : VerticalLayout {
            alignment: center;
            spacing: 8px;
            Text { text: root.error-text; color: Theme.danger; font-size: 12px; wrap: word-wrap; horizontal-alignment: center; }
            ChatAction { label: "Повторить"; clicked => { root.retry-requested(); } }
        }

        if !root.loading && !root.no-access && root.error-text.is-empty : ScrollView {
            width: 100%;
            vertical-stretch: 1;
            vertical-scrollbar-policy: as-needed;
            VerticalLayout {
                width: 100%;
                max-width: 640px;
                padding: 16px;
                spacing: 12px;

                if root.kind == "group" && root.can-edit-profile : Rectangle {
                    width: 100%;
                    height: metadata-panel.preferred-height;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: 12px;
                    metadata-panel := VerticalLayout {
                        padding: 14px;
                        spacing: 10px;
                        Text { text: "Профиль группы"; color: Theme.foreground; font-size: 14px; font-weight: 600; }
                        FHInput { label: "Название"; value <=> root.title-draft; }
                        Rectangle {
                            height: 88px;
                            background: Theme.background;
                            border-width: 1px;
                            border-color: Theme.border;
                            border-radius: 8px;
                            TextEdit {
                                x: 10px; y: 8px; width: parent.width - 20px; height: parent.height - 16px;
                                text <=> root.description-draft;
                                placeholder-text: "Описание";
                                font-size: 13px;
                                wrap: word-wrap;
                            }
                        }
                        if root.is-owner : ChatAction {
                            label: "Публичная группа";
                            active: root.public-state-draft;
                            clicked => { root.public-state-draft = !root.public-state-draft; }
                        }
                        if !root.profile-error-text.is-empty : Text { text: root.profile-error-text; color: Theme.danger; font-size: 11px; wrap: word-wrap; }
                        ChatAction {
                            label: root.busy ? "Сохраняем…" : "Сохранить";
                            active: true;
                            enabled: !root.busy && root.profile-save-enabled;
                            clicked => { root.metadata-save-requested(root.title-draft, root.description-draft, root.public-state-draft); }
                        }
                    }
                }

                if root.can-edit-profile || (root.kind == "channel" && root.is-owner) : Rectangle {
                    width: 100%;
                    height: photo-panel.preferred-height;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: 12px;
                    photo-panel := VerticalLayout {
                        padding: 14px; spacing: 8px;
                        Text { text: "Фото"; color: Theme.foreground; font-size: 14px; font-weight: 600; }
                        Rectangle {
                            width: 72px;
                            height: 72px;
                            background: Theme.background;
                            border-width: 1px;
                            border-color: Theme.border;
                            border-radius: 12px;
                            clip: true;
                            if root.has-photo : Image { width: 100%; height: 100%; source: root.photo-image; image-fit: cover; }
                            if !root.has-photo : Text { text: "Нет фото"; color: Theme.muted; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; }
                        }
                        Text { text: "PNG, JPEG или WebP до 20 МБ. Приложение уменьшит фото до 512 пикселей и загрузит WebP до 5 МБ."; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                        HorizontalLayout {
                            spacing: 8px;
                            ChatAction { label: "Изменить фото"; enabled: !root.busy; clicked => { root.photo-change-requested(); } }
                            if root.has-photo : ChatAction { label: "Удалить фото"; danger: true; enabled: !root.busy; clicked => { root.photo-remove-requested(); } }
                        }
                    }
                }

                if (root.kind == "group" && root.can-edit-profile) || (root.kind == "channel" && root.is-owner) : Rectangle {
                    width: 100%;
                    height: handle-panel.preferred-height;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: 12px;
                    handle-panel := VerticalLayout {
                        padding: 14px; spacing: 8px;
                        Text { text: "Ссылка-имя"; color: Theme.foreground; font-size: 14px; font-weight: 600; }
                        Text { text: "По ней группу или канал находят в поиске."; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                        Text { text: root.handle.is-empty ? "Текущее значение адреса недоступно." : "Текущий адрес на этом устройстве: @" + root.handle; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                        FHInput { label: "Новая ссылка-имя"; placeholder: root.handle; value <=> root.handle-draft; helper: "Новое значение заменит прежнее."; }
                        ChatAction { label: root.busy ? "Сохраняем…" : "Сохранить"; enabled: !root.busy && !root.handle-draft.is-empty; active: true; clicked => { root.handle-save-requested(root.handle-draft); } }
                    }
                }

                if root.kind == "channel" && root.is-owner : Rectangle {
                    width: 100%;
                    height: channel-options.preferred-height;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: 12px;
                    channel-options := VerticalLayout {
                        padding: 14px; spacing: 8px;
                        Text { text: "Доступ и обсуждение"; color: Theme.foreground; font-size: 14px; font-weight: 600; }
                        if root.public-state-known : ChatAction {
                            label: "Публичный канал";
                            active: root.is-public;
                            enabled: !root.busy;
                            clicked => { root.public-state-changed(!root.is-public); }
                        }
                        if !root.public-state-known : HorizontalLayout {
                            spacing: 6px;
                            ChatAction { label: "Сделать публичным"; enabled: !root.busy; clicked => { root.public-state-changed(true); } }
                            ChatAction { label: "Сделать приватным"; enabled: !root.busy; clicked => { root.public-state-changed(false); } }
                        }
                        if !root.public-state-known : Text { text: "Сервер не отдаёт текущее значение, поэтому сначала выбор, а не переключатель."; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                        ChatAction {
                            label: "Без обсуждений";
                            active: root.linked-group-state-known && root.linked-group-draft.is-empty;
                            enabled: !root.busy;
                            clicked => { root.linked-group-save-requested(""); }
                        }
                        for linked-group[index] in root.linked-groups : ChatAction {
                            label: linked-group.label;
                            active: root.linked-group-state-known && linked-group.selected;
                            enabled: !root.busy;
                            clicked => { root.linked-group-save-requested(linked-group.id); }
                        }
                        if root.linked-groups.length == 0 : Text {
                            text: "У вас пока нет групп, которые можно привязать.";
                            color: Theme.muted;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        if !root.linked-group-state-known : Text {
                            text: "Сервер не возвращает текущее значение группы обсуждений.";
                            color: Theme.muted;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                    }
                }

                if root.can-manage-members : Rectangle {
                    width: 100%;
                    height: members-panel.preferred-height;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: 12px;
                    members-panel := VerticalLayout {
                        padding: 14px; spacing: 8px;
                        Text { text: root.kind == "channel" ? "Подписчики" : "Участники"; color: Theme.foreground; font-size: 14px; font-weight: 600; }
                        if root.kind == "group" && root.can-ban-members : Text { text: "Участников можно исключать и блокировать по праву блокировки участников."; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                        if root.kind == "group" && !root.can-ban-members : Text { text: "Доступные действия зависят от ваших прав в группе."; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                        if root.kind == "channel" : Text { text: "Роли и исключение подписчиков доступны только владельцу канала."; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                        if root.kind == "group" && root.available-members.length > 0 : VerticalLayout {
                            spacing: 4px;
                            Text { text: "Добавить участника"; color: Theme.muted; font-size: 12px; }
                            for contact[index] in root.available-members : ChatAction {
                                label: contact.label;
                                active: root.selected-member-id == contact.id;
                                width: 100%;
                                enabled: !root.busy && !contact.present;
                                clicked => { root.selected-member-id = contact.id; }
                            }
                            ChatAction {
                                label: root.busy ? "Добавляем…" : "Добавить участника";
                                active: true;
                                enabled: !root.busy && !root.selected-member-id.is-empty;
                                clicked => { root.member-add-requested(root.selected-member-id); }
                            }
                        }
                        for member[index] in root.members : Rectangle {
                            width: 100%;
                            height: member-row.preferred-height;
                            background: Theme.background;
                            border-width: 1px;
                            border-color: Theme.border;
                            border-radius: 8px;
                            member-row := VerticalLayout {
                                padding: 8px;
                                spacing: 6px;
                                HorizontalLayout {
                                    spacing: 6px;
                                    VerticalLayout {
                                        spacing: 2px;
                                        horizontal-stretch: 1;
                                        Text { text: member.name; color: Theme.foreground; font-size: 13px; font-weight: 500; }
                                        Text { text: member.role + (member.tag.is-empty ? "" : " · " + member.tag) + (member.muted ? " · Заглушён" : ""); color: Theme.muted; font-size: 11px; }
                                    }
                                    Text { text: member.actor-type == "bot" ? "Бот" : ""; color: Theme.accent; font-size: 10px; }
                                }
                                FlexboxLayout {
                                    spacing: 4px;
                                    if root.can-manage-roles && member.can-moderate : ChatAction {
                                        label: member.role == "admin" ? (root.kind == "channel" ? "Снять права администратора" : "Изменить права") : "Сделать администратором";
                                        enabled: !root.busy;
                                        clicked => { root.member-action-requested(index, member.role == "admin" ? (root.kind == "channel" ? "demote" : "edit_rights") : "make_admin"); }
                                    }
                                    if root.kind == "group" && root.can-mute-members && member.can-moderate : ChatAction { label: member.muted ? "Снять заглушение" : "Заглушить"; enabled: !root.busy; clicked => { root.member-action-requested(index, member.muted ? "unmute" : "mute"); } }
                                    if root.can-change-tags && member.actor-type == "account" : ChatAction {
                                        label: member.tag.is-empty ? "Добавить тег" : "Изменить тег";
                                        enabled: !root.busy;
                                        clicked => {
                                            root.member-tag-editor-index = index;
                                            root.member-tag-editor-draft = member.tag;
                                            root.member-tag-editor-has-existing-tag = !member.tag.is-empty;
                                            root.member-tag-editor-error-text = "";
                                            root.member-tag-editor-open = true;
                                            root.member-tag-draft-changed(root.member-tag-editor-draft);
                                        }
                                    }
                                    if root.can-remove-members && member.can-moderate : ChatAction { label: "Исключить"; danger: true; enabled: !root.busy; clicked => { root.member-action-requested(index, "remove"); } }
                                }
                            }
                        }
                        if root.kind == "group" && root.can-ban-members : VerticalLayout {
                            spacing: 6px;
                            Text { text: "Заблокированные участники"; color: Theme.foreground; font-size: 13px; font-weight: 600; }
                            for banned-member[index] in root.banned-members : Rectangle {
                                width: 100%;
                                height: 36px;
                                background: Theme.background;
                                border-width: 1px;
                                border-color: Theme.border;
                                border-radius: 8px;
                                HorizontalLayout {
                                    padding-left: 8px; padding-right: 4px; spacing: 6px;
                                    Text { text: banned-member.name; color: Theme.foreground; font-size: 12px; horizontal-stretch: 1; vertical-alignment: center; }
                                    ChatAction { label: "Разблокировать"; enabled: !root.busy; clicked => { root.banned-member-action-requested(index, "unban"); } }
                                }
                            }
                        }
                    }
                }

                if root.kind == "channel" && root.is-owner : Rectangle {
                    width: 100%;
                    height: bots-panel.preferred-height;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: 12px;
                    bots-panel := VerticalLayout {
                        padding: 14px; spacing: 8px;
                        Text { text: "Боты канала"; color: Theme.foreground; font-size: 14px; font-weight: 600; }
                        Text { text: "В канал можно добавить только своих ботов."; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                        if root.available-bots.length == 0 : Text { text: "У вас пока нет ботов: их создают через Bot API."; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                        for bot[index] in root.available-bots : HorizontalLayout {
                            Text { text: bot.label; color: Theme.foreground; font-size: 12px; horizontal-stretch: 1; vertical-alignment: center; }
                            ChatAction {
                                label: bot.present ? "Уже в канале" : "Добавить";
                                enabled: !root.busy && !bot.present;
                                clicked => { root.channel-bot-add-requested(bot.id); }
                            }
                        }
                    }
                }

                if root.kind == "channel" && root.can-view-analytics : Rectangle {
                    width: 100%;
                    height: analytics-panel.preferred-height;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: 12px;
                    analytics-panel := VerticalLayout {
                        padding: 14px; spacing: 8px;
                        Text { text: "Статистика канала"; color: Theme.foreground; font-size: 14px; font-weight: 600; }
                        Text { text: "Просмотры публикаций"; color: Theme.muted; font-size: 12px; }
                        Text { text: "Последние 50 публикаций, начиная с новых. Просмотр учитывается один раз на аккаунт."; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                        if root.analytics.length == 0 : Text { text: "Публикаций пока нет."; color: Theme.muted; font-size: 12px; }
                        for analytic[index] in root.analytics : HorizontalLayout {
                            Text { text: analytic.text.is-empty ? "Публикация" : analytic.text; color: Theme.foreground; font-size: 12px; horizontal-stretch: 1; overflow: elide; }
                            Text { text: analytic.views-label; color: Theme.muted; font-size: 12px; }
                        }
                        ChatAction { label: "Обновить статистику"; enabled: !root.busy; clicked => { root.analytics-refresh-requested(); } }
                    }
                }

                if root.can-manage-invites : Rectangle {
                    width: 100%;
                    height: invites-panel.preferred-height;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: 12px;
                    invites-panel := VerticalLayout {
                        padding: 14px; spacing: 8px;
                        Text { text: "Приглашения"; color: Theme.foreground; font-size: 14px; font-weight: 600; }
                        Text { text: "Создайте постоянный или одноразовый код приглашения."; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                        HorizontalLayout {
                            spacing: 6px;
                            ChatAction { label: "Постоянный код"; enabled: !root.busy; clicked => { root.invite-create-requested("permanent"); } }
                            ChatAction { label: "Одноразовый код"; enabled: !root.busy; clicked => { root.invite-create-requested("one_time"); } }
                        }
                        if root.invites.length == 0 : Text { text: "Приглашений пока нет."; color: Theme.muted; font-size: 12px; }
                        for invite[index] in root.invites : HorizontalLayout {
                            spacing: 6px;
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 44px;
                                background: Theme.background;
                                border-width: 1px;
                                border-color: Theme.border;
                                border-radius: 8px;
                                VerticalLayout {
                                    x: 8px; y: 5px; width: parent.width - 16px;
                                    Text { text: invite.kind-label; color: Theme.foreground; font-size: 12px; }
                                    Text { text: invite.detail; color: Theme.muted; font-size: 10px; }
                                }
                            }
                            ChatAction { label: "Копировать код"; enabled: !invite.token.is-empty; clicked => { root.invite-copy-requested(index); } }
                            ChatAction { label: "Отозвать"; danger: true; enabled: !root.busy; clicked => { root.invite-revoke-requested(index); } }
                        }
                        if !root.invite-copy-status-text.is-empty : Text {
                            text: root.invite-copy-status-text;
                            color: root.invite-copy-status-error ? Theme.danger : Theme.muted;
                            font-size: 11px;
                            wrap: word-wrap;
                            width: 100%;
                        }
                    }
                }

                if root.is-owner : Rectangle {
                    width: 100%;
                    height: ownership-panel.preferred-height;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: 12px;
                    ownership-panel := VerticalLayout {
                        padding: 14px; spacing: 8px;
                        Text { text: "Управление владением"; color: Theme.foreground; font-size: 14px; font-weight: 600; }
                        Text { text: "Новый владелец"; color: Theme.muted; font-size: 11px; }
                        for member[index] in root.members : ChatAction {
                            label: member.name;
                            visible: member.actor-type == "account" && member.role != "owner";
                            active: root.selected-owner-index == index;
                            enabled: !root.busy;
                            clicked => { root.selected-owner-index = index; }
                        }
                        ChatAction {
                            label: "Передать владение";
                            active: true;
                            enabled: !root.busy && root.selected-owner-index >= 0;
                            clicked => { root.owner-transfer-requested(root.selected-owner-index); }
                        }
                        ChatAction {
                            label: root.kind == "group" ? "Удалить группу" : "Удалить канал";
                            danger: true;
                            enabled: !root.busy;
                            clicked => { root.conversation-delete-requested(); }
                        }
                    }
                }
            }
        }
    }

    if root.confirmation-visible : Rectangle {
        x: 0px; y: 0px; width: 100%; height: 100%;
            background: #99000000;
            TouchArea { clicked => { root.confirmation-cancelled(); } }
            Rectangle {
                x: (parent.width - min(parent.width - 32px, 420px)) / 2;
                y: (parent.height - confirmation-card.preferred-height) / 2;
                width: min(parent.width - 32px, 420px);
                height: confirmation-card.preferred-height;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.border;
                border-radius: 12px;
                confirmation-card := VerticalLayout {
                    padding: 20px; spacing: 12px;
                    Text { text: root.confirmation-title; color: Theme.foreground; font-size: 16px; font-weight: 600; }
                    Text { text: root.confirmation-description; color: Theme.muted; font-size: 13px; wrap: word-wrap; }
                    if root.confirmation-show-ban-option : ChatAction {
                        label: root.confirmation-ban-on-remove ? "☑ Заблокировать при исключении" : "☐ Заблокировать при исключении";
                        active: root.confirmation-ban-on-remove;
                        enabled: !root.busy;
                        clicked => { root.confirmation-ban-on-remove = !root.confirmation-ban-on-remove; }
                    }
                    HorizontalLayout {
                        alignment: end; spacing: 8px;
                        ChatAction { label: "Отмена"; clicked => { root.confirmation-cancelled(); } }
                        ChatAction { label: "Подтвердить"; danger: true; enabled: !root.busy; clicked => { root.confirmation-accepted(); } }
                    }
                }
            }
        }

    if root.kind == "group" && root.member-rights-editor-open : Rectangle {
        x: 0px; y: 0px; width: 100%; height: 100%;
        background: #99000000;
        TouchArea { enabled: !root.busy; clicked => { root.member-editor-close-requested(); } }
        Rectangle {
            width: min(parent.width - 32px, 500px);
            height: min(parent.height - 32px, 660px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 12px;
            clip: true;
            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text { text: "Права администратора"; color: Theme.foreground; font-size: 16px; font-weight: 600; }
                Text { text: root.member-editor-label; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                ScrollView {
                    vertical-stretch: 1;
                    content-width: self.width;
                    VerticalLayout {
                        spacing: 6px;
                        for right in root.member-right-options : MemberRightControl {
                            label: right.label;
                            selected: right.selected;
                            enabled: right.enabled && !root.busy;
                            toggled => { root.member-right-toggle-requested(right.bit); }
                        }
                        if root.member-rights-above : Text {
                            text: "У участника есть права, которых нет у вас. Эта форма их не показывает, а сохранение их снимет.";
                            color: Theme.muted;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        Text {
                            text: root.is-owner ? "Владелец может выдать любые права." : "Выдать можно только те права, которые есть у вас.";
                            color: Theme.muted;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        Text { text: "Если снять все отметки, участник снова станет обычным."; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                        if !root.error-text.is-empty : Text { text: root.error-text; color: Theme.danger; font-size: 12px; wrap: word-wrap; }
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    ChatAction { label: "Отмена"; enabled: !root.busy; clicked => { root.member-editor-close-requested(); } }
                    ChatAction { label: root.busy ? "Сохраняем…" : "Сохранить"; active: true; enabled: !root.busy; clicked => { root.member-rights-save-requested(); } }
                }
            }
        }
    }

    if root.kind == "group" && root.member-mute-editor-open : Rectangle {
        x: 0px; y: 0px; width: 100%; height: 100%;
        background: #99000000;
        TouchArea { enabled: !root.busy; clicked => { root.member-editor-close-requested(); } }
        Rectangle {
            width: min(parent.width - 32px, 420px);
            height: min(parent.height - 32px, mute-card.preferred-height);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 12px;
            clip: true;
            ScrollView {
                content-width: self.width;
                mute-card := VerticalLayout {
                    padding: 20px;
                    spacing: 8px;
                    Text { text: "Заглушить участника"; color: Theme.foreground; font-size: 16px; font-weight: 600; }
                    Text { text: root.member-editor-label; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                    if root.member-moderator-muted : ChatAction {
                        label: "Снять заглушение";
                        enabled: !root.busy;
                        clicked => { root.member-mute-save-requested("unmute"); }
                    }
                    ChatAction { label: "На час"; enabled: !root.busy; clicked => { root.member-mute-save-requested("hour"); } }
                    ChatAction { label: "На 8 часов"; enabled: !root.busy; clicked => { root.member-mute-save-requested("eight-hours"); } }
                    ChatAction { label: "На сутки"; enabled: !root.busy; clicked => { root.member-mute-save-requested("day"); } }
                    ChatAction { label: "На неделю"; enabled: !root.busy; clicked => { root.member-mute-save-requested("week"); } }
                    ChatAction { label: "Навсегда"; enabled: !root.busy; clicked => { root.member-mute-save-requested("forever"); } }
                    if !root.error-text.is-empty : Text { text: root.error-text; color: Theme.danger; font-size: 12px; wrap: word-wrap; }
                    HorizontalLayout {
                        alignment: end;
                        ChatAction { label: "Отмена"; enabled: !root.busy; clicked => { root.member-editor-close-requested(); } }
                    }
                }
            }
        }
    }

    if root.member-tag-editor-open : Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        background: #99000000;

        TouchArea {
            clicked => {
                if !root.busy {
                    root.member-tag-editor-open = false;
                    root.member-tag-editor-error-text = "";
                }
            }
        }

        Rectangle {
            x: (parent.width - min(parent.width - 32px, 420px)) / 2;
            y: (parent.height - member-tag-card.preferred-height) / 2;
            width: min(parent.width - 32px, 420px);
            height: member-tag-card.preferred-height;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 12px;
            clip: true;

            member-tag-card := VerticalLayout {
                padding: 20px;
                spacing: 12px;

                Text {
                    text: "Тег участника";
                    color: Theme.foreground;
                    font-size: 16px;
                    font-weight: 600;
                }

                VerticalLayout {
                    spacing: 6px;
                    Text { text: "Тег"; color: Theme.muted; font-size: 12px; font-weight: 600; }
                    Rectangle {
                        width: 100%;
                        height: 40px;
                        background: Theme.background;
                        border-width: 1px;
                        border-color: tag-input.has-focus ? Theme.accent : Theme.border;
                        border-radius: 8px;
                        clip: true;
                        if root.member-tag-editor-draft.is-empty : Text {
                            x: 12px;
                            width: parent.width - 24px;
                            height: parent.height;
                            text: "Например, Модератор";
                            color: Theme.muted;
                            font-size: 14px;
                            vertical-alignment: center;
                            accessible-role: none;
                        }
                        tag-input := TextInput {
                            x: 12px;
                            width: parent.width - 24px;
                            height: parent.height;
                            text <=> root.member-tag-editor-draft;
                            enabled: !root.busy;
                            font-size: 14px;
                            color: Theme.foreground;
                            accessible-label: "Тег участника";
                            accessible-placeholder-text: "Например, Модератор";
                            edited => {
                                root.member-tag-editor-error-text = "";
                                root.member-tag-draft-changed(root.member-tag-editor-draft);
                            }
                        }
                    }
                    Text {
                        text: root.member-tag-editor-error-text.is-empty
                            ? "От 1 до 9 символов; нельзя использовать <, > и &."
                            : root.member-tag-editor-error-text;
                        color: root.member-tag-editor-error-text.is-empty ? Theme.muted : Theme.danger;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    if root.member-tag-editor-has-existing-tag : ChatAction {
                        label: "Удалить тег";
                        danger: true;
                        enabled: !root.busy;
                        clicked => { root.member-tag-remove-requested(root.member-tag-editor-index); }
                    }
                    ChatAction {
                        label: "Отмена";
                        enabled: !root.busy;
                        clicked => {
                            root.member-tag-editor-open = false;
                            root.member-tag-editor-error-text = "";
                        }
                    }
                    ChatAction {
                        label: root.busy ? "Сохраняем…" : "Сохранить";
                        active: true;
                        enabled: !root.busy && root.member-tag-editor-save-enabled;
                        clicked => {
                            root.member-tag-save-requested(
                                root.member-tag-editor-index,
                                root.member-tag-editor-draft,
                            );
                        }
                    }
                }
            }
        }
    }
}
