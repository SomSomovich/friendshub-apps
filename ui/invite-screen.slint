import { Theme } from "theme.slint";
import { FHSecondaryButton, FHSpinner } from "components.slint";
import { IconUserRoundPlus } from "icons.slint";

export component InviteScreen inherits Rectangle {
    in property <string> invite-token;
    in property <bool> failed: false;
    in property <bool> sync-failed: false;
    in property <bool> busy: false;
    in property <string> language: "ru";

    callback join-requested(string);
    callback retry-requested();
    callback chats-requested();

    public function begin-join() {
        if !root.invite-token.is-empty {
            root.join-requested(root.invite-token);
        }
    }

    background: Theme.background;

    VerticalLayout {
        padding: 24px;
        alignment: center;
        cross-axis-alignment: center;
        spacing: 10px;

        if !root.failed && !root.sync-failed : VerticalLayout {
            alignment: center;
            spacing: 12px;

            FHSpinner { size: 24px; tint: Theme.muted; }
            Text { text: root.language == "ru" ? "Присоединяемся…" : "Joining…"; color: Theme.muted; font-size: 14px; horizontal-alignment: center; }
        }

        if root.failed || root.sync-failed : VerticalLayout {
            alignment: center;
            spacing: 8px;

            IconUserRoundPlus { width: 32px; height: 32px; stroke: Theme.muted; }
            Text {
                text: root.sync-failed ? (root.language == "ru" ? "Вы вступили, но список чатов не обновился" : "You joined, but the chat list did not refresh") : (root.language == "ru" ? "Приглашение не сработало" : "The invitation did not work");
                color: Theme.foreground;
                font-size: 14px;
                font-weight: 500;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            Text {
                text: root.sync-failed ? (root.language == "ru" ? "Проверьте подключение и повторите загрузку чата перед открытием." : "Check your connection and retry loading the chat before opening it.") : (root.language == "ru" ? "Ссылка могла быть отозвана или уже использована." : "The link may have been revoked or already used.");
                color: Theme.muted;
                font-size: 12px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            FHSecondaryButton {
                block: true;
                text: root.sync-failed ? (root.language == "ru" ? "Повторить" : "Retry") : (root.language == "ru" ? "К списку чатов" : "Back to chats");
                enabled: !root.busy;
                busy: root.busy;
                clicked => {
                    if root.sync-failed { root.retry-requested(); }
                    else { root.chats-requested(); }
                }
            }
        }
    }
}
