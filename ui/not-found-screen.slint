import { Theme } from "theme.slint";
import { FHPrimaryButton } from "components.slint";
import { IconCompass } from "icons.slint";

export component NotFoundScreen inherits Rectangle {
    in property <string> language: "ru";

    callback home-requested();

    background: Theme.background;

    VerticalLayout {
        padding: 24px;
        alignment: center;
        cross-axis-alignment: center;
        spacing: 16px;

        IconCompass { width: 40px; height: 40px; stroke: Theme.accent; stroke-width: 1.5px; }
        Text { text: root.language == "ru" ? "Страница не найдена" : "Page not found"; color: Theme.foreground; font-size: 18px; font-weight: 600; horizontal-alignment: center; }
        Text { text: root.language == "ru" ? "Такого адреса не существует." : "This address does not exist."; color: Theme.muted; font-size: 14px; horizontal-alignment: center; wrap: word-wrap; }
        FHPrimaryButton { height: 44px; border-radius: 12px; text: root.language == "ru" ? "На главную" : "Go home"; clicked => { root.home-requested(); } }
    }
}
