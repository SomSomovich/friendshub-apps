import { Theme } from "../theme.slint";
import { FHEmptyState, FHIconButton, FHSecondaryButton, FHScreenHeader, FHSkeleton, FHPrimaryButton } from "../components.slint";
import { IconPhone, IconTrash2 } from "../icons.slint";
import { ScrollView } from "std-widgets.slint";

export struct CallHistoryRow {
    id: string,
    peer-account-id: string,
    peer-name: string,
    peer-initial: string,
    direction-status: string,
    started-at: string,
    duration: string,
    completed: bool,
}

export component CallHistoryScreen inherits Rectangle {
    in property <[CallHistoryRow]> calls: [];
    in property <bool> loading: false;
    in property <string> error-text: "";
    in property <bool> busy: false;
    in property <bool> has-calls: false;
    in-out property <bool> confirmation-open: false;
    in-out property <bool> confirm-clear-all: false;
    in-out property <string> confirm-call-id: "";

    callback back-requested();
    callback refresh-requested();
    callback clear-history-requested();
    callback profile-requested(string);
    callback audio-call-requested(string);
    callback delete-call-requested(string);
    callback retry-requested();

    background: Theme.background;

    VerticalLayout {
        spacing: 0px;

        FHScreenHeader {
            title: "Звонки";
            back-requested => { root.back-requested(); }
        }

        ScrollView {
            vertical-stretch: 1;
            content-width: parent.width;
            content-height: history-content.preferred-height + 32px;

            VerticalLayout {
                width: parent.width;
                padding: 16px;
                history-content := VerticalLayout {
                    width: min(parent.width - 32px, 576px);
                    x: (parent.width - self.width) / 2;
                    spacing: 12px;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;

                        FHSecondaryButton {
                            text: "Обновить";
                            height: 32px;
                            enabled: !root.busy && !root.loading;
                            busy: root.loading;
                            clicked => { root.refresh-requested(); }
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        FHSecondaryButton {
                            text: "Очистить историю";
                            height: 32px;
                            danger: true;
                            enabled: !root.busy && root.has-calls;
                            clicked => {
                                root.confirm-clear-all = true;
                                root.confirm-call-id = "";
                                root.confirmation-open = true;
                            }
                        }
                    }

                    Text {
                        text: "Последние 200 звонков.";
                        color: Theme.muted;
                        font-size: 12px;
                        wrap: word-wrap;
                    }

                    if !root.error-text.is-empty : Rectangle {
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.danger;
                        background: Theme.surface;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;
                            Text { text: root.error-text; color: Theme.danger; font-size: 14px; wrap: word-wrap; }
                            FHSecondaryButton { text: "Повторить"; height: 32px; clicked => { root.retry-requested(); } }
                        }
                    }
                    if root.error-text.is-empty && root.loading : VerticalLayout {
                        spacing: 8px;
                        for skeleton in 4 : Rectangle {
                            height: 84px;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: Theme.border;
                            background: Theme.surface;
                            HorizontalLayout {
                                padding: 12px;
                                spacing: 12px;
                                alignment: center;
                                FHSkeleton { width: 40px; height: 40px; corner-radius: 20px; }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 8px;
                                    FHSkeleton { width: 55%; height: 12px; }
                                    FHSkeleton { width: 72%; height: 10px; }
                                }
                            }
                        }
                    }
                    if root.error-text.is-empty && !root.loading && root.calls.length == 0 : FHEmptyState {
                        title: "Звонков пока нет";
                        description: "Здесь появятся входящие и исходящие звонки.";

                        IconPhone { width: 32px; height: 32px; stroke: Theme.muted; }
                    }
                    if root.error-text.is-empty && !root.loading && root.calls.length > 0 : VerticalLayout {
                        spacing: 8px;
                        for call[index] in root.calls : Rectangle {
                            height: 84px;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: Theme.border;
                            background: Theme.surface;

                            HorizontalLayout {
                                padding: 12px;
                                spacing: 8px;
                                cross-axis-alignment: center;

                                Rectangle {
                                    horizontal-stretch: 1;
                                    accessible-role: button;
                                    accessible-label: "Открыть профиль \{call.peer-name}";
                                    accessible-action-default => { root.profile-requested(call.peer-account-id); }
                                    forward-focus: profile-keyboard;

                                    HorizontalLayout {
                                        spacing: 12px;
                                        Rectangle {
                                            width: 40px;
                                            height: 40px;
                                            border-radius: 20px;
                                            background: Theme.hover;
                                            Text { text: call.peer-initial; color: Theme.muted; font-size: 16px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; }
                                        }
                                        VerticalLayout {
                                            spacing: 3px;
                                            horizontal-stretch: 1;
                                            Text { text: call.peer-name; color: Theme.foreground; font-size: 14px; overflow: elide; }
                                            Text { text: call.direction-status; color: Theme.muted; font-size: 12px; overflow: elide; }
                                            Text {
                                                text: call.completed && !call.duration.is-empty ? "\{call.started-at} · \{call.duration}" : call.started-at;
                                                color: Theme.muted;
                                                font-size: 12px;
                                                overflow: elide;
                                            }
                                        }
                                    }
                                    TouchArea { mouse-cursor: pointer; clicked => { root.profile-requested(call.peer-account-id); } }
                                    profile-keyboard := FocusScope {
                                        x: 0px;
                                        width: 0px;
                                        key-pressed(event) => {
                                            if event.text == Key.Space || event.text == Key.Return {
                                                root.profile-requested(call.peer-account-id);
                                                return accept;
                                            }
                                            return reject;
                                        }
                                    }
                                }

                                FHIconButton {
                                    button-size: 36px;
                                    label: "Позвонить \{call.peer-name}";
                                    enabled: !root.busy;
                                    clicked => { root.audio-call-requested(call.peer-account-id); }

                                    IconPhone { width: 18px; height: 18px; x: 9px; y: 9px; stroke: Theme.muted; }
                                }
                                FHIconButton {
                                    button-size: 36px;
                                    label: "Удалить запись";
                                    enabled: !root.busy;
                                    clicked => {
                                        root.confirm-clear-all = false;
                                        root.confirm-call-id = call.id;
                                        root.confirmation-open = true;
                                    }

                                    IconTrash2 { width: 18px; height: 18px; x: 9px; y: 9px; stroke: Theme.danger; }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if root.confirmation-open : Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: #00000080;
        TouchArea { width: 100%; height: 100%; }

        Rectangle {
            width: min(parent.width - 32px, 420px);
            height: confirmation-content.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.border;
            background: Theme.surface;

            confirmation-content := VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text {
                    text: root.confirm-clear-all ? "Очистить историю" : "Удалить запись";
                    color: Theme.foreground;
                    font-size: 16px;
                    font-weight: 600;
                }
                Text {
                    text: root.confirm-clear-all ? "Удалить все записи звонков этого аккаунта?" : "Удалить эту запись из вашей истории звонков?";
                    color: Theme.muted;
                    font-size: 14px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    FHSecondaryButton {
                        text: "Отмена";
                        height: 36px;
                        enabled: !root.busy;
                        clicked => { root.confirmation-open = false; }
                    }
                    FHPrimaryButton {
                        danger: true;
                        text: "Удалить";
                        enabled: !root.busy;
                        busy: root.busy;
                        clicked => {
                            if root.confirm-clear-all {
                                root.clear-history-requested();
                            } else {
                                root.delete-call-requested(root.confirm-call-id);
                            }
                        }
                    }
                }
            }
        }
    }
}
