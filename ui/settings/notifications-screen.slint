import { Theme } from "../theme.slint";
import { FHSecondaryButton } from "../components.slint";
import { SettingsCard, SettingsChoice, SettingsFrame, SettingsOption, SettingsToggle } from "common.slint";

export component NotificationsSettingsScreen inherits Rectangle {
    in property <string> language: "ru";
    in property <bool> sound-enabled: true;
    in property <string> sound-value: "chime";
    in property <[SettingsOption]> sound-options: [
        { value: "chime", label: root.language == "ru" ? "Перезвон" : "Chime" },
        { value: "ping", label: root.language == "ru" ? "Сигнал" : "Ping" },
        { value: "pop", label: root.language == "ru" ? "Щелчок" : "Pop" },
        { value: "none", label: root.language == "ru" ? "Без звука" : "Silent" },
    ];
    in property <string> os-permission: "prompt";
    in property <string> push-status: "";
    in property <bool> permission-request-supported: true;
    in property <bool> busy: false;

    callback back-requested();
    callback sound-enabled-changed(bool);
    callback sound-changed(string);
    callback preview-sound-requested(string);
    callback request-system-notification-permission();
    callback open-system-notification-settings();

    width: 100%;
    height: 100%;
    background: Theme.background;

    SettingsFrame {
        language: root.language;
        title: root.language == "ru" ? "Уведомления" : "Notifications";
        back-requested => { root.back-requested(); }

        SettingsCard {
            title: root.language == "ru" ? "Звук сообщений" : "Message sound";
            description: root.language == "ru" ? "Короткий сигнал при новом сообщении." : "A short tone when a message arrives.";

            SettingsToggle {
                label: root.language == "ru" ? "Включён" : "Enabled";
                checked: root.sound-enabled;
                enabled: !root.busy;
                changed(value) => {
                    root.sound-enabled-changed(value);
                    if value { root.preview-sound-requested(root.sound-value); }
                }
            }

            SettingsChoice {
                label: root.language == "ru" ? "Звук сообщений" : "Message sound";
                show-label: false;
                value: root.sound-value;
                options: root.sound-options;
                enabled: root.sound-enabled && !root.busy;
                changed(value) => {
                    root.sound-changed(value);
                    root.preview-sound-requested(value);
                }
            }

        }

        SettingsCard {
            title: root.language == "ru" ? "Системные уведомления" : "System notifications";
            description: root.language == "ru" ? "Разрешение ОС показывать уведомления вне приложения." : "The operating system's permission to show notifications outside the app.";

            Text {
                text: root.os-permission == "granted" ? (root.language == "ru" ? "Разрешено" : "Granted") :
                    root.os-permission == "denied" ? (root.language == "ru" ? "Запрещено — измените разрешение в настройках системы" : "Denied — change permission in system settings") :
                    root.os-permission == "unsupported" ? (root.language == "ru" ? "Системные уведомления недоступны на этой платформе" : "System notifications are unavailable on this platform") :
                    root.os-permission == "pending" ? (root.language == "ru" ? "Запрос отправлен — после ответа системы откройте раздел снова" : "Request sent — reopen this section after responding to the system prompt") :
                    (root.language == "ru" ? "Разрешение ещё не запрошено" : "Permission not requested yet");
                color: root.os-permission == "denied" ? Theme.danger : Theme.muted;
                font-size: 12px;
                wrap: word-wrap;
                width: 100%;
            }

            if !root.push-status.is-empty : Text {
                text: root.push-status;
                color: Theme.muted;
                font-size: 12px;
                wrap: word-wrap;
                width: 100%;
            }

            if root.os-permission == "prompt" : FHSecondaryButton {
                text: root.language == "ru" ? "Запросить разрешение" : "Request permission";
                enabled: root.permission-request-supported && !root.busy;
                busy: root.busy;
                clicked => { root.request-system-notification-permission(); }
            }
            if root.os-permission == "denied" : FHSecondaryButton {
                text: root.language == "ru" ? "Открыть настройки уведомлений" : "Open notification settings";
                enabled: !root.busy;
                clicked => { root.open-system-notification-settings(); }
            }
        }
    }
}
