import { Theme } from "../theme.slint";
import { FHBadge, FHIconButton, FHSecondaryButton, FHPrimaryButton } from "../components.slint";
import { IconUserMinus, IconUserPlus } from "../icons.slint";
import { SettingsCard, SettingsFrame } from "common.slint";

export struct SettingsAccount {
    id: string,
    username: string,
    fh-number: string,
    avatar: image,
    has-avatar: bool,
    pending-removal: bool,
}

component AccountRow inherits Rectangle {
    in property <string> language: "ru";
    in property <string> account-id;
    in property <string> username;
    in property <string> fh-number;
    in property <image> avatar;
    in property <bool> has-avatar: false;
    in property <bool> active: false;
    in property <bool> pending-removal: false;
    in property <bool> enabled: true;
    callback switch-account(string);
    callback remove-account(string);

    width: 100%;
    height: max(64px, content.preferred-height);
    background: Theme.background;
    border-width: 1px;
    border-color: root.active ? Theme.accent : Theme.border;
    border-radius: 8px;

    content := HorizontalLayout {
        padding: 10px;
        spacing: 10px;
        cross-axis-alignment: center;

        Rectangle {
            width: 40px;
            height: 40px;
            border-radius: 20px;
            background: Theme.hover;
            clip: true;

            if root.has-avatar : Image {
                width: 100%;
                height: 100%;
                source: root.avatar;
                image-fit: cover;
                accessible-role: none;
            }
            if !root.has-avatar : Text {
                text: "FH";
                color: Theme.muted;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
                accessible-role: none;
            }
        }

        VerticalLayout {
            spacing: 2px;
            horizontal-stretch: 1;
            min-width: 0px;

            Text {
                text: root.username;
                color: Theme.foreground;
                font-size: 14px;
                overflow: elide;
            }
            Text {
                text: root.fh-number;
                color: Theme.muted;
                font-size: 12px;
                overflow: elide;
            }
        }

        if root.active && !root.pending-removal : FHBadge {
            text: root.language == "ru" ? "активный" : "active";
        }

        if !root.active && !root.pending-removal : FHSecondaryButton {
            text: root.language == "ru" ? "Переключить" : "Switch";
            height: 32px;
            enabled: root.enabled;
            clicked => { root.switch-account(root.account-id); }
        }

        FHIconButton {
            button-size: 32px;
            label: root.pending-removal
                ? (root.language == "ru" ? "Повторить очистку" : "Retry cleanup")
                : (root.language == "ru" ? "Удалить" : "Remove");
            enabled: root.enabled;
            clicked => { root.remove-account(root.account-id); }

            IconUserMinus { width: 16px; height: 16px; x: 8px; y: 8px; stroke: Theme.muted; }
        }
    }
}

export component AccountsSettingsScreen inherits Rectangle {
    in property <string> language: "ru";
    in property <[SettingsAccount]> accounts: [];
    in property <string> active-account-id: "";
    in property <string> busy-account-id: "";
    in property <bool> busy: false;
    in property <string> error-text: "";

    callback back-requested();
    callback switch-account-requested(string);
    callback add-account-requested();
    callback remove-account-requested(string);
    callback retry-requested();

    private property <string> pending-remove-id: "";

    width: 100%;
    height: 100%;
    background: Theme.background;

    SettingsFrame {
        language: root.language;
        title: root.language == "ru" ? "Аккаунты" : "Accounts";
        back-requested => { root.back-requested(); }

        SettingsCard {
            title: root.language == "ru" ? "Аккаунты" : "Accounts";
            description: root.language == "ru" ? "До пяти аккаунтов на этом устройстве, полностью изолированных." : "Up to five fully isolated accounts on this device.";

            if !root.error-text.is-empty : Text {
                text: root.error-text;
                color: Theme.danger;
                font-size: 12px;
                wrap: word-wrap;
                width: 100%;
            }

            if root.accounts.length == 0 && root.error-text.is-empty : Text {
                text: root.language == "ru" ? "Пока ни одного аккаунта." : "No accounts yet.";
                color: Theme.muted;
                font-size: 12px;
            }

            for account in root.accounts : AccountRow {
                language: root.language;
                account-id: account.id;
                username: account.username;
                fh-number: account.fh-number;
                avatar: account.avatar;
                has-avatar: account.has-avatar;
                active: account.id == root.active-account-id;
                pending-removal: account.pending-removal;
                enabled: !root.busy && (root.busy-account-id.is-empty || root.busy-account-id == account.id);
                switch-account(id) => { root.switch-account-requested(id); }
                remove-account(id) => {
                    if account.pending-removal { root.remove-account-requested(id); }
                    else { root.pending-remove-id = id; }
                }
            }

            if !root.pending-remove-id.is-empty : Rectangle {
                width: 100%;
                height: confirm-content.preferred-height;
                background: Theme.hover;
                border-radius: 8px;

                confirm-content := VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    Text {
                        text: root.language == "ru" ? "Аккаунт выйдет из приложения, а его сообщения и ключи будут удалены с устройства. На сервере аккаунт останется." : "The account will be signed out and its messages and keys removed from this device. The account will remain on the server.";
                        color: Theme.foreground;
                        font-size: 12px;
                        wrap: word-wrap;
                        width: 100%;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        FHPrimaryButton {
                            danger: true;
                            text: root.language == "ru" ? "Удалить аккаунт" : "Remove account";
                            enabled: !root.busy;
                            busy: root.busy;
                            clicked => {
                                root.remove-account-requested(root.pending-remove-id);
                                root.pending-remove-id = "";
                            }
                        }
                        FHSecondaryButton {
                            text: root.language == "ru" ? "Отмена" : "Cancel";
                            height: 40px;
                            enabled: !root.busy;
                            clicked => { root.pending-remove-id = ""; }
                        }
                    }
                }
            }

            if root.accounts.length < 5 : FHSecondaryButton {
                text: root.language == "ru" ? "Добавить аккаунт" : "Add account";
                enabled: !root.busy;
                clicked => { root.add-account-requested(); }
            }

            if !root.error-text.is-empty : FHSecondaryButton {
                text: root.language == "ru" ? "Повторить загрузку" : "Retry loading";
                height: 32px;
                clicked => { root.retry-requested(); }
            }
        }
    }
}
