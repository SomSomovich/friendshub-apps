import { Theme } from "../theme.slint";
import { FHBadge, FHInput, FHSecondaryButton, FHPrimaryButton } from "../components.slint";
import { SettingsCard, SettingsChoice, SettingsDivider, SettingsFrame, SettingsOption } from "common.slint";

export struct SecuritySession {
    id: string,
    ip-address: string,
    user-agent: string,
    signed-in-at: string,
    is-current: bool,
}

export struct SecurityDevice {
    id: string,
    name: string,
    number: int,
    added-at: string,
    is-current: bool,
    can-revoke: bool,
}

export struct SecurityEvent {
    id: string,
    event-type: string,
    created-at: string,
    detail: string,
}

component SecurityInfoRow inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <string> badge: "";
    in property <string> action-label: "";
    in property <string> item-id;
    in property <bool> action-enabled: true;
    callback action(string);

    width: 100%;
    height: max(56px, content.preferred-height);
    background: Theme.background;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 8px;

    content := HorizontalLayout {
        padding: 10px;
        spacing: 8px;
        cross-axis-alignment: center;

        VerticalLayout {
            spacing: 3px;
            horizontal-stretch: 1;
            vertical-stretch: 0;

            HorizontalLayout {
                spacing: 8px;
                alignment: start;

                Text {
                    text: root.title;
                    color: Theme.foreground;
                    font-size: 13px;
                    font-weight: 500;
                    horizontal-stretch: 1;
                    horizontal-alignment: left;
                    wrap: word-wrap;
                }

                if !root.badge.is-empty : FHBadge {
                    text: root.badge;
                    soft: true;
                }
            }

            Text {
                text: root.detail;
                color: Theme.muted;
                font-size: 11px;
                width: 100%;
                horizontal-alignment: left;
                wrap: word-wrap;
            }
        }

        if !root.action-label.is-empty : FHSecondaryButton {
                height: 32px;
            text: root.action-label;
            enabled: root.action-enabled;
            clicked => { root.action(root.item-id); }}
    }
}

export component SecuritySettingsScreen inherits Rectangle {
    in property <string> language: "ru";
    in property <bool> totp-enabled: false;
    in property <[SecuritySession]> sessions: [];
    in property <[SecurityDevice]> devices: [];
    in property <[SettingsOption]> history-source-options: [];
    in property <string> history-source-device: "";
    in property <string> history-progress: "";
    in property <[SettingsOption]> history-conversation-options: [];
    in property <string> history-conversation-id: "";
    in property <string> history-page-result: "";
    in property <bool> has-older-history: false;
    in property <string> device-policy-hint: "";
    in property <[SecurityEvent]> events: [];
    in property <string> session-error: "";
    in property <string> device-error: "";
    in property <string> history-error: "";
    in property <string> events-error: "";
    in property <bool> busy: false;

    callback back-requested();
    callback open-two-factor-requested();
    callback revoke-session-requested(string);
    callback revoke-all-sessions-requested();
    callback revoke-device-requested(string);
    callback request-history-sync-requested(string);
    callback load-device-history-requested(string, bool);
    callback refresh-sessions-requested();
    callback refresh-devices-requested();
    callback refresh-events-requested();
    callback select-history-source(string);
    callback select-history-conversation(string);

    private property <string> pending-session-id: "";
    private property <string> pending-device-id: "";
    private property <bool> confirm-all-open: false;

    width: 100%;
    height: 100%;
    background: Theme.background;

    SettingsFrame {
        language: root.language;
        title: (root.language == "ru" ? "Безопасность" : "Security");
        back-requested => { root.back-requested(); }

        SettingsCard { title: (root.language == "ru" ? "Вход в аккаунт" : "Signing in");
            SecurityInfoRow {
                title: (root.language == "ru" ? "Двухфакторная аутентификация" : "Two-factor authentication");
                detail: root.totp-enabled ? (root.language == "ru" ? "2FA включена" : "2FA is on") : (root.language == "ru" ? "2FA выключена" : "2FA is off");
                badge: root.totp-enabled ? (root.language == "ru" ? "Включена" : "Enabled") : (root.language == "ru" ? "Выключена" : "Disabled");
                action-label: (root.language == "ru" ? "Настроить" : "Configure");
                item-id: "totp";
                action(id) => { root.open-two-factor-requested(); }
            }
        }

        SettingsCard {
            title: (root.language == "ru" ? "Активные сессии" : "Active sessions");
            description: (root.language == "ru" ? "Каждое устройство, вошедшее в аккаунт, держит сессию." : "Every device signed into the account holds one.");

            if !root.session-error.is-empty : Text {
                text: root.session-error;
                color: Theme.danger;
                font-size: 12px;
                wrap: word-wrap;
                width: 100%;
            }

            if root.sessions.length == 0 && root.session-error.is-empty : Text {
                text: (root.language == "ru" ? "Нет загруженных сессий." : "No sessions loaded.");
                color: Theme.muted;
                font-size: 12px;
            }

            for session in root.sessions : SecurityInfoRow {
                title: session.ip-address;
                detail: (root.language == "ru" ? "\{session.user-agent} · Вход: \{session.signed-in-at}" : "\{session.user-agent} · Signed in: \{session.signed-in-at}");
                badge: session.is-current ? (root.language == "ru" ? "текущая" : "current") : "";
                action-label: (root.language == "ru" ? "Завершить" : "End");
                item-id: session.id;
                action-enabled: !root.busy;
                action(id) => { root.pending-session-id = id; }
            }

            if !root.pending-session-id.is-empty : Rectangle {
                width: 100%;
                height: confirm-session-content.preferred-height;
                background: Theme.hover;
                border-radius: 8px;
                confirm-session-content := VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    Text {
                        text: (root.language == "ru" ? "Завершить выбранную сессию? При выборе текущей сессии потребуется повторный вход." : "End the selected session? If it is the current session, you will need to sign in again.");
                        color: Theme.foreground;
                        font-size: 12px;
                        wrap: word-wrap;
                        width: 100%;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        FHPrimaryButton {
                            danger: true;
                            text: (root.language == "ru" ? "Завершить" : "End");
                            enabled: !root.busy;
                            busy: root.busy;
                            clicked => {
                                root.revoke-session-requested(root.pending-session-id);
                                root.pending-session-id = "";
                            }
                        }
                        FHSecondaryButton {
                height: 32px;
                            text: (root.language == "ru" ? "Отмена" : "Cancel");
                            enabled: !root.busy;
                            clicked => { root.pending-session-id = ""; }}
                    }
                }
            }

            SettingsDivider {}

            if !root.confirm-all-open : FHSecondaryButton {
                height: 32px;
                text: (root.language == "ru" ? "Завершить все сессии" : "End every session");
                enabled: !root.busy;
                clicked => { root.confirm-all-open = true; }}
            if root.confirm-all-open : Rectangle {
                width: 100%;
                height: confirm-all-content.preferred-height;
                background: Theme.hover;
                border-radius: 8px;
                confirm-all-content := VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    Text {
                        text: (root.language == "ru" ? "Все сессии будут завершены, включая текущую: придётся войти заново." : "Every session ends, including this one: you will have to sign in again.");
                        color: Theme.foreground;
                        font-size: 12px;
                        wrap: word-wrap;
                        width: 100%;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        FHPrimaryButton {
                            danger: true;
                            text: (root.language == "ru" ? "Завершить все" : "End all");
                            enabled: !root.busy;
                            busy: root.busy;
                            clicked => {
                                root.revoke-all-sessions-requested();
                                root.confirm-all-open = false;
                            }
                        }
                        FHSecondaryButton {
                height: 32px;
                            text: (root.language == "ru" ? "Отмена" : "Cancel");
                            enabled: !root.busy;
                            clicked => { root.confirm-all-open = false; }}
                    }
                }
            }

            if !root.session-error.is-empty : FHSecondaryButton {
                height: 32px;
                text: (root.language == "ru" ? "Повторить загрузку" : "Retry loading");
                clicked => { root.refresh-sessions-requested(); }}
        }

        SettingsCard {
            title: (root.language == "ru" ? "Устройства" : "Devices");
            description: (root.language == "ru" ? "Устройства аккаунта, которые получают ваши сообщения." : "The account's devices, which receive your messages.");

            if !root.device-error.is-empty : Text {
                text: root.device-error;
                color: Theme.danger;
                font-size: 12px;
                wrap: word-wrap;
                width: 100%;
            }

            if root.devices.length == 0 && root.device-error.is-empty : Text {
                text: (root.language == "ru" ? "Нет загруженных устройств." : "No devices loaded.");
                color: Theme.muted;
                font-size: 12px;
            }

            for device in root.devices : SecurityInfoRow {
                title: "\{device.name} · №\{device.number}";
                detail: (root.language == "ru" ? "Добавлено: \{device.added-at}" : "Added: \{device.added-at}");
                badge: device.is-current ? (root.language == "ru" ? "это устройство" : "this device") : "";
                action-label: (root.language == "ru" ? "Отозвать" : "Revoke");
                item-id: device.id;
                action-enabled: device.can-revoke && !root.busy;
                action(id) => { root.pending-device-id = id; }
            }

            if !root.device-policy-hint.is-empty : Text {
                text: root.device-policy-hint;
                color: Theme.muted;
                font-size: 12px;
                wrap: word-wrap;
                width: 100%;
            }

            if !root.pending-device-id.is-empty : Rectangle {
                width: 100%;
                height: confirm-device-content.preferred-height;
                background: Theme.hover;
                border-radius: 8px;
                confirm-device-content := VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    Text {
                        text: (root.language == "ru" ? "Устройство перестанет получать сообщения, а его сессии станут недействительны. Отзыв текущего устройства потребует повторного входа." : "The device will stop receiving messages and its sessions will become invalid. Revoking the current device will require signing in again.");
                        color: Theme.foreground;
                        font-size: 12px;
                        wrap: word-wrap;
                        width: 100%;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        FHPrimaryButton {
                            danger: true;
                            text: (root.language == "ru" ? "Отозвать устройство" : "Revoke device");
                            enabled: !root.busy;
                            busy: root.busy;
                            clicked => {
                                root.revoke-device-requested(root.pending-device-id);
                                root.pending-device-id = "";
                            }
                        }
                        FHSecondaryButton {
                height: 32px;
                            text: (root.language == "ru" ? "Отмена" : "Cancel");
                            enabled: !root.busy;
                            clicked => { root.pending-device-id = ""; }}
                    }
                }
            }

            if !root.device-error.is-empty : FHSecondaryButton {
                height: 32px;
                text: (root.language == "ru" ? "Повторить загрузку" : "Retry loading");
                clicked => { root.refresh-devices-requested(); }}
        }

        SettingsCard {
            title: (root.language == "ru" ? "Синхронизация истории" : "History synchronization");
            description: (root.language == "ru" ? "Выберите другое своё устройство, на котором сохранилась история, и оставьте его онлайн. Сообщения и ключи вложений будут переданы с шифрованием. Публикации каналов и боты загружаются с сервера отдельно." : "Select another of your devices that still has the history and leave it online. Messages and attachment keys will be transferred encrypted. Channel posts and bots are loaded separately from the server.");

            SettingsChoice {
                label: (root.language == "ru" ? "Устройство-источник" : "Source device");
                value: root.history-source-device;
                options: root.history-source-options;
                enabled: !root.busy;
                changed(value) => {
                    root.select-history-source(value);
                }
            }

            FHPrimaryButton {
                text: (root.language == "ru" ? "Запросить историю" : "Request history");
                enabled: !root.busy && !root.history-source-device.is-empty && root.history-error.is-empty;
                busy: root.busy;
                clicked => { root.request-history-sync-requested(root.history-source-device); }
            }

            if !root.history-error.is-empty : Text {
                text: root.history-error;
                color: Theme.danger;
                font-size: 12px;
                wrap: word-wrap;
                width: 100%;
            }

            if !root.history-progress.is-empty : Text {
                text: root.history-progress;
                color: Theme.muted;
                font-size: 12px;
                wrap: word-wrap;
                width: 100%;
            }
        }

        SettingsCard {
            title: (root.language == "ru" ? "История на этом устройстве" : "History on this device");
            description: (root.language == "ru" ? "Загрузить с сервера доступные сообщения для этого устройства, если сохранились подходящие ключи. Основной способ переноса истории — с другого своего устройства." : "Load available messages from the server for this device if the required keys are still available. The primary way to transfer history is from another of your devices.");

            Text {
                text: (root.language == "ru" ? "Новое устройство не расшифрует старую сессию. История старше серверного TTL доступна только на прежнем устройстве. После потери всех устройств и ключей полное восстановление без резервной копии невозможно. Здесь загружаются тексты и ключи вложений; актуальные правки и удаления переносите с другого устройства." : "A new device cannot decrypt an old session. History older than the server TTL is available only on the previous device. If all devices and keys are lost, a full recovery is impossible without a backup. This loads message text and attachment keys; transfer current edits and deletions from another device.");
                color: Theme.muted;
                font-size: 12px;
                wrap: word-wrap;
                width: 100%;
            }

            SettingsChoice {
                label: (root.language == "ru" ? "Беседа" : "Conversation");
                value: root.history-conversation-id;
                options: root.history-conversation-options;
                enabled: !root.busy;
                changed(value) => { root.select-history-conversation(value); }
            }

            HorizontalLayout {
                spacing: 8px;
                FHPrimaryButton {
                    text: (root.language == "ru" ? "Загрузить историю" : "Load history");
                    enabled: !root.busy && !root.history-conversation-id.is-empty;
                    busy: root.busy;
                    clicked => { root.load-device-history-requested(root.history-conversation-id, false); }
                }
                FHSecondaryButton {
                height: 32px;
                    text: (root.language == "ru" ? "Загрузить более ранние" : "Load earlier messages");
                    enabled: !root.busy && !root.history-conversation-id.is-empty && root.has-older-history;
                    clicked => { root.load-device-history-requested(root.history-conversation-id, true); }}
            }

            if !root.history-page-result.is-empty : Text {
                text: root.history-page-result;
                color: Theme.muted;
                font-size: 12px;
                wrap: word-wrap;
                width: 100%;
            }
        }

        SettingsCard {
            title: (root.language == "ru" ? "Журнал безопасности" : "Security log");
            description: (root.language == "ru" ? "Последние 100 событий аккаунта." : "The latest 100 account events.");

            if !root.events-error.is-empty : Text {
                text: root.events-error;
                color: Theme.danger;
                font-size: 12px;
                wrap: word-wrap;
                width: 100%;
            }

            if root.events.length == 0 && root.events-error.is-empty : Text {
                text: (root.language == "ru" ? "Событий пока нет." : "No events yet.");
                color: Theme.muted;
                font-size: 12px;
            }

            for event in root.events : SecurityInfoRow {
                title: event.event-type;
                detail: "\{event.created-at}\n\{event.detail}";
            }

            FHSecondaryButton {
                height: 32px;
                text: root.events-error.is-empty ? (root.language == "ru" ? "Обновить журнал" : "Refresh log") : (root.language == "ru" ? "Повторить загрузку" : "Retry loading");
                enabled: !root.busy;
                clicked => { root.refresh-events-requested(); }}
        }
    }
}

export component TwoFactorSetupScreen inherits Rectangle {
    in property <string> language: "ru";
    in property <bool> enabled: false;
    in property <bool> enrollment-started: false;
    in property <bool> has-qr-image: false;
    in property <image> qr-image;
    in property <string> secret-base32: "";
    in property <string> otpauth-uri: "";
    in property <string> error-text: "";
    in property <[string]> backup-codes: [];
    in property <bool> show-backup-codes: false;
    in property <bool> busy: false;
    in-out property <string> verify-code: "";
    in-out property <string> disable-password: "";
    in-out property <string> disable-code: "";

    callback back-requested();
    callback start-enrollment-requested();
    callback copy-otpauth-uri-requested(string);
    callback verify-enrollment-requested(string);
    callback copy-backup-codes-requested([string]);
    callback dismiss-backup-codes-requested();
    callback disable-requested(string, string);

    width: 100%;
    height: 100%;
    background: Theme.background;

    SettingsFrame {
        language: root.language;
        title: (root.language == "ru" ? "Двухфакторная аутентификация" : "Two-factor authentication");
        back-requested => { root.back-requested(); }

        SettingsCard {
            title: (root.language == "ru" ? "Двухфакторная аутентификация" : "Two-factor authentication");
            description: root.enabled
                ? (root.language == "ru" ? "2FA включена. Для отключения нужны пароль и текущий код." : "2FA is on. Turning it off needs your password and a current code.")
                : (root.language == "ru" ? "Дополнительный код из приложения-аутентификатора при входе." : "An extra code from your authenticator app when signing in.");

            if !root.error-text.is-empty : Text {
                text: root.error-text;
                color: Theme.danger;
                font-size: 12px;
                wrap: word-wrap;
                width: 100%;
            }

            if root.show-backup-codes : VerticalLayout {
                spacing: 10px;

                Text {
                    text: (root.language == "ru" ? "Резервные коды показываются один раз — сохраните их сразу." : "Backup codes are shown once — save them right away.");
                    color: Theme.danger;
                    font-size: 12px;
                    wrap: word-wrap;
                    width: 100%;
                }

                for code in root.backup-codes : Rectangle {
                    width: 100%;
                    height: 36px;
                    background: Theme.background;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: 6px;
                    Text {
                        text: code;
                        color: Theme.foreground;
                        font-size: 14px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }

                FHSecondaryButton {
                height: 32px;
                    text: (root.language == "ru" ? "Скопировать все коды" : "Copy all codes");
                    clicked => { root.copy-backup-codes-requested(root.backup-codes); }}

                FHPrimaryButton {
                    text: (root.language == "ru" ? "Я сохранил коды" : "I have saved the codes");
                    enabled: !root.busy;
                    clicked => { root.dismiss-backup-codes-requested(); }
                }
            }
            if !root.show-backup-codes && root.enabled : VerticalLayout {
                spacing: 10px;

                Text {
                    text: (root.language == "ru" ? "2FA включена" : "2FA is on");
                    color: Theme.accent;
                    font-size: 14px;
                    font-weight: 600;
                }

                FHInput {
                    language: root.language;
                    label: (root.language == "ru" ? "Пароль" : "Password");
                    password: true;
                    value <=> root.disable-password;
                }
                FHInput {
                    language: root.language;
                    label: (root.language == "ru" ? "Код из приложения или резервный код" : "Code from the app or a backup code");
                    placeholder: (root.language == "ru" ? "Код" : "Code");
                    value <=> root.disable-code;
                }

                FHPrimaryButton {
                    text: (root.language == "ru" ? "Выключить 2FA" : "Turn off 2FA");
                    enabled: !root.busy && !root.disable-password.is-empty && !root.disable-code.is-empty;
                    busy: root.busy;
                    clicked => { root.disable-requested(root.disable-password, root.disable-code); }
                }
            }
            if !root.show-backup-codes && !root.enabled && root.enrollment-started : VerticalLayout {
                spacing: 10px;

                Text {
                    text: (root.language == "ru" ? "Отсканируйте код или введите ключ вручную, затем подтвердите кодом из приложения." : "Scan the code or type the key in by hand, then confirm with a code from the app.");
                    color: Theme.muted;
                    font-size: 12px;
                    wrap: word-wrap;
                    width: 100%;
                }

                if root.has-qr-image : Rectangle {
                    width: 196px;
                    height: 196px;
                    background: #ffffff;
                    border-radius: 8px;
                    Image {
                        x: 10px;
                        y: 10px;
                        width: 176px;
                        height: 176px;
                        source: root.qr-image;
                    }
                }

                Text {
                    text: (root.language == "ru" ? "Ключ для ручного ввода" : "Key for manual entry");
                    color: Theme.muted;
                    font-size: 12px;
                }
                Text {
                    text: root.secret-base32;
                    color: Theme.foreground;
                    font-size: 14px;
                    font-weight: 600;
                    wrap: word-wrap;
                    width: 100%;
                }
                FHSecondaryButton {
                height: 32px;
                    text: (root.language == "ru" ? "Скопировать ссылку otpauth" : "Copy the otpauth link");
                    clicked => { root.copy-otpauth-uri-requested(root.otpauth-uri); }}

                FHInput {
                    language: root.language;
                    label: (root.language == "ru" ? "Код из приложения" : "Code from the app");
                    placeholder: "123456";
                    value <=> root.verify-code;
                    helper: (root.language == "ru" ? "Код из приложения после добавления ключа." : "The code from your app after adding the key.");
                }

                FHPrimaryButton {
                    text: (root.language == "ru" ? "Подтвердить и включить" : "Confirm and enable");
                    enabled: !root.busy && !root.verify-code.is-empty;
                    busy: root.busy;
                    clicked => { root.verify-enrollment-requested(root.verify-code); }
                }
            }
            if !root.show-backup-codes && !root.enabled && !root.enrollment-started : FHPrimaryButton {
                text: (root.language == "ru" ? "Включить 2FA" : "Turn on 2FA");
                enabled: !root.busy;
                busy: root.busy;
                clicked => { root.start-enrollment-requested(); }
            }
        }
    }
}
