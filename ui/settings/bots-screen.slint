import { Theme } from "../theme.slint";
import { FHIconButton, FHInput, FHSecondaryButton, FHSkeleton, FHPrimaryButton } from "../components.slint";
import { IconKeyRound, IconTrash2 } from "../icons.slint";
import { SettingsCard, SettingsFrame } from "common.slint";

export struct SettingsBot {
    id: string,
    handle: string,
    token-prefix: string,
}

component ManagedBotRow inherits Rectangle {
    in property <string> language: "ru";
    in property <string> bot-id;
    in property <string> handle;
    in property <string> token-prefix;
    in property <bool> busy: false;
    private property <string> draft-handle: "";
    private property <bool> confirm-rotate: false;
    private property <bool> confirm-delete: false;

    callback set-handle-requested(string, string);
    callback rotate-token-requested(string);
    callback delete-requested(string);

    width: 100%;
    height: content.preferred-height;
    background: Theme.background;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 8px;

    init => { root.draft-handle = root.handle; }

    content := VerticalLayout {
        padding: 12px;
        spacing: 10px;

        HorizontalLayout {
            spacing: 6px;
            cross-axis-alignment: center;

            Text {
                text: root.handle.is-empty ? (root.language == "ru" ? "Бот без адреса" : "Bot without a handle") : "@\{root.handle}";
                color: Theme.foreground;
                font-size: 14px;
                font-weight: 500;
                horizontal-stretch: 1;
                horizontal-alignment: left;
                overflow: elide;
            }

            FHIconButton {
                button-size: 32px;
                label: root.language == "ru" ? "Перевыпустить токен" : "Rotate token";
                enabled: !root.busy;
                clicked => { root.confirm-rotate = true; }

                IconKeyRound { width: 16px; height: 16px; x: 8px; y: 8px; stroke: Theme.muted; }
            }

            FHIconButton {
                button-size: 32px;
                label: root.language == "ru" ? "Удалить бота" : "Delete bot";
                enabled: !root.busy;
                clicked => { root.confirm-delete = true; }

                IconTrash2 { width: 16px; height: 16px; x: 8px; y: 8px; stroke: Theme.danger; }
            }
        }

        Text {
            text: root.language == "ru" ? "Префикс токена: \{root.token-prefix}" : "Token prefix: \{root.token-prefix}";
            color: Theme.muted;
            font-size: 12px;
            wrap: word-wrap;
            width: 100%;
        }

        HorizontalLayout {
            spacing: 8px;
            FHInput {
                language: root.language;
                label: root.language == "ru" ? "Адрес бота" : "Bot handle";
                placeholder: "my_example_bot";
                value <=> root.draft-handle;
            }
            FHSecondaryButton {
                text: root.language == "ru" ? "Сохранить" : "Save";
                height: 40px;
                enabled: !root.busy;
                busy: root.busy;
                clicked => { root.set-handle-requested(root.bot-id, root.draft-handle); }
            }
        }

        if root.confirm-rotate : Rectangle {
            width: 100%;
            height: rotate-content.preferred-height;
            background: Theme.hover;
            border-radius: 8px;
            rotate-content := VerticalLayout {
                padding: 10px;
                spacing: 8px;
                Text {
                    text: root.language == "ru" ? "Прежний токен перестанет работать. Подключённое приложение нужно будет обновить новым токеном." : "The previous token will stop working. Update your connected application with the new token.";
                    color: Theme.foreground;
                    font-size: 12px;
                    wrap: word-wrap;
                    width: 100%;
                }
                HorizontalLayout {
                    spacing: 8px;
                    FHPrimaryButton {
                        text: root.language == "ru" ? "Перевыпустить токен" : "Rotate token";
                        enabled: !root.busy;
                        busy: root.busy;
                        clicked => {
                            root.rotate-token-requested(root.bot-id);
                            root.confirm-rotate = false;
                        }
                    }
                    FHSecondaryButton {
                height: 32px;
                        text: root.language == "ru" ? "Отмена" : "Cancel";
                        enabled: !root.busy;
                        clicked => { root.confirm-rotate = false; }}
                }
            }
        }

        if root.confirm-delete : Rectangle {
            width: 100%;
            height: delete-content.preferred-height;
            background: Theme.hover;
            border-radius: 8px;
            delete-content := VerticalLayout {
                padding: 10px;
                spacing: 8px;
                Text {
                    text: root.language == "ru" ? "Бот будет удалён и перестанет работать. Это действие нельзя отменить." : "The bot will be deleted and stop working. This cannot be undone.";
                    color: Theme.foreground;
                    font-size: 12px;
                    wrap: word-wrap;
                    width: 100%;
                }
                HorizontalLayout {
                    spacing: 8px;
                    FHPrimaryButton {
                        danger: true;
                        text: root.language == "ru" ? "Удалить бота" : "Delete bot";
                        enabled: !root.busy;
                        busy: root.busy;
                        clicked => {
                            root.delete-requested(root.bot-id);
                            root.confirm-delete = false;
                        }
                    }
                    FHSecondaryButton {
                height: 32px;
                        text: root.language == "ru" ? "Отмена" : "Cancel";
                        enabled: !root.busy;
                        clicked => { root.confirm-delete = false; }}
                }
            }
        }
    }
}

export component BotsSettingsScreen inherits Rectangle {
    in property <string> language: "ru";
    in property <[SettingsBot]> bots: [];
    in property <bool> loading: false;
    in property <bool> can-create: true;
    in property <bool> busy: false;
    in property <string> error-text: "";
    in-out property <string> token-secret: "";

    callback back-requested();
    callback create-bot-requested();
    callback set-bot-handle-requested(string, string);
    callback rotate-bot-token-requested(string);
    callback delete-bot-requested(string);
    callback copy-token-requested(string);
    callback close-token-requested();
    callback retry-requested();

    in-out property <bool> token-revealed: false;

    width: 100%;
    height: 100%;
    background: Theme.background;

    SettingsFrame {
        language: root.language;
        title: root.language == "ru" ? "Мои боты" : "My bots";
        back-requested => { root.back-requested(); }

        SettingsCard {
            title: root.language == "ru" ? "Мои боты" : "My bots";
            description: root.language == "ru" ? "До 20 ботов на аккаунт. Для работы бота подключите его токен в своём приложении." : "Up to 20 bots per account. Connect a bot token to your application to run it.";

            if !root.error-text.is-empty : Text {
                text: root.error-text;
                color: Theme.danger;
                font-size: 12px;
                wrap: word-wrap;
                width: 100%;
            }

            FHPrimaryButton {
                text: root.language == "ru" ? "Создать бота" : "Create bot";
                enabled: root.can-create && !root.loading && !root.busy;
                busy: root.busy;
                clicked => { root.create-bot-requested(); }
            }

            if root.loading : VerticalLayout {
                spacing: 8px;
                FHSkeleton { width: 100%; height: 96px; corner-radius: 8px; }
                FHSkeleton { width: 100%; height: 96px; corner-radius: 8px; }
            }
            if !root.loading && root.bots.length == 0 && root.error-text.is-empty : Text {
                text: root.language == "ru" ? "У вас пока нет ботов." : "You have no bots yet.";
                color: Theme.muted;
                font-size: 12px;
            }

            for bot in root.bots : ManagedBotRow {
                language: root.language;
                bot-id: bot.id;
                handle: bot.handle;
                token-prefix: bot.token-prefix;
                busy: root.busy;
                set-handle-requested(id, value) => { root.set-bot-handle-requested(id, value); }
                rotate-token-requested(id) => { root.rotate-bot-token-requested(id); }
                delete-requested(id) => { root.delete-bot-requested(id); }
            }

            if !root.error-text.is-empty : FHSecondaryButton {
                height: 32px;
                text: root.language == "ru" ? "Повторить загрузку" : "Retry loading";
                clicked => { root.retry-requested(); }}
        }

        if !root.token-secret.is-empty : SettingsCard {
            title: root.language == "ru" ? "Токен бота" : "Bot token";
            description: root.language == "ru" ? "Скопируйте токен сейчас: после закрытия его нельзя будет посмотреть снова. Не передавайте его посторонним." : "Copy this token now: you cannot view it again after closing. Keep it private.";

            FHInput {
                language: root.language;
                label: root.language == "ru" ? "Токен бота" : "Bot token";
                value <=> root.token-secret;
                password: true;
                password-visible <=> root.token-revealed;
            }

            HorizontalLayout {
                spacing: 8px;
                FHSecondaryButton {
                height: 32px;
                    text: root.language == "ru" ? "Копировать" : "Copy";
                    clicked => { root.copy-token-requested(root.token-secret); }}
                FHPrimaryButton {
                    text: root.language == "ru" ? "Закрыть" : "Close";
                    clicked => {
                        root.token-secret = "";
                        root.token-revealed = false;
                        root.close-token-requested();
                    }
                }
            }
        }
    }
}
