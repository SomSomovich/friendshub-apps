import { ColorPickerDialog } from "color-picker-dialog.slint";
import { Theme } from "../theme.slint";
import { FHSecondaryButton, FHPrimaryButton } from "../components.slint";
import { SettingsCard, SettingsDivider, SettingsFrame, SettingsChoice } from "common.slint";

component RgbChannelField inherits VerticalLayout {
    in property <string> label;
    in property <string> accessible-name;
    in-out property <string> value;
    in property <bool> enabled: true;
    callback value-edited(string);

    spacing: 6px;
    horizontal-stretch: 1;

    Text {
        text: root.label;
        color: Theme.muted;
        font-size: 12px;
        font-weight: 600;
        accessible-role: none;
    }
    Rectangle {
        width: 100%;
        height: 40px;
        background: Theme.surface;
        border-width: 1px;
        border-radius: 8px;
        border-color: input.has-focus ? Theme.accent : Theme.border;
        clip: true;
        input := TextInput {
            x: 12px;
            width: max(parent.width - 24px, self.preferred-width);
            height: parent.height;
            text <=> root.value;
            enabled: root.enabled;
            font-size: 14px;
            color: Theme.foreground;
            vertical-alignment: center;
            accessible-label: root.accessible-name;
            edited => { root.value-edited(root.value); }
            cursor-position-changed(position) => {
                if position.x + self.x < 12px {
                    self.x = 12px - position.x;
                } else if position.x + self.x > parent.width - 12px - self.text-cursor-width {
                    self.x = parent.width - position.x - 12px - self.text-cursor-width;
                }
            }
        }
    }
}

component RgbColorField inherits VerticalLayout {
    in property <string> id;
    in property <string> language: "ru";
    in property <string> label;
    in property <color> preview;
    in-out property <string> red;
    in-out property <string> green;
    in-out property <string> blue;
    in property <bool> enabled: true;
    callback channel-edited(string, string);
    callback choose-color(string);

    spacing: 8px;
    horizontal-stretch: 1;

    HorizontalLayout {
        spacing: 8px;
        cross-axis-alignment: center;

        Rectangle {
            width: 28px;
            height: 28px;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.border;
            background: root.preview;
        }

        Text {
            text: root.label;
            color: Theme.foreground;
            font-size: 13px;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }

        FHSecondaryButton {
            text: (root.language == "ru" ? "Выбрать цвет" : "Choose color");
            height: 28px;
            enabled: root.enabled;
            clicked => { root.choose-color(root.id); }
        }
    }

    HorizontalLayout {
        spacing: 8px;

        RgbChannelField {
            label: "R";
            accessible-name: "\{root.label} RGB R";
            value <=> root.red;
            enabled: root.enabled;
            value-edited(value) => { root.channel-edited("\{root.id}.r", value); }
        }
        RgbChannelField {
            label: "G";
            accessible-name: "\{root.label} RGB G";
            value <=> root.green;
            enabled: root.enabled;
            value-edited(value) => { root.channel-edited("\{root.id}.g", value); }
        }
        RgbChannelField {
            label: "B";
            accessible-name: "\{root.label} RGB B";
            value <=> root.blue;
            enabled: root.enabled;
            value-edited(value) => { root.channel-edited("\{root.id}.b", value); }
        }
    }
}

export component AppearanceSettingsScreen inherits Rectangle {
    in property <string> theme-value: "dark";
    in property <string> language-value: "ru";
    in property <bool> has-custom-colors: false;
    in-out property <string> background-r: "26";
    in-out property <string> background-g: "26";
    in-out property <string> background-b: "58";
    in-out property <string> button-r: "252";
    in-out property <string> button-g: "144";
    in-out property <string> button-b: "3";
    in-out property <string> bubble-r: "36";
    in-out property <string> bubble-g: "36";
    in-out property <string> bubble-b: "77";
    in-out property <string> text-r: "244";
    in-out property <string> text-g: "244";
    in-out property <string> text-b: "251";
    in property <color> background-preview: Theme.background;
    in property <color> button-preview: Theme.accent;
    in property <color> bubble-preview: Theme.surface;
    in property <color> text-preview: Theme.foreground;
    in property <int> contrast-score: 218;
    in property <bool> busy: false;

    callback back-requested();
    callback theme-changed(string);
    callback language-changed(string);
    callback rgb-channel-edited(string, string);
    private property <bool> color-picker-open: false;
    private property <string> color-picker-target: "";
    private property <int> picker-red;
    private property <int> picker-green;
    private property <int> picker-blue;

    function open-color-picker(target: string) {
        root.color-picker-target = target;
        root.picker-red = max(0, min(255, round((target == "background" ? root.background-r : target == "button" ? root.button-r : target == "bubble" ? root.bubble-r : root.text-r).to-float())));
        root.picker-green = max(0, min(255, round((target == "background" ? root.background-g : target == "button" ? root.button-g : target == "bubble" ? root.bubble-g : root.text-g).to-float())));
        root.picker-blue = max(0, min(255, round((target == "background" ? root.background-b : target == "button" ? root.button-b : target == "bubble" ? root.bubble-b : root.text-b).to-float())));
        root.color-picker-open = true;
    }
    callback apply-colors-requested();
    callback reset-colors-requested();

    width: 100%;
    height: 100%;
    background: Theme.background;

    SettingsFrame {
        language: root.language-value;
        title: (root.language-value == "ru" ? "Оформление" : "Appearance");
        back-requested => { root.back-requested(); }

        SettingsCard { title: (root.language-value == "ru" ? "Тема" : "Theme");
            SettingsChoice {
                label: (root.language-value == "ru" ? "Тема" : "Theme");
                show-label: false;
                value: root.theme-value;
                options: [
                    { value: "dark", label: (root.language-value == "ru" ? "Тёмная" : "Dark") },
                    { value: "light", label: (root.language-value == "ru" ? "Светлая" : "Light") },
                ];
                changed(value) => {
                    root.theme-changed(value);
                }
            }
        }

        SettingsCard { title: (root.language-value == "ru" ? "Язык" : "Language");
            SettingsChoice {
                label: (root.language-value == "ru" ? "Язык" : "Language");
                show-label: false;
                value: root.language-value;
                options: [
                    { value: "ru", label: (root.language-value == "ru" ? "Русский" : "Russian") },
                    { value: "en", label: "English" },
                ];
                changed(value) => {
                    root.language-changed(value);
                }
            }
        }

        SettingsCard {
            title: (root.language-value == "ru" ? "Цвета интерфейса" : "Interface colours");
            description: (root.language-value == "ru" ? "Настройте основные цвета интерфейса в формате RGB." : "Choose the main interface colours with RGB values.");

            Text {
                text: root.language-value == "ru" ? "Выберите цвет или введите значения каналов от 0 до 255. Затем нажмите «Применить»." : "Choose a color or enter channel values from 0 to 255. Then select Apply.";
                color: Theme.muted;
                font-size: 12px;
                wrap: word-wrap;
                width: 100%;
            }

            SettingsDivider {}

            RgbColorField {
                id: "background";
                language: root.language-value;
                label: (root.language-value == "ru" ? "Фон" : "Background");
                preview: root.background-preview;
                red: root.background-r;
                green: root.background-g;
                blue: root.background-b;
                channel-edited(id, value) => { root.rgb-channel-edited(id, value); }
                choose-color(id) => { root.open-color-picker(id); }
            }

            SettingsDivider {}

            RgbColorField {
                id: "button";
                language: root.language-value;
                label: (root.language-value == "ru" ? "Кнопки" : "Buttons");
                preview: root.button-preview;
                red: root.button-r;
                green: root.button-g;
                blue: root.button-b;
                channel-edited(id, value) => { root.rgb-channel-edited(id, value); }
                choose-color(id) => { root.open-color-picker(id); }
            }

            SettingsDivider {}

            RgbColorField {
                id: "bubble";
                language: root.language-value;
                label: (root.language-value == "ru" ? "Пузыри сообщений" : "Message bubbles");
                preview: root.bubble-preview;
                red: root.bubble-r;
                green: root.bubble-g;
                blue: root.bubble-b;
                channel-edited(id, value) => { root.rgb-channel-edited(id, value); }
                choose-color(id) => { root.open-color-picker(id); }
            }

            SettingsDivider {}

            RgbColorField {
                id: "text";
                language: root.language-value;
                label: (root.language-value == "ru" ? "Текст" : "Text");
                preview: root.text-preview;
                red: root.text-r;
                green: root.text-g;
                blue: root.text-b;
                channel-edited(id, value) => { root.rgb-channel-edited(id, value); }
                choose-color(id) => { root.open-color-picker(id); }
            }

            Text {
                text: root.language-value == "ru" ? "Разница между фоном и текстом: \{root.contrast-score} из 765." : "Background/text difference: \{root.contrast-score} of 765.";
                color: root.contrast-score >= 20 ? Theme.muted : Theme.danger;
                font-size: 12px;
                wrap: word-wrap;
                width: 100%;
            }

            if root.contrast-score < 20 : Text {
                text: (root.language-value == "ru" ? "Цвет текста слишком близок к фону: нужно минимум 20." : "The text colour is too close to the background: at least 20 is required.");
                color: Theme.danger;
                font-size: 12px;
                wrap: word-wrap;
                width: 100%;
            }

            HorizontalLayout {
                spacing: 8px;

                FHPrimaryButton {
                    text: (root.language-value == "ru" ? "Применить" : "Apply");
                    enabled: root.contrast-score >= 20 && !root.busy;
                    busy: root.busy;
                    clicked => { root.apply-colors-requested(); }
                }

                FHSecondaryButton {
                    text: (root.language-value == "ru" ? "Сбросить цвета" : "Reset colours");
                    height: 40px;
                    enabled: root.has-custom-colors && !root.busy;
                    clicked => { root.reset-colors-requested(); }
                }
            }
        }
    }
    if root.color-picker-open : ColorPickerDialog {
        width: parent.width;
        height: parent.height;
        russian: root.language-value == "ru";
        initial-red: root.picker-red;
        initial-green: root.picker-green;
        initial-blue: root.picker-blue;
        close-requested => { root.color-picker-open = false; }
        chosen(red, green, blue) => {
            if root.color-picker-target == "background" {
                root.background-r = "\{red}";
                root.background-g = "\{green}";
                root.background-b = "\{blue}";
            } else if root.color-picker-target == "button" {
                root.button-r = "\{red}";
                root.button-g = "\{green}";
                root.button-b = "\{blue}";
            } else if root.color-picker-target == "bubble" {
                root.bubble-r = "\{red}";
                root.bubble-g = "\{green}";
                root.bubble-b = "\{blue}";
            } else {
                root.text-r = "\{red}";
                root.text-g = "\{green}";
                root.text-b = "\{blue}";
            }
            root.rgb-channel-edited(root.color-picker-target, "");
            root.color-picker-open = false;
        }
    }

}
