import { Theme } from "../theme.slint";
import { FHSecondaryButton, FHPrimaryButton } from "../components.slint";
import { SettingsCard, SettingsChoice, SettingsDivider, SettingsFrame, SettingsToggle } from "common.slint";

export struct SettingsContact {
    id: string,
    name: string,
}

export struct SettingsPrivacyException {
    id: string,
    name: string,
    kind: string,
}

component ContactChoiceRow inherits Rectangle {
    in property <string> account-id;
    in property <string> name;
    in property <string> selected-id;
    callback selected(string);

    width: 100%;
    height: max(36px, contact-name.preferred-height + 12px);
    border-radius: 8px;
    border-width: 2px;
    border-color: transparent;
    background: root.account-id == root.selected-id ? Theme.accent.with-alpha(0.12) : (choice-area.has-hover ? Theme.hover : transparent);
    animate background { duration: 120ms; }
    accessible-role: radio-button;
    accessible-label: root.name;
    accessible-checkable: true;
    accessible-checked: root.account-id == root.selected-id;
    accessible-action-default => { root.selected(root.account-id); }
    forward-focus: keyboard-scope;

    states [
        focus when keyboard-scope.has-focus : {
            root.border-color: Theme.accent;
        }
    ]

    Rectangle {
        x: 10px;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        border-width: 1px;
        border-color: root.account-id == root.selected-id ? Theme.accent : Theme.border;
        background: root.account-id == root.selected-id ? Theme.accent : transparent;

        if root.account-id == root.selected-id : Rectangle {
            x: 4px;
            y: 4px;
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: Theme.accent-foreground;
        }
    }

    contact-name := Text {
        x: 34px;
        width: parent.width - 46px;
        height: parent.height;
        text: root.name;
        color: Theme.foreground;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }

    choice-area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.selected(root.account-id); }
    }

    keyboard-scope := FocusScope {
        x: 0;
        width: 0;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.selected(root.account-id);
                return accept;
            }
            return reject;
        }
    }
}

component ExceptionRow inherits Rectangle {
    in property <string> name;
    in property <string> detail;
    in property <string> remove-label;
    in property <string> item-id;
    in property <bool> enabled: true;
    callback remove(string);

    width: 100%;
    height: max(44px, content.preferred-height);
    background: Theme.background;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 8px;

    content := HorizontalLayout {
        padding: 8px;
        spacing: 8px;
        alignment: center;

        VerticalLayout {
            spacing: 3px;
            horizontal-stretch: 1;
            vertical-stretch: 0;

        Text {
            text: root.name;
            color: Theme.foreground;
            font-size: 13px;
            width: 100%;
            wrap: word-wrap;
        }

        Text {
            text: root.detail;
            color: Theme.muted;
            font-size: 11px;
            width: 100%;
            wrap: word-wrap;
        }
        }

        FHSecondaryButton {
            text: root.remove-label;
            height: 30px;
            enabled: root.enabled;
            clicked => { root.remove(root.item-id); }
        }
    }
}

export component PrivacySettingsScreen inherits Rectangle {
    in property <string> language: "ru";
    in property <string> dm-policy: "everyone";
    in property <string> group-add-policy: "everyone";
    in property <bool> invisible: false;
    in property <bool> allow-nudges: true;
    in property <bool> profile-hidden: false;
    in property <bool> hidden-from-search: false;
    in property <[SettingsContact]> contacts: [];
    in property <[SettingsPrivacyException]> presence-exceptions: [];
    in property <[SettingsPrivacyException]> profile-exceptions: [];
    in property <[SettingsPrivacyException]> group-add-exceptions: [];
    in property <[SettingsContact]> blocked-accounts: [];
    in-out property <string> presence-contact-id: "";
    in-out property <string> presence-kind: "always_visible";
    in-out property <string> profile-contact-id: "";
    in-out property <string> group-contact-id: "";
    in-out property <string> block-contact-id: "";
    in property <bool> busy: false;

    callback back-requested();
    callback dm-policy-changed(string);
    callback group-add-policy-changed(string);
    callback invisible-changed(bool);
    callback nudges-changed(bool);
    callback profile-hidden-changed(bool);
    callback hidden-from-search-changed(bool);
    callback presence-exception-added(string, string);
    callback presence-exception-removed(string, string);
    callback profile-exception-added(string);
    callback profile-exception-removed(string);
    callback group-add-exception-added(string);
    callback group-add-exception-removed(string);
    callback account-blocked(string);
    callback account-unblocked(string);

    width: 100%;
    height: 100%;
    background: Theme.background;

    SettingsFrame {
        language: root.language;
        title: (root.language == "ru" ? "Приватность" : "Privacy");
        back-requested => { root.back-requested(); }

        SettingsCard {
            title: (root.language == "ru" ? "Кто может писать вам" : "Who can message you");
            description: (root.language == "ru" ? "Знакомые — люди, с которыми у вас уже есть общий личный или групповой чат. Это не только сохранённые контакты." : "Known people share a direct or group chat with you. This includes more than saved contacts.");

            SettingsChoice {
                label: (root.language == "ru" ? "Кто может писать вам" : "Who can message you");
                value: root.dm-policy;
                enabled: !root.busy;
                options: [
                    { value: "everyone", label: (root.language == "ru" ? "Все" : "Everyone") },
                    { value: "contacts_only", label: (root.language == "ru" ? "Только знакомые" : "Only known people") },
                ];
                changed(value) => {
                    root.dm-policy-changed(value);
                }
            }
        }

        SettingsCard {
            title: (root.language == "ru" ? "Кто может добавлять вас в группы" : "Who can add you to groups");
            description: (root.language == "ru" ? "Разрешение на прямое добавление в группу." : "Permission to add you directly to a group.");

            SettingsChoice {
                label: (root.language == "ru" ? "Кто может добавлять вас в группы" : "Who can add you to groups");
                value: root.group-add-policy;
                enabled: !root.busy;
                options: [
                    { value: "everyone", label: (root.language == "ru" ? "Все" : "Everyone") },
                    { value: "nobody", label: (root.language == "ru" ? "Только люди из исключений" : "Only people in exceptions") },
                ];
                changed(value) => {
                    root.group-add-policy-changed(value);
                }
            }

            if root.group-add-policy == "nobody" : Rectangle {
                width: 100%;
                height: exceptions-content.preferred-height;

                exceptions-content := VerticalLayout {
                    spacing: 8px;

                    Text {
                        text: (root.language == "ru" ? "Эти люди могут добавлять вас в группы, когда выбраны только исключения." : "These people can add you to groups when only exceptions are allowed.");
                        color: Theme.muted;
                        font-size: 12px;
                        wrap: word-wrap;
                        width: 100%;
                    }

                    if root.group-add-exceptions.length == 0 : Text {
                        text: (root.language == "ru" ? "Исключений пока нет." : "No exceptions yet.");
                        color: Theme.muted;
                        font-size: 12px;
                    }

                    for exception in root.group-add-exceptions : ExceptionRow {
                        name: exception.name;
                        detail: (root.language == "ru" ? "Может добавлять вас в группы" : "Can add you to groups");
                        remove-label: (root.language == "ru" ? "Убрать" : "Remove");
                        item-id: exception.id;
                        enabled: !root.busy;
                        remove(id) => { root.group-add-exception-removed(id); }
                    }

                    Text {
                        text: (root.language == "ru" ? "Добавить друга" : "Add a friend");
                        color: Theme.muted;
                        font-size: 12px;
                    }

                    for contact in root.contacts : ContactChoiceRow {
                        account-id: contact.id;
                        name: contact.name;
                        selected-id: root.group-contact-id;
                        selected(id) => { root.group-contact-id = id; }
                    }

                    FHPrimaryButton {
                        text: (root.language == "ru" ? "Добавить в исключения" : "Add to exceptions");
                        enabled: !root.busy && !root.group-contact-id.is-empty;
                        busy: root.busy;
                        clicked => { root.group-add-exception-added(root.group-contact-id); }
                    }
                }
            }
        }

        SettingsCard {
            title: (root.language == "ru" ? "Невидимка" : "Invisible mode");
            description: (root.language == "ru" ? "Скрывает ваш онлайн-статус и время последнего визита. Текущее состояние синхронизируется с сервером." : "Hides your online status and last-seen time. The current setting is synchronized with the server.");

            SettingsToggle {
                label: (root.language == "ru" ? "Невидимка" : "Invisible mode");
                description: (root.language == "ru" ? "Скрыть онлайн-статус и время последнего визита" : "Hide online status and last-seen time");
                checked: root.invisible;
                enabled: !root.busy;
                changed(value) => { root.invisible-changed(value); }
            }
        }

        SettingsCard {
            title: (root.language == "ru" ? "Разрешить встряхивания" : "Allow nudges");
            description: (root.language == "ru" ? "Собеседники смогут отправлять вам короткий сигнал со встряхиванием интерфейса." : "People you chat with can send a brief signal that shakes the interface.");

            SettingsToggle {
                label: (root.language == "ru" ? "Разрешить встряхивания" : "Allow nudges");
                checked: root.allow-nudges;
                enabled: !root.busy;
                changed(value) => { root.nudges-changed(value); }
            }
        }

        SettingsCard {
            title: (root.language == "ru" ? "Видимость профиля" : "Profile visibility");
            description: (root.language == "ru" ? "Отдельно управляйте доступом к профилю и показом в глобальном поиске." : "Control profile access and global search visibility separately.");

            SettingsToggle {
                label: (root.language == "ru" ? "Скрыть профиль от незнакомцев" : "Hide profile from strangers");
                description: (root.language == "ru" ? "Профиль будет недоступен тем, кого нет в исключениях." : "People outside your exceptions will not be able to open your profile.");
                checked: root.profile-hidden;
                enabled: !root.busy;
                changed(value) => { root.profile-hidden-changed(value); }
            }

            SettingsToggle {
                label: (root.language == "ru" ? "Не показывать в поиске" : "Hide from search");
                description: (root.language == "ru" ? "Профиль не появится в результатах глобального поиска." : "Your profile will not appear in global search results.");
                checked: root.hidden-from-search;
                enabled: !root.busy;
                changed(value) => { root.hidden-from-search-changed(value); }
            }

            SettingsDivider {}

            Text {
                text: (root.language == "ru" ? "Кому профиль всё равно виден" : "People who can still see your profile");
                color: Theme.foreground;
                font-size: 13px;
                font-weight: 500;
            }

            Text {
                text: (root.language == "ru" ? "Эти друзья смогут открыть ваш профиль, даже если он скрыт." : "These friends can open your profile even while it is hidden.");
                color: Theme.muted;
                font-size: 12px;
                wrap: word-wrap;
                width: 100%;
            }

            if root.profile-exceptions.length == 0 : Text {
                text: (root.language == "ru" ? "Исключений пока нет." : "No exceptions yet.");
                color: Theme.muted;
                font-size: 12px;
            }

            for exception in root.profile-exceptions : ExceptionRow {
                name: exception.name;
                detail: (root.language == "ru" ? "Видит ваш профиль" : "Can see your profile");
                remove-label: (root.language == "ru" ? "Убрать" : "Remove");
                item-id: exception.id;
                enabled: !root.busy;
                remove(id) => { root.profile-exception-removed(id); }
            }

            Text {
                text: (root.language == "ru" ? "Добавить друга" : "Add a friend");
                color: Theme.muted;
                font-size: 12px;
            }

            for contact in root.contacts : ContactChoiceRow {
                account-id: contact.id;
                name: contact.name;
                selected-id: root.profile-contact-id;
                selected(id) => { root.profile-contact-id = id; }
            }

            FHPrimaryButton {
                text: (root.language == "ru" ? "Добавить в исключения профиля" : "Add to profile exceptions");
                enabled: !root.busy && !root.profile-contact-id.is-empty;
                busy: root.busy;
                clicked => { root.profile-exception-added(root.profile-contact-id); }
            }
        }

        SettingsCard {
            title: (root.language == "ru" ? "Исключения для присутствия" : "Presence exceptions");
            description: (root.language == "ru" ? "Кому видно ваше присутствие независимо от режима." : "Who sees your presence regardless of the mode.");

            if root.presence-exceptions.length == 0 : Text {
                text: (root.language == "ru" ? "Исключений пока нет." : "No exceptions yet.");
                color: Theme.muted;
                font-size: 12px;
            }

            for exception in root.presence-exceptions : ExceptionRow {
                name: exception.name;
                detail: exception.kind == "always_visible" ? (root.language == "ru" ? "Всегда видит" : "Always sees") : (root.language == "ru" ? "Никогда не видит" : "Never sees");
                remove-label: (root.language == "ru" ? "Убрать" : "Remove");
                item-id: exception.id;
                enabled: !root.busy;
                remove(id) => { root.presence-exception-removed(id, exception.kind); }
            }

            SettingsChoice {
                label: (root.language == "ru" ? "Правило" : "Rule");
                value: root.presence-kind;
                enabled: !root.busy;
                options: [
                    { value: "always_visible", label: (root.language == "ru" ? "Всегда видит" : "Always sees") },
                    { value: "always_invisible", label: (root.language == "ru" ? "Никогда не видит" : "Never sees") },
                ];
                changed(value) => { root.presence-kind = value; }
            }

            Text {
                text: (root.language == "ru" ? "Выберите контакт" : "Pick a contact");
                color: Theme.muted;
                font-size: 12px;
            }

            for contact in root.contacts : ContactChoiceRow {
                account-id: contact.id;
                name: contact.name;
                selected-id: root.presence-contact-id;
                selected(id) => { root.presence-contact-id = id; }
            }

            FHPrimaryButton {
                text: (root.language == "ru" ? "Добавить исключение" : "Add an exception");
                enabled: !root.busy && !root.presence-contact-id.is-empty;
                busy: root.busy;
                clicked => { root.presence-exception-added(root.presence-contact-id, root.presence-kind); }
            }
        }

        SettingsCard {
            title: (root.language == "ru" ? "Заблокированные" : "Blocked accounts");
            description: (root.language == "ru" ? "Сообщения от них не доходят ни в одну сторону." : "Messages to and from them are dropped in both directions.");

            if root.blocked-accounts.length == 0 : Text {
                text: (root.language == "ru" ? "Заблокированных нет." : "Nobody is blocked.");
                color: Theme.muted;
                font-size: 12px;
            }

            for account in root.blocked-accounts : ExceptionRow {
                name: account.name;
                detail: account.id;
                remove-label: (root.language == "ru" ? "Разблокировать" : "Unblock");
                item-id: account.id;
                enabled: !root.busy;
                remove(id) => { root.account-unblocked(id); }
            }

            SettingsDivider {}

            Text {
                text: (root.language == "ru" ? "Выберите контакт, чтобы заблокировать его" : "Pick a contact to block");
                color: Theme.muted;
                font-size: 12px;
            }

            for contact in root.contacts : ContactChoiceRow {
                account-id: contact.id;
                name: contact.name;
                selected-id: root.block-contact-id;
                selected(id) => { root.block-contact-id = id; }
            }

            FHPrimaryButton {
                danger: true;
                text: (root.language == "ru" ? "Заблокировать" : "Block");
                enabled: !root.busy && !root.block-contact-id.is-empty;
                busy: root.busy;
                clicked => { root.account-blocked(root.block-contact-id); }
            }
        }
    }
}
