import { Theme } from "../theme.slint";
import { SettingsFrame } from "common.slint";
import { IconBot, IconChevronRight, IconInfo, IconPalette, IconShieldCheck, IconUserRound, IconUserRoundCog, IconUsers, IconBell } from "../icons.slint";

component SettingsNavigationRow inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <string> section;
    callback open-section(string);

    width: 100%;
    height: max(56px, content.preferred-height);
    background: nav-area.has-hover ? Theme.hover : Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 12px;
    accessible-role: button;
    accessible-label: root.title;
    accessible-action-default => { root.open-section(root.section); }
    forward-focus: keyboard-scope;

    states [
        focus when keyboard-scope.has-focus : {
            root.border-width: 2px;
            root.border-color: Theme.accent;
        }
    ]

    content := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 12px;
        cross-axis-alignment: center;

        if root.section == "account" : IconUserRound { width: 20px; height: 20px; stroke: Theme.muted; }
        if root.section == "appearance" : IconPalette { width: 20px; height: 20px; stroke: Theme.muted; }
        if root.section == "privacy" : IconUsers { width: 20px; height: 20px; stroke: Theme.muted; }
        if root.section == "security" : IconShieldCheck { width: 20px; height: 20px; stroke: Theme.muted; }
        if root.section == "notifications" : IconBell { width: 20px; height: 20px; stroke: Theme.muted; }
        if root.section == "accounts" : IconUserRoundCog { width: 20px; height: 20px; stroke: Theme.muted; }
        if root.section == "bots" : IconBot { width: 20px; height: 20px; stroke: Theme.muted; }
        if root.section == "about" : IconInfo { width: 20px; height: 20px; stroke: Theme.muted; }

        VerticalLayout {
            spacing: 2px;
            horizontal-stretch: 1;
            vertical-stretch: 0;

            Text {
                text: root.title;
                color: Theme.foreground;
                font-size: 14px;
                font-weight: 500;
                width: 100%;
                wrap: word-wrap;
            }

            Text {
                text: root.description;
                color: Theme.muted;
                font-size: 12px;
                width: 100%;
                wrap: word-wrap;
            }
        }

        IconChevronRight {
            width: 16px;
            height: 16px;
            stroke: Theme.muted;
        }
    }

    nav-area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.open-section(root.section); }
    }

    keyboard-scope := FocusScope {
        x: 0;
        width: 0;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.open-section(root.section);
                return accept;
            }
            return reject;
        }
    }
}

export component SettingsIndexScreen inherits Rectangle {
    in property <string> language: "ru";
    callback back-requested();
    callback open-section(string);

    width: 100%;
    height: 100%;
    background: Theme.background;

    SettingsFrame {
        language: root.language;
        content-spacing: 8px;
        title: root.language == "ru" ? "Настройки" : "Settings";
        back-requested => { root.back-requested(); }

        SettingsNavigationRow {
            title: root.language == "ru" ? "Аккаунт" : "Account";
            description: root.language == "ru" ? "Аватар, имя и статус" : "Avatar, name and status";
            section: "account";
            open-section(section) => { root.open-section(section); }
        }
        SettingsNavigationRow {
            title: root.language == "ru" ? "Оформление" : "Appearance";
            description: root.language == "ru" ? "Тема и язык" : "Theme and language";
            section: "appearance";
            open-section(section) => { root.open-section(section); }
        }
        SettingsNavigationRow {
            title: root.language == "ru" ? "Приватность" : "Privacy";
            description: root.language == "ru" ? "Невидимка, исключения и блокировки" : "Invisible mode, exceptions and blocks";
            section: "privacy";
            open-section(section) => { root.open-section(section); }
        }
        SettingsNavigationRow {
            title: root.language == "ru" ? "Безопасность" : "Security";
            description: root.language == "ru" ? "2FA, сессии и устройства" : "2FA, sessions and devices";
            section: "security";
            open-section(section) => { root.open-section(section); }
        }
        SettingsNavigationRow {
            title: root.language == "ru" ? "Уведомления" : "Notifications";
            description: root.language == "ru" ? "Звук и разрешение на уведомления" : "Sound and notification permission";
            section: "notifications";
            open-section(section) => { root.open-section(section); }
        }
        SettingsNavigationRow {
            title: root.language == "ru" ? "Аккаунты" : "Accounts";
            description: root.language == "ru" ? "Аккаунты на этом устройстве" : "Accounts on this device";
            section: "accounts";
            open-section(section) => { root.open-section(section); }
        }
        SettingsNavigationRow {
            title: root.language == "ru" ? "Мои боты" : "My bots";
            description: root.language == "ru" ? "Создание, адреса и токены ботов." : "Create bots, manage handles and tokens.";
            section: "bots";
            open-section(section) => { root.open-section(section); }
        }
        SettingsNavigationRow {
            title: root.language == "ru" ? "О приложении" : "About";
            description: root.language == "ru" ? "Версия, лицензия и выход" : "Version, licence and sign out";
            section: "about";
            open-section(section) => { root.open-section(section); }
        }
    }
}
