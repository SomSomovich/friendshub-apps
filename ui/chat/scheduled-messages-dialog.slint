import { Theme } from "../theme.slint";
import { ChatAction } from "chat-controls.slint";
import { ScrollView } from "std-widgets.slint";

export struct ScheduledMessageView {
    id: string,
    send-at-label: string,
    device-count-label: string,
    busy: bool,
}

export component ScheduledMessagesDialog inherits Rectangle {
    in property <bool> open: false;
    in property <bool> loading: false;
    in property <string> error-text: "";
    in property <string> title: "Отложенная отправка";
    in property <string> loading-label: "Загрузка…";
    in property <string> empty-title: "Отложенных сообщений нет";
    in property <string> empty-description: "Запланированные сообщения появятся здесь.";
    in property <string> retry-label: "Повторить";
    in property <string> cancel-label: "Отменить";
    in property <string> cancel-busy-label: "Отменяем…";
    in property <string> cancelling-id: "";
    in property <[ScheduledMessageView]> messages;

    callback refresh-requested();
    callback cancel-requested(string);
    callback close-requested();

    if root.open : Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        background: #99000000;
        TouchArea { clicked => { root.close-requested(); } }
        Rectangle {
            x: (parent.width - min(parent.width - 32px, 560px)) / 2;
            y: (parent.height - min(parent.height - 32px, 600px)) / 2;
            width: min(parent.width - 32px, 560px);
            height: min(parent.height - 32px, 600px);
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 14px;
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                HorizontalLayout {
                    Text { text: root.title; color: Theme.foreground; font-size: 16px; font-weight: 600; horizontal-stretch: 1; vertical-alignment: center; }
                    ChatAction { label: "×"; accessible-name: "Закрыть отложенные сообщения"; clicked => { root.close-requested(); } }
                }
                if root.loading : Text {
                    text: root.loading-label;
                    color: Theme.muted;
                    font-size: 13px;
                    horizontal-alignment: center;
                    vertical-stretch: 1;
                }
                if !root.loading && !root.error-text.is-empty : VerticalLayout {
                    alignment: center;
                    vertical-stretch: root.messages.length == 0 ? 1 : 0;
                    spacing: 8px;
                    Text { text: root.error-text; color: Theme.danger; font-size: 12px; wrap: word-wrap; horizontal-alignment: center; }
                    ChatAction { label: root.retry-label; clicked => { root.refresh-requested(); } }
                }
                if !root.loading && root.error-text.is-empty && root.messages.length == 0 : VerticalLayout {
                    alignment: center;
                    vertical-stretch: 1;
                    spacing: 8px;
                    Text { text: root.empty-title; color: Theme.foreground; font-size: 14px; horizontal-alignment: center; }
                    Text { text: root.empty-description; color: Theme.muted; font-size: 12px; wrap: word-wrap; horizontal-alignment: center; }
                }
                if !root.loading && root.messages.length > 0 : ScrollView {
                    width: 100%;
                    vertical-stretch: 1;
                    vertical-scrollbar-policy: as-needed;
                    VerticalLayout {
                        width: 100%;
                        spacing: 4px;
                        for message[index] in root.messages : Rectangle {
                            width: 100%;
                            height: 60px;
                            background: Theme.background;
                            border-width: 1px;
                            border-color: Theme.border;
                            border-radius: 8px;
                            HorizontalLayout {
                                padding: 8px;
                                spacing: 8px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 3px;
                                    Text { text: message.send-at-label; color: Theme.foreground; font-size: 12px; }
                                    Text { text: message.device-count-label; color: Theme.muted; font-size: 10px; }
                                }
                                ChatAction {
                                    label: message.busy || root.cancelling-id == message.id ? root.cancel-busy-label : root.cancel-label;
                                    enabled: root.cancelling-id.is-empty && !message.busy;
                                    clicked => { root.cancel-requested(message.id); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
