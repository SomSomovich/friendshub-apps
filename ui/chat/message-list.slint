import { Theme } from "../theme.slint";
import { ChatAction, ChatAttachmentView, ChatReaction } from "chat-controls.slint";
import { PollCard, PollViewModel } from "poll-card.slint";
import { ScrollView } from "std-widgets.slint";

export struct ChatMessage {
    id: string,
    day-label: string,
    author: string,
    author-tag: string,
    body: string,
    time-label: string,
    delivery-label: string,
    reactions: [ChatReaction],
    attachments: [ChatAttachmentView],
    own: bool,
    edited: bool,
    show-day-label: bool,
}

export component MessageList inherits Rectangle {
    in property <[ChatMessage]> messages;
    in-out property <string> scroll-to-message-id: "";
    in property <[PollViewModel]> polls;
    in property <bool> loading: false;
    in property <bool> polls-loading: false;
    in property <bool> polls-has-older: false;
    in property <bool> polls-loading-older: false;
    in property <string> polls-error-text: "";
    in property <bool> has-older: false;
    in property <string> error-text: "";
    callback load-older-requested();
    callback message-menu-requested(int);
    callback attachment-open-requested(int, string);
    callback reaction-requested(int, string);
    callback polls-retry-requested();
    callback polls-load-older-requested();
    callback poll-option-selection-requested(string, string);
    callback poll-vote-requested(string);
    callback poll-proposal-changed(string, string);
    callback poll-propose-option-requested(string, string);
    callback poll-option-remove-requested(string, string);
    callback poll-stop-requested(string);
    callback poll-remove-requested(string);

    private property <string> highlighted-message-id: "";

    highlight-timer := Timer {
        running: false;
        interval: 1800ms;
        triggered => { root.highlighted-message-id = ""; }
    }

    background: Theme.background;

    message-scroll := ScrollView {
        width: 100%;
        height: 100%;
        vertical-scrollbar-policy: as-needed;

        VerticalLayout {
            width: 100%;
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: 6px;

            if root.has-older : HorizontalLayout {
                alignment: center;
                ChatAction {
                    label: root.loading ? "Загружаем…" : "Загрузить более ранние сообщения";
                    enabled: !root.loading;
                    clicked => { root.load-older-requested(); }
                }
            }

            if !root.error-text.is-empty : Text {
                text: root.error-text;
                color: Theme.danger;
                font-size: 12px;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }

            if root.messages.length == 0 && root.polls.length == 0 && !root.loading && root.error-text.is-empty : VerticalLayout {
                alignment: center;
                vertical-stretch: 1;
                spacing: 8px;
                Text {
                    text: "Сообщений пока нет";
                    color: Theme.foreground;
                    font-size: 14px;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Скажите привет!";
                    color: Theme.muted;
                    font-size: 12px;
                    horizontal-alignment: center;
                }
            }

            if root.loading && root.messages.length == 0 : Text {
                text: "Загружаем сообщения…";
                color: Theme.muted;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-stretch: 1;
            }

            for message[index] in root.messages : message-row := VerticalLayout {
                property <bool> is-scroll-target: root.scroll-to-message-id == message.id;
                property <bool> is-highlighted: root.highlighted-message-id == message.id;
                changed is-scroll-target => {
                    if is-scroll-target {
                        message-scroll.content-y = -self.y;
                        root.highlighted-message-id = message.id;
                        highlight-timer.restart();
                        root.scroll-to-message-id = "";
                    }
                }
                init => {
                    if is-scroll-target {
                        message-scroll.content-y = -self.y;
                        root.highlighted-message-id = message.id;
                        highlight-timer.restart();
                        root.scroll-to-message-id = "";
                    }
                }
                width: 100%;
                spacing: 4px;

                if message.show-day-label : HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: day-label.preferred-width + 24px;
                        height: 24px;
                        border-width: 1px;
                        border-color: Theme.border;
                        border-radius: 12px;
                        background: Theme.surface;
                        Text {
                            x: 10px;
                            width: parent.width - 20px;
                            height: 100%;
                            text: message.day-label;
                            color: Theme.muted;
                            font-size: 11px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        day-label := Text { text: message.day-label; visible: false; }
                    }
                }

                HorizontalLayout {
                    alignment: message.own ? end : start;

                    if message.own : Rectangle { horizontal-stretch: 1; background: transparent; }

                    Rectangle {
                        width: min(max(parent.width * 0.45, min(parent.width, 180px)), min(parent.width * 0.78, 560px));
                        height: bubble-content.preferred-height + 16px;
                        background: message.own ? Theme.message-bubble : Theme.surface;
                        border-width: message-row.is-highlighted ? 2px : 1px;
                        border-color: message-row.is-highlighted ? Theme.accent : Theme.border;
                        border-radius: 12px;

                        bubble-content := VerticalLayout {
                            x: 10px;
                            y: 8px;
                            width: parent.width - 20px;
                            spacing: 4px;

                            if !message.author.is-empty || !message.author-tag.is-empty : HorizontalLayout {
                                spacing: 5px;
                                if !message.author.is-empty : Text {
                                    text: message.author;
                                    color: Theme.accent;
                                    font-size: 11px;
                                    font-weight: 600;
                                    wrap: word-wrap;
                                }
                                if !message.author-tag.is-empty : Text {
                                    text: message.author-tag;
                                    color: Theme.accent;
                                    font-size: 10px;
                                    wrap: word-wrap;
                                }
                            }

                            if !message.body.is-empty : Text {
                                text: message.body;
                                color: Theme.foreground;
                                font-size: 14px;
                                wrap: word-wrap;
                                horizontal-stretch: 1;
                            }

                            for attachment[attachment-index] in message.attachments : Rectangle {
                                width: 100%;
                                height: attachment.has-preview ? min(parent.width * 0.72, 280px) : 44px;
                                background: Theme.background;
                                border-width: attachment.unavailable ? 1px : 0px;
                                border-color: Theme.border;
                                border-radius: 8px;
                                clip: true;
                                if attachment.has-preview && !attachment.unavailable : Image {
                                    width: 100%;
                                    height: 100%;
                                    source: attachment.preview-image;
                                    image-fit: cover;
                                }
                                if !attachment.has-preview || attachment.unavailable : HorizontalLayout {
                                    padding: 8px;
                                    spacing: 6px;
                                    Text {
                                        text: attachment.unavailable ? (attachment.state-label.is-empty ? "Вложение недоступно" : attachment.state-label) : "▤";
                                        color: attachment.unavailable ? Theme.muted : Theme.accent;
                                        font-size: 11px;
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                    }
                                    Text { text: attachment.size-label; color: Theme.muted; font-size: 10px; vertical-alignment: center; }
                                }
                                TouchArea {
                                    enabled: !attachment.unavailable;
                                    accessible-role: button;
                                    accessible-label: attachment.label;
                                    clicked => { root.attachment-open-requested(index, attachment.id); }
                                }
                            }

                            HorizontalLayout {
                                spacing: 6px;
                                alignment: end;
                                if message.edited : Text {
                                    text: "изменено";
                                    color: Theme.muted;
                                    font-size: 10px;
                                }
                                Text {
                                    text: message.time-label;
                                    color: Theme.muted;
                                    font-size: 10px;
                                }
                                if message.own && !message.delivery-label.is-empty : Text {
                                    text: message.delivery-label;
                                    color: Theme.muted;
                                    font-size: 10px;
                                }
                                ChatAction {
                                    label: "Ещё";
                                    accessible-name: "Дополнительные действия сообщения";
                                    width: 40px;
                                    height: 24px;
                                    clicked => { root.message-menu-requested(index); }
                                }
                            }
                        }
                    }

                    if !message.own : Rectangle { horizontal-stretch: 1; background: transparent; }
                }

                if message.reactions.length > 0 : HorizontalLayout {
                    alignment: message.own ? end : start;
                    for reaction[index] in message.reactions : ChatAction {
                        label: reaction.emoji + " " + reaction.count-label;
                        active: reaction.mine;
                        height: 24px;
                        accessible-name: reaction.emoji + " " + reaction.count-label;
                        clicked => { root.reaction-requested(index, reaction.emoji); }
                    }
                }
            }

            if !root.polls-error-text.is-empty : HorizontalLayout {
                Text { text: root.polls-error-text; color: Theme.danger; font-size: 11px; wrap: word-wrap; horizontal-stretch: 1; }
                ChatAction { label: "Повторить"; clicked => { root.polls-retry-requested(); } }
            }
            if root.polls-loading && root.polls.length == 0 : Text {
                text: "Загружаем опросы…";
                color: Theme.muted;
                font-size: 11px;
                horizontal-alignment: center;
            }
            for poll[index] in root.polls : PollCard {
                poll: poll;
                option-selection-requested(option-id) => { root.poll-option-selection-requested(poll.id, option-id); }
                vote-requested(poll-id) => { root.poll-vote-requested(poll-id); }
                proposal-changed(text) => { root.poll-proposal-changed(poll.id, text); }
                propose-option-requested(poll-id, text) => { root.poll-propose-option-requested(poll-id, text); }
                remove-option-requested(poll-id, option-id) => { root.poll-option-remove-requested(poll-id, option-id); }
                stop-requested(poll-id) => { root.poll-stop-requested(poll-id); }
                remove-requested(poll-id) => { root.poll-remove-requested(poll-id); }
            }
            if root.polls-has-older : HorizontalLayout {
                alignment: center;
                ChatAction {
                    label: root.polls-loading-older ? "Загружаем…" : "Более ранние опросы";
                    enabled: !root.polls-loading-older;
                    clicked => { root.polls-load-older-requested(); }
                }
            }
        }
    }
}
