import { Theme } from "../theme.slint";
import { FHIconButton, FHSecondaryButton, FHSkeleton, FHEmptyState } from "../components.slint";
import { IconCheck, IconFileText, IconMessageSquare, IconMoreHorizontal, IconTriangleAlert } from "../icons.slint";
import { ChatAttachmentView, ChatReaction } from "chat-controls.slint";
import { PollCard, PollViewModel } from "poll-card.slint";
import { ScrollView } from "std-widgets.slint";

export struct ChatMessage {
    id: string,
    day-label: string,
    author: string,
    author-tag: string,
    body: string,
    time-label: string,
    delivery-label: string,
    reactions: [ChatReaction],
    attachments: [ChatAttachmentView],
    own: bool,
    edited: bool,
    show-day-label: bool,
}

export component MessageList inherits Rectangle {
    in property <[ChatMessage]> messages;
    in-out property <string> scroll-to-message-id: "";
    in property <[PollViewModel]> polls;
    in property <bool> loading: false;
    in property <bool> polls-loading: false;
    in property <bool> polls-has-older: false;
    in property <bool> polls-loading-older: false;
    in property <string> polls-error-text: "";
    in property <bool> has-older: false;
    in property <string> error-text: "";
    in property <bool> show-authors: false;
    in property <string> language: "ru";
    callback load-older-requested();
    callback message-menu-requested(int);
    callback attachment-open-requested(int, string);
    callback reaction-requested(int, string);
    callback polls-retry-requested();
    callback polls-load-older-requested();
    callback poll-option-selection-requested(string, string);
    callback poll-vote-requested(string);
    callback poll-proposal-changed(string, string);
    callback poll-propose-option-requested(string, string);
    callback poll-option-remove-requested(string, string);
    callback poll-stop-requested(string);
    callback poll-remove-requested(string);

    private property <string> highlighted-message-id: "";

    highlight-timer := Timer {
        running: false;
        interval: 1800ms;
        triggered => { root.highlighted-message-id = ""; }
    }

    background: Theme.background;

    message-scroll := ScrollView {
        width: 100%;
        height: 100%;
        vertical-scrollbar-policy: as-needed;

        VerticalLayout {
            width: 100%;
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: 6px;

            if root.messages.length > 0 || root.polls.length > 0 : Rectangle {
                vertical-stretch: 1;
                background: transparent;
            }

            if root.has-older : HorizontalLayout {
                alignment: center;

                FHSecondaryButton {
                    text: root.loading
                        ? (root.language == "ru" ? "Загрузка" : "Loading")
                        : (root.language == "ru" ? "Загрузить более ранние" : "Load earlier messages");
                    height: 32px;
                    enabled: !root.loading;
                    busy: root.loading;
                    clicked => { root.load-older-requested(); }
                }
            }

            if !root.error-text.is-empty : Text {
                text: root.error-text;
                color: Theme.danger;
                font-size: 12px;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }

            if root.messages.length == 0 && root.polls.length == 0 && !root.loading && root.error-text.is-empty : Rectangle {
                vertical-stretch: 1;
                background: transparent;

                FHEmptyState {
                    title: root.language == "ru" ? "Сообщений пока нет" : "No messages yet";
                    description: root.language == "ru" ? "Скажите привет!" : "Say hello!";

                    IconMessageSquare {
                        width: 32px;
                        height: 32px;
                        stroke: Theme.muted;
                    }
                }
            }

            if root.loading && root.messages.length == 0 : VerticalLayout {
                vertical-stretch: 1;
                spacing: 10px;
                alignment: end;

                for row in 6 : HorizontalLayout {
                    alignment: Math.mod(row, 3) == 1 ? end : start;

                    FHSkeleton {
                        height: Math.mod(row, 2) == 0 ? 44px : 62px;
                        width: Math.mod(row, 4) == 0 ? 38% : Math.mod(row, 4) == 1 ? 52% : Math.mod(row, 4) == 2 ? 46% : 61%;
                        corner-radius: 16px;
                    }
                }
            }

            for message[message-index] in root.messages : message-row := VerticalLayout {
                property <bool> is-scroll-target: root.scroll-to-message-id == message.id;
                property <bool> is-highlighted: root.highlighted-message-id == message.id;
                changed is-scroll-target => {
                    if is-scroll-target {
                        message-scroll.content-y = -self.y;
                        root.highlighted-message-id = message.id;
                        highlight-timer.restart();
                        root.scroll-to-message-id = "";
                    }
                }
                init => {
                    if is-scroll-target {
                        message-scroll.content-y = -self.y;
                        root.highlighted-message-id = message.id;
                        highlight-timer.restart();
                        root.scroll-to-message-id = "";
                    }
                }
                width: 100%;
                spacing: 4px;

                if message.show-day-label : HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: day-label.preferred-width + 24px;
                        height: 24px;
                        border-width: 1px;
                        border-color: Theme.border;
                        border-radius: 12px;
                        background: Theme.surface;
                        Text {
                            x: 10px;
                            width: parent.width - 20px;
                            height: 100%;
                            text: message.day-label;
                            color: Theme.muted;
                            font-size: 11px;
                            font-weight: 500;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        day-label := Text { text: message.day-label; visible: false; }
                    }
                }

                HorizontalLayout {
                    alignment: message.own ? end : start;

                    if message.own : Rectangle { horizontal-stretch: 1; background: transparent; }

                    Rectangle {
                        width: min(
                            max(
                                max(message-body-measure.preferred-width + 24px, message-author-measure.preferred-width + 24px),
                                max(message-meta-measure.preferred-width + 72px, message.attachments.length > 0 ? 260px : 0px)
                            ),
                            min(parent.width * (root.width >= 640px ? 0.70 : 0.85), 560px)
                        );
                        height: bubble-content.preferred-height + 16px;
                        background: message.own ? Theme.message-bubble : Theme.surface;
                        border-width: message-row.is-highlighted ? 2px : (message.own ? 1px : 0px);
                        border-color: message-row.is-highlighted ? Theme.accent : Theme.accent.with-alpha(0.30);
                        border-radius: 16px;

                        message-body-measure := Text { text: message.body; font-size: 14px; visible: false; }
                        message-author-measure := Text { text: message.author + " " + message.author-tag; font-size: 11px; font-weight: 600; visible: false; }
                        message-meta-measure := Text { text: (message.edited ? "изменено " : "") + message.time-label + " " + message.delivery-label; font-size: 11px; visible: false; }

                        bubble-content := VerticalLayout {
                            x: 12px;
                            y: 8px;
                            width: parent.width - 24px;
                            height: self.preferred-height;
                            spacing: 4px;

                            if root.show-authors && (!message.author.is-empty || !message.author-tag.is-empty) : HorizontalLayout {
                                spacing: 6px;
                                cross-axis-alignment: center;

                                if !message.author.is-empty : Text {
                                    text: message.author;
                                    color: Theme.accent;
                                    font-size: 12px;
                                    font-weight: 500;
                                    wrap: word-wrap;
                                }

                                if !message.author-tag.is-empty : Rectangle {
                                    height: 16px;
                                    border-radius: 8px;
                                    background: Theme.accent.with-alpha(0.15);
                                    border-width: 1px;
                                    border-color: Theme.accent.with-alpha(0.30);

                                    Text {
                                        x: 6px;
                                        width: parent.width - 12px;
                                        height: 100%;
                                        text: message.author-tag;
                                        color: Theme.accent;
                                        font-size: 10px;
                                        font-weight: 500;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            if !message.body.is-empty : Text {
                                text: message.body;
                                color: Theme.foreground;
                                font-size: 14px;
                                wrap: word-wrap;
                                horizontal-stretch: 1;
                            }

                            if message.attachments.length > 0 : FlexboxLayout {
                                spacing: 4px;

                                for attachment[attachment-index] in message.attachments : Rectangle {
                                    width: message.attachments.length == 1 ? parent.width : (parent.width - 4px) / 2;
                                    height: attachment.has-preview ? (message.attachments.length == 1 ? 180px : 110px) : 48px;
                                    background: Theme.background;
                                    border-width: attachment.unavailable ? 1px : 0px;
                                    border-color: Theme.border;
                                    border-radius: 8px;
                                    clip: true;

                                    if attachment.has-preview && !attachment.unavailable : Image {
                                        width: 100%;
                                        height: 100%;
                                        source: attachment.preview-image;
                                        image-fit: cover;
                                        accessible-role: none;
                                    }

                                    if !attachment.has-preview || attachment.unavailable : HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        spacing: 8px;
                                        cross-axis-alignment: center;

                                        IconFileText {
                                            width: 18px;
                                            height: 18px;
                                            stroke: attachment.unavailable ? Theme.muted : Theme.accent;
                                        }

                                        VerticalLayout {
                                            spacing: 1px;
                                            horizontal-stretch: 1;
                                            min-width: 0px;

                                            Text {
                                                text: attachment.unavailable
                                                    ? (attachment.state-label.is-empty
                                                        ? (root.language == "ru" ? "Вложение недоступно" : "Attachment unavailable")
                                                        : attachment.state-label)
                                                    : attachment.label;
                                                color: attachment.unavailable ? Theme.muted : Theme.foreground;
                                                font-size: 12px;
                                                overflow: elide;
                                            }

                                            if !attachment.size-label.is-empty : Text {
                                                text: attachment.size-label;
                                                color: Theme.muted;
                                                font-size: 11px;
                                            }
                                        }
                                    }

                                    TouchArea {
                                        enabled: !attachment.unavailable;
                                        mouse-cursor: pointer;
                                        accessible-role: button;
                                        accessible-label: attachment.label;
                                        clicked => { root.attachment-open-requested(message-index, attachment.id); }
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 5px;
                                alignment: end;

                                if message.edited : Text {
                                    text: root.language == "ru" ? "изменено" : "edited";
                                    color: Theme.muted;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: message.time-label;
                                    color: Theme.muted;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }

                                if message.own && !message.delivery-label.is-empty : Rectangle {
                                    width: 14px;
                                    height: 14px;
                                    background: transparent;
                                    accessible-role: none;

                                    if message.delivery-label == "Отправлено частично" || message.delivery-label == "Partially sent" : IconTriangleAlert {
                                        width: 14px;
                                        height: 14px;
                                        stroke: Theme.danger;
                                    }
                                    if message.delivery-label != "Отправлено частично" && message.delivery-label != "Partially sent" : IconCheck {
                                        width: 14px;
                                        height: 14px;
                                        stroke: Theme.muted;
                                    }
                                }

                                FHIconButton {
                                    button-size: 24px;
                                    label: root.language == "ru" ? "Действия с сообщением" : "Message actions";
                                    clicked => { root.message-menu-requested(message-index); }

                                    IconMoreHorizontal {
                                        width: 16px;
                                        height: 16px;
                                        x: 4px;
                                        y: 4px;
                                        stroke: Theme.muted;
                                    }
                                }
                            }
                        }
                    }

                    if !message.own : Rectangle { horizontal-stretch: 1; background: transparent; }
                }

                if message.reactions.length > 0 : FlexboxLayout {
                    alignment: message.own ? end : start;
                    spacing: 4px;

                    for reaction[reaction-index] in message.reactions : Rectangle {
                        width: max(34px, reaction-label.preferred-width + 14px);
                        height: 24px;
                        background: reaction.mine ? Theme.accent.with-alpha(0.15) : Theme.surface;
                        border-width: 1px;
                        border-color: reaction.mine ? Theme.accent.with-alpha(0.5) : Theme.border;
                        border-radius: 12px;
                        accessible-role: button;
                        accessible-label: reaction.emoji + " " + reaction.count-label;
                        accessible-action-default => { root.reaction-requested(message-index, reaction.emoji); }

                        Text {
                            text: reaction.emoji + " " + reaction.count-label;
                            color: reaction.mine ? Theme.accent : Theme.foreground;
                            font-size: 12px;
                            font-weight: 500;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                            accessible-role: none;
                        }

                        reaction-label := Text {
                            text: reaction.emoji + " " + reaction.count-label;
                            font-size: 12px;
                            font-weight: 500;
                            visible: false;
                        }

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.reaction-requested(message-index, reaction.emoji); }
                        }
                    }
                }
            }

            if !root.polls-error-text.is-empty : HorizontalLayout {
                Text { text: root.polls-error-text; color: Theme.danger; font-size: 11px; wrap: word-wrap; horizontal-stretch: 1; }
                FHSecondaryButton { text: root.language == "ru" ? "Повторить" : "Retry"; height: 28px; clicked => { root.polls-retry-requested(); } }
            }

            if root.polls-loading && root.polls.length == 0 : VerticalLayout {
                spacing: 6px;
                FHSkeleton { height: 20px; width: 40%; }
                FHSkeleton { height: 96px; width: 100%; corner-radius: 12px; }
            }

            for poll[index] in root.polls : PollCard {
                poll: poll;
                option-selection-requested(option-id) => { root.poll-option-selection-requested(poll.id, option-id); }
                vote-requested(poll-id) => { root.poll-vote-requested(poll-id); }
                proposal-changed(text) => { root.poll-proposal-changed(poll.id, text); }
                propose-option-requested(poll-id, text) => { root.poll-propose-option-requested(poll.id, text); }
                remove-option-requested(poll-id, option-id) => { root.poll-option-remove-requested(poll.id, option-id); }
                stop-requested(poll-id) => { root.poll-stop-requested(poll-id); }
                remove-requested(poll-id) => { root.poll-remove-requested(poll-id); }
            }

            if root.polls-has-older : HorizontalLayout {
                alignment: center;

                FHSecondaryButton {
                    text: root.polls-loading-older
                        ? (root.language == "ru" ? "Загрузка" : "Loading")
                        : (root.language == "ru" ? "Более ранние опросы" : "Earlier polls");
                    height: 32px;
                    enabled: !root.polls-loading-older;
                    busy: root.polls-loading-older;
                    clicked => { root.polls-load-older-requested(); }
                }
            }
        }
    }
}
