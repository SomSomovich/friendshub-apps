import { Theme } from "../theme.slint";
import { FHIconButton, FHSecondaryButton, FHTextArea, FHPrimaryButton } from "../components.slint";
import { IconFileText, IconMic, IconVolume2, IconX } from "../icons.slint";
import { ScrollView } from "std-widgets.slint";

export struct PendingAttachmentView {
    id: string,
    name: string,
    size-label: string,
    compress-label: string,
    preview-image: image,
    has-preview: bool,
    can-compress: bool,
    compress: bool,
    active-upload: bool,
    progress-label: string,
    is-voice: bool,
    voice-duration-label: string,
}

export component AttachmentComposer inherits Rectangle {
    in property <bool> open: false;
    in property <bool> busy: false;
    in property <bool> send-enabled: false;
    in property <string> error-text: "";
    in property <[PendingAttachmentView]> attachments;
    in-out property <string> caption: "";

    callback caption-changed(string);
    callback compress-toggle-requested(string, bool);
    callback voice-preview-requested(string);
    callback remove-requested(string);
    callback send-requested();
    callback close-requested();

    if root.open : Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        background: #99000000;
        TouchArea { clicked => { if !root.busy { root.close-requested(); } } }
        Rectangle {
            x: (parent.width - min(parent.width - 32px, 620px)) / 2;
            y: (parent.height - min(parent.height - 32px, 600px)) / 2;
            width: min(parent.width - 32px, 620px);
            height: min(parent.height - 32px, 600px);
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 14px;
            VerticalLayout {
                spacing: 0px;
                Rectangle {
                    height: 52px;
                    background: Theme.surface;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 8px;
                        spacing: 8px;
                        Text { text: "Вложения"; color: Theme.foreground; font-size: 16px; font-weight: 600; horizontal-stretch: 1; vertical-alignment: center; }
                        FHIconButton {
                            button-size: 32px;
                            label: "Закрыть вложения";
                            enabled: !root.busy;
                            clicked => { root.close-requested(); }
                            IconX { width: 16px; height: 16px; x: 8px; y: 8px; stroke: Theme.muted; }
                        }
                    }
                }
                ScrollView {
                    width: 100%;
                    vertical-stretch: 1;
                    vertical-scrollbar-policy: as-needed;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 8px;
                        for attachment[index] in root.attachments : Rectangle {
                            width: 100%;
                            height: attachment-row.preferred-height;
                            background: Theme.background;
                            border-width: 1px;
                            border-color: attachment.active-upload ? Theme.accent : Theme.border;
                            border-radius: 9px;
                            attachment-row := HorizontalLayout {
                                padding: 8px;
                                spacing: 8px;
                                Rectangle {
                                    width: 44px;
                                    height: 44px;
                                    background: Theme.hover;
                                    border-radius: 7px;
                                    clip: true;
                                    if attachment.has-preview : Image { width: 100%; height: 100%; source: attachment.preview-image; image-fit: cover; }
                                    if !attachment.has-preview && attachment.is-voice : IconMic { width: 20px; height: 20px; x: 12px; y: 12px; stroke: Theme.muted; }
                                    if !attachment.has-preview && !attachment.is-voice : IconFileText { width: 20px; height: 20px; x: 12px; y: 12px; stroke: Theme.muted; }
                                }
                                VerticalLayout {
                                    spacing: 3px;
                                    min-width: 0px;
                                    horizontal-stretch: 1;
                                    Text { min-width: 0px; text: attachment.name; color: Theme.foreground; font-size: 12px; overflow: elide; }
                                    Text { min-width: 0px; text: attachment.is-voice ? attachment.voice-duration-label + " · " + attachment.size-label : attachment.size-label; color: Theme.muted; font-size: 10px; overflow: elide; }
                                    if attachment.active-upload && !attachment.progress-label.is-empty : Text { min-width: 0px; text: attachment.progress-label; color: Theme.accent; font-size: 10px; overflow: elide; }
                                }
                                if attachment.can-compress : FHSecondaryButton {
                                    text: attachment.compress-label;
                                    height: 28px;
                                    enabled: !root.busy;
                                    clicked => { root.compress-toggle-requested(attachment.id, !attachment.compress); }
                                }
                                if attachment.is-voice : FHIconButton {
                                    button-size: 32px;
                                    label: "Прослушать голосовое сообщение";
                                    enabled: !root.busy;
                                    clicked => { root.voice-preview-requested(attachment.id); }
                                    IconVolume2 { width: 16px; height: 16px; x: 8px; y: 8px; stroke: Theme.muted; }
                                }
                                FHIconButton {
                                    button-size: 32px;
                                    label: "Удалить вложение";
                                    enabled: !root.busy;
                                    clicked => { root.remove-requested(attachment.id); }
                                    IconX { width: 16px; height: 16px; x: 8px; y: 8px; stroke: Theme.danger; }
                                }
                            }
                        }
                        if !root.error-text.is-empty : Text { text: root.error-text; color: Theme.danger; font-size: 11px; wrap: word-wrap; }
                        FHTextArea {
                            label: "Подпись";
                            placeholder: "Подпись к вложениям";
                            value <=> root.caption;
                            area-height: 72px;
                            enabled: !root.busy;
                            value-edited(value) => { root.caption-changed(value); }
                        }
                    }
                }
                Rectangle {
                    height: 52px;
                    background: Theme.surface;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 8px;
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        FHSecondaryButton { text: "Отмена"; height: 36px; enabled: !root.busy; clicked => { root.close-requested(); } }
                        FHPrimaryButton {
                            text: "Отправить";
                            height: 36px;
                            enabled: root.send-enabled && !root.busy;
                            clicked => { root.send-requested(); }
                        }
                    }
                }
            }
        }
    }
}
