import { Theme } from "../theme.slint";
import { FHEmptyState, FHIconButton, FHSecondaryButton, FHSkeleton } from "../components.slint";
import { IconChevronDown, IconChevronUp, IconMessageSquare, IconSearch, IconX } from "../icons.slint";
import { ScrollView } from "std-widgets.slint";

export struct ChatSearchResult {
    id: string,
    sender: string,
    timestamp: string,
    excerpt: string,
}

export component ChatSearchPanel inherits Rectangle {
    in property <string> language: "ru";
    in-out property <string> query: "";
    in property <[ChatSearchResult]> results;
    in property <bool> searching: false;
    in property <bool> has-older: false;
    in property <bool> loading-older: false;
    in property <int> selected-index: -1;
    in property <string> position-label: "";
    in property <string> empty-text: "";
    in property <string> error-text: "";
    callback query-changed(string);
    callback previous-requested();
    callback next-requested();
    callback result-selected(string);
    callback load-older-requested();
    callback close-requested();

    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 0px;

    VerticalLayout {
        spacing: 0px;
        Rectangle {
            height: 52px;
            background: Theme.surface;

            Rectangle {
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: Theme.border;
            }

            HorizontalLayout {
                padding: 8px;
                spacing: 4px;
                cross-axis-alignment: center;

                Rectangle {
                    height: 36px;
                    horizontal-stretch: 1;
                    background: Theme.background;
                    border-width: 1px;
                    border-color: input.has-focus ? Theme.accent : Theme.border;
                    border-radius: 8px;

                    IconSearch {
                        width: 15px;
                        height: 15px;
                        x: 10px;
                        y: (parent.height - self.height) / 2;
                        stroke: Theme.muted;
                    }

                    if root.query.is-empty && input.preedit-text.is-empty : Text {
                        x: 32px;
                        width: parent.width - 44px;
                        height: 100%;
                        text: root.language == "ru" ? "Поиск по сообщениям" : "Search messages";
                        color: Theme.muted;
                        font-size: 13px;
                        vertical-alignment: center;
                        accessible-role: none;
                    }

                    input := TextInput {
                        x: 32px;
                        width: parent.width - 44px;
                        height: 100%;
                        text <=> root.query;
                        font-size: 13px;
                        color: Theme.foreground;
                        vertical-alignment: center;
                        accessible-label: root.language == "ru" ? "Поиск по сообщениям" : "Search messages";
                        edited => { root.query-changed(self.text); }
                    }
                }

                if !root.query.is-empty && !root.searching && root.results.length > 0 : Text {
                    text: root.position-label;
                    color: Theme.muted;
                    font-size: 11px;
                    vertical-alignment: center;
                }

                FHIconButton {
                    button-size: 32px;
                    label: root.language == "ru" ? "Предыдущий результат" : "Previous result";
                    enabled: !root.query.is-empty && !root.searching && root.results.length > 0;
                    clicked => { root.previous-requested(); }
                    IconChevronUp { width: 16px; height: 16px; x: 8px; y: 8px; stroke: Theme.muted; }
                }
                FHIconButton {
                    button-size: 32px;
                    label: root.language == "ru" ? "Следующий результат" : "Next result";
                    enabled: !root.query.is-empty && !root.searching && root.results.length > 0;
                    clicked => { root.next-requested(); }
                    IconChevronDown { width: 16px; height: 16px; x: 8px; y: 8px; stroke: Theme.muted; }
                }
                FHIconButton {
                    button-size: 32px;
                    label: root.language == "ru" ? "Закрыть поиск" : "Close search";
                    clicked => { root.close-requested(); }
                    IconX { width: 16px; height: 16px; x: 8px; y: 8px; stroke: Theme.muted; }
                }
            }
        }

        VerticalLayout {
            padding: 8px;
            spacing: 4px;
            vertical-stretch: 0;
            if root.query.is-empty : Text {
                text: root.language == "ru" ? "Поиск по загруженным на этом устройстве сообщениям." : "Search covers messages loaded on this device.";
                color: Theme.muted;
                font-size: 11px;
                wrap: word-wrap;
            }
            if root.has-older : FHSecondaryButton {
                text: root.loading-older ? (root.language == "ru" ? "Загрузка" : "Loading") : (root.language == "ru" ? "Загрузить более ранние" : "Load earlier messages");
                height: 30px;
                enabled: !root.loading-older && !root.searching;
                busy: root.loading-older;
                clicked => { root.load-older-requested(); }
            }
            if !root.error-text.is-empty : Text {
                text: root.error-text;
                color: Theme.danger;
                font-size: 12px;
                wrap: word-wrap;
            }
        }

        if root.query.is-empty : Text {
            text: root.language == "ru" ? "Введите текст сообщения для поиска." : "Enter message text to search.";
            color: Theme.muted;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
            vertical-stretch: 1;
        }
        if !root.query.is-empty && root.searching : VerticalLayout {
            vertical-stretch: 1;
            padding: 8px;
            spacing: 6px;

            for row in 4 : VerticalLayout {
                spacing: 5px;
                FHSkeleton { width: 30%; height: 11px; }
                FHSkeleton { width: 82%; height: 13px; }
            }
        }
        if !root.query.is-empty && !root.searching && root.results.length == 0 : FHEmptyState {
            vertical-stretch: 1;
            title: root.language == "ru" ? "Ничего не найдено" : "Nothing found";
            description: root.empty-text.is-empty
                ? (root.language == "ru" ? "В загруженной истории нет совпадений." : "No matches in loaded history.")
                : root.empty-text;

            IconMessageSquare {
                width: 32px;
                height: 32px;
                stroke: Theme.muted;
            }
        }

        if !root.query.is-empty && !root.searching && root.results.length > 0 : ScrollView {
            width: 100%;
            vertical-stretch: 1;
            vertical-scrollbar-policy: as-needed;
            VerticalLayout {
                width: 100%;
                spacing: 0px;
                for result[index] in root.results : Rectangle {
                    width: 100%;
                    height: max(56px, result-content.preferred-height + 16px);
                    background: root.selected-index == index ? Theme.hover : (result-area.has-hover ? Theme.hover : Theme.surface);
                    border-width: 0px;
                    animate background { duration: 100ms; }
                    result-content := VerticalLayout {
                        x: 12px; y: 8px; width: parent.width - 24px; height: parent.height - 16px; spacing: 4px;
                        HorizontalLayout {
                            Text { text: result.sender; color: Theme.muted; font-size: 11px; horizontal-stretch: 1; overflow: elide; }
                            Text { text: result.timestamp; color: Theme.muted; font-size: 10px; }
                        }
                        Text { text: result.excerpt; color: Theme.foreground; font-size: 13px; wrap: word-wrap; overflow: elide; }
                    }
                    result-area := TouchArea {
                        mouse-cursor: pointer;
                        accessible-role: button;
                        accessible-label: result.sender + " · " + result.excerpt;
                        clicked => { root.result-selected(result.id); }
                    }
                }
            }
        }
    }
}
