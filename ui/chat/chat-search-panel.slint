import { Theme } from "../theme.slint";
import { ChatAction } from "chat-controls.slint";
import { ScrollView } from "std-widgets.slint";

export struct ChatSearchResult {
    id: string,
    sender: string,
    timestamp: string,
    excerpt: string,
}

export component ChatSearchPanel inherits Rectangle {
    in property <string> language: "ru";
    in-out property <string> query: "";
    in property <[ChatSearchResult]> results;
    in property <bool> searching: false;
    in property <bool> has-older: false;
    in property <bool> loading-older: false;
    in property <int> selected-index: -1;
    in property <string> position-label: "";
    in property <string> empty-text: "";
    in property <string> error-text: "";
    callback query-changed(string);
    callback previous-requested();
    callback next-requested();
    callback result-selected(string);
    callback load-older-requested();
    callback close-requested();

    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 0px;

    VerticalLayout {
        spacing: 0px;
        Rectangle {
            height: 48px;
            background: Theme.surface;
            HorizontalLayout {
                padding: 6px;
                spacing: 4px;
                Rectangle {
                    height: 36px;
                    horizontal-stretch: 1;
                    background: Theme.background;
                    border-width: 1px;
                    border-color: input.has-focus ? Theme.accent : Theme.border;
                    border-radius: 8px;
                    input := TextInput {
                        x: 10px;
                        width: parent.width - 20px;
                        height: 100%;
                        text <=> root.query;
                        font-size: 13px;
                        color: Theme.foreground;
                        vertical-alignment: center;
                        edited => { root.query-changed(self.text); }
                    }
                }
                if !root.query.is-empty : Text {
                    text: root.position-label;
                    color: Theme.muted;
                    font-size: 11px;
                    vertical-alignment: center;
                }
                ChatAction { label: "↑"; accessible-name: root.language == "ru" ? "Предыдущий результат" : "Previous result"; enabled: root.results.length > 0; clicked => { root.previous-requested(); } }
                ChatAction { label: "↓"; accessible-name: root.language == "ru" ? "Следующий результат" : "Next result"; enabled: root.results.length > 0; clicked => { root.next-requested(); } }
                ChatAction { label: "×"; accessible-name: root.language == "ru" ? "Закрыть поиск" : "Close search"; clicked => { root.close-requested(); } }
            }
        }

        VerticalLayout {
            padding: 8px;
            spacing: 4px;
            vertical-stretch: 0;
            Text {
                text: root.language == "ru" ? "Поиск по загруженным на этом устройстве сообщениям." : "Search covers messages loaded on this device.";
                color: Theme.muted;
                font-size: 11px;
                wrap: word-wrap;
            }
            if root.has-older : ChatAction {
                label: root.loading-older ? (root.language == "ru" ? "Загружаем…" : "Loading…") : (root.language == "ru" ? "Загрузить более ранние сообщения" : "Load earlier messages");
                enabled: !root.loading-older && !root.searching;
                clicked => { root.load-older-requested(); }
            }
            if !root.error-text.is-empty : Text {
                text: root.error-text;
                color: Theme.danger;
                font-size: 12px;
                wrap: word-wrap;
            }
        }

        if root.query.is-empty : Text {
            text: root.language == "ru" ? "Введите текст сообщения для поиска." : "Enter message text to search.";
            color: Theme.muted;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
            vertical-stretch: 1;
        }
        if root.searching : Text {
            text: root.language == "ru" ? "Ищем сообщения…" : "Searching messages…";
            color: Theme.muted;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
            vertical-stretch: 1;
        }
        if !root.query.is-empty && !root.searching && root.results.length == 0 : Text {
            text: root.empty-text.is-empty ? (root.language == "ru" ? "В загруженной истории ничего не найдено." : "No matches in loaded history.") : root.empty-text;
            color: Theme.muted;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
            vertical-stretch: 1;
        }

        if root.results.length > 0 : ScrollView {
            width: 100%;
            vertical-stretch: 1;
            vertical-scrollbar-policy: as-needed;
            VerticalLayout {
                width: 100%;
                spacing: 0px;
                for result[index] in root.results : Rectangle {
                    width: 100%;
                    height: 66px;
                    background: root.selected-index == index ? Theme.hover : Theme.surface;
                    border-width: 0px;
                    VerticalLayout {
                        x: 12px; y: 8px; width: parent.width - 24px; spacing: 4px;
                        HorizontalLayout {
                            Text { text: result.sender; color: Theme.muted; font-size: 11px; horizontal-stretch: 1; overflow: elide; }
                            Text { text: result.timestamp; color: Theme.muted; font-size: 10px; }
                        }
                        Text { text: result.excerpt; color: Theme.foreground; font-size: 13px; wrap: word-wrap; overflow: elide; }
                    }
                    TouchArea {
                        accessible-role: button;
                        accessible-label: result.sender + " · " + result.excerpt;
                        clicked => { root.result-selected(result.id); }
                    }
                }
            }
        }
    }
}
