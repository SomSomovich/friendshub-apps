import { Theme } from "../theme.slint";
import { FHIconButton, FHSecondaryButton, FHPrimaryButton } from "../components.slint";
import { IconCheck, IconX } from "../icons.slint";

export struct PollOptionView {
    id: string,
    text: string,
    count-label: string,
    percent-label: string,
    percentage: int,
    selected: bool,
    correct: bool,
    user-proposed: bool,
    can-remove: bool,
}

export struct PollViewModel {
    id: string,
    title: string,
    description: string,
    type-label: string,
    total-voters-label: string,
    closes-at-label: string,
    vote-label: string,
    your-vote-label: string,
    close-label: string,
    cannot-decrypt-label: string,
    option-unavailable-label: string,
    correct-label: string,
    propose-label: string,
    add-option-label: string,
    stop-label: string,
    delete-label: string,
    delete-description: string,
    closed: bool,
    busy: bool,
    error-text: string,
    owner: bool,
    can-vote: bool,
    can-submit-vote: bool,
    has-voted: bool,
    can-propose: bool,
    proposal-valid: bool,
    allows-multiple: bool,
    show-results: bool,
    options: [PollOptionView],
}

export component PollCard inherits Rectangle {
    in property <PollViewModel> poll;
    in-out property <string> proposal: "";
    out property <bool> confirm-delete-visible: false;

    callback option-selection-requested(string);
    callback vote-requested(string);
    callback proposal-changed(string);
    callback propose-option-requested(string, string);
    callback remove-option-requested(string, string);
    callback stop-requested(string);
    callback remove-requested(string);

    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 12px;

    VerticalLayout {
        padding: 12px;
        spacing: 8px;

        HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                spacing: 4px;
                horizontal-stretch: 1;
                HorizontalLayout {
                    spacing: 6px;
                    Text { text: root.poll.type-label; color: Theme.accent; font-size: 10px; font-weight: 600; }
                    if root.poll.closed : Text { text: root.poll.close-label; color: Theme.muted; font-size: 10px; }
                }
                Text { text: root.poll.title; color: Theme.foreground; font-size: 14px; font-weight: 600; wrap: word-wrap; }
                if !root.poll.description.is-empty : Text { text: root.poll.description; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
            }
            if root.poll.owner : VerticalLayout {
                spacing: 4px;
                if !root.poll.closed : FHSecondaryButton {
                    text: root.poll.stop-label;
                    height: 28px;
                    enabled: !root.poll.busy;
                    clicked => { root.stop-requested(root.poll.id); }
                }
                FHSecondaryButton {
                    text: root.poll.delete-label;
                    height: 28px;
                    danger: true;
                    enabled: !root.poll.busy;
                    clicked => { root.confirm-delete-visible = true; }
                }
            }
        }

        if !root.poll.cannot-decrypt-label.is-empty : Text {
            text: root.poll.cannot-decrypt-label;
            color: Theme.muted;
            font-size: 12px;
            wrap: word-wrap;
        }

        VerticalLayout {
            spacing: 6px;
            for option[index] in root.poll.options : Rectangle {
                width: 100%;
                height: option-row.preferred-height;
                background: Theme.background;
                border-width: 1px;
                border-color: Theme.border;
                border-radius: 8px;
                if root.poll.show-results : Rectangle {
                    x: 0px;
                    y: 0px;
                    width: parent.width * min(max(option.percentage, 0), 100) / 100;
                    height: parent.height;
                    background: Theme.accent.with-alpha(0.10);
                    border-radius: 8px;
                }
                option-row := HorizontalLayout {
                    padding-left: 9px;
                    padding-right: 6px;
                    spacing: 6px;
                    Rectangle {
                        property <bool> enabled: root.poll.can-vote && !root.poll.busy && !option.text.is-empty;
                        horizontal-stretch: 1;
                        height: 32px;
                        background: option.selected ? Theme.hover : transparent;
                        border-width: option.selected ? 1px : 0px;
                        border-color: Theme.accent;
                        border-radius: 8px;
                        accessible-role: button;
                        accessible-label: option.text.is-empty ? root.poll.option-unavailable-label : (option.correct && !root.poll.can-vote ? root.poll.correct-label + ": " + option.text : option.text);
                        accessible-enabled: self.enabled;
                        accessible-action-default => { if self.enabled { root.option-selection-requested(option.id); } }
                        forward-focus: option-focus;
                        if root.poll.can-vote : Rectangle {
                            x: 10px;
                            y: (parent.height - self.height) / 2;
                            width: 16px;
                            height: 16px;
                            border-radius: root.poll.allows-multiple ? 4px : 8px;
                            border-width: 1px;
                            border-color: option.selected ? Theme.accent : Theme.border;
                            background: option.selected ? Theme.accent : transparent;

                            if option.selected && root.poll.allows-multiple : IconCheck {
                                width: 12px;
                                height: 12px;
                                x: 2px;
                                y: 2px;
                                stroke: Theme.accent-foreground;
                                stroke-width: 3px;
                            }
                            if option.selected && !root.poll.allows-multiple : Rectangle {
                                x: 4px;
                                y: 4px;
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: Theme.accent-foreground;
                            }
                        }
                        if !root.poll.can-vote && option.correct : IconCheck {
                            x: 10px;
                            y: (parent.height - self.height) / 2;
                            width: 14px;
                            height: 14px;
                            stroke: Theme.success;
                            stroke-width: 3px;
                        }
                        Text {
                            x: root.poll.can-vote || option.correct ? 34px : 10px;
                            width: parent.width - (root.poll.can-vote || option.correct ? 38px : 14px);
                            height: 100%;
                            text: option.text.is-empty ? root.poll.option-unavailable-label : option.text;
                            color: option.selected ? Theme.accent : Theme.foreground;
                            font-size: 12px;
                            font-weight: 500;
                            horizontal-alignment: left;
                            vertical-alignment: center;
                            overflow: elide;
                            accessible-role: none;
                        }
                        TouchArea {
                            enabled: parent.enabled;
                            mouse-cursor: pointer;
                            clicked => { root.option-selection-requested(option.id); }
                        }
                        option-focus := FocusScope {
                            x: 0;
                            width: 0;
                            enabled: parent.enabled;
                            key-pressed(event) => {
                                if event.text == Key.Space || event.text == Key.Return {
                                    root.option-selection-requested(option.id);
                                    return accept;
                                }
                                return reject;
                            }
                        }
                    }
                    if root.poll.show-results : Text {
                        text: option.percent-label + " · " + option.count-label;
                        color: Theme.muted;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                    if root.poll.owner && option.user-proposed && option.can-remove && !root.poll.closed : FHIconButton {
                        button-size: 26px;
                        label: "Удалить предложенный вариант";
                        enabled: !root.poll.busy;
                        clicked => { root.remove-option-requested(root.poll.id, option.id); }

                        IconX { width: 14px; height: 14px; x: 6px; y: 6px; stroke: Theme.danger; }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            Text { text: root.poll.total-voters-label; color: Theme.muted; font-size: 11px; vertical-alignment: center; horizontal-stretch: 1; }
            if root.poll.can-vote : FHSecondaryButton {
                text: root.poll.vote-label;
                height: 32px;
                enabled: !root.poll.busy && root.poll.can-submit-vote;
                clicked => { root.vote-requested(root.poll.id); }
            }
            if !root.poll.can-vote && root.poll.has-voted : Text {
                text: root.poll.your-vote-label;
                color: Theme.muted;
                font-size: 11px;
                vertical-alignment: center;
            }
        }

        if root.poll.can-propose && !root.poll.closed : HorizontalLayout {
            spacing: 6px;
            Rectangle {
                height: 34px;
                horizontal-stretch: 1;
                background: Theme.background;
                border-width: 1px;
                border-color: input.has-focus ? Theme.accent : Theme.border;
                border-radius: 8px;
                input := TextInput {
                    x: 9px;
                    width: parent.width - 18px;
                    height: parent.height;
                    text <=> root.proposal;
                    font-size: 12px;
                    color: Theme.foreground;
                    edited => { root.proposal-changed(self.text); }
                }
            }
            FHSecondaryButton {
                text: root.poll.add-option-label;
                height: 34px;
                enabled: !root.poll.busy && root.poll.proposal-valid;
                clicked => { root.propose-option-requested(root.poll.id, root.proposal); }
            }
        }

        if !root.poll.error-text.is-empty : Text {
            text: root.poll.error-text;
            color: Theme.danger;
            font-size: 11px;
            wrap: word-wrap;
        }
        if !root.poll.closes-at-label.is-empty : Text { text: root.poll.closes-at-label; color: Theme.muted; font-size: 10px; }
    }

    if root.confirm-delete-visible : Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        background: #99000000;
        TouchArea { clicked => { root.confirm-delete-visible = false; } }
        Rectangle {
            x: (parent.width - min(parent.width - 24px, 380px)) / 2;
            y: (parent.height - dialog.preferred-height) / 2;
            width: min(parent.width - 24px, 380px);
            height: dialog.preferred-height;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 12px;
            dialog := VerticalLayout {
                padding: 16px;
                spacing: 10px;
                Text { text: root.poll.delete-label; color: Theme.foreground; font-size: 15px; font-weight: 600; }
                Text { text: root.poll.delete-description; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    FHSecondaryButton { text: "Отмена"; height: 36px; clicked => { root.confirm-delete-visible = false; } }
                    FHPrimaryButton {
                        danger: true;
                        text: root.poll.delete-label;
                        height: 36px;
                        enabled: !root.poll.busy;
                        clicked => {
                            root.confirm-delete-visible = false;
                            root.remove-requested(root.poll.id);
                        }
                    }
                }
            }
        }
    }
}
